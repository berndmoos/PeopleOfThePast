                <Coords points="979,922 5662,950 5662,920 979,892"/>
                <Baseline points="979,922 5662,950"/>
                <TextEquiv>
                    <Unicode>Montag den 28ten September 1874</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_2" custom="readingOrder {index:1;}">
                <Coords points="587,1439 6445,1425 6445,1395 587,1409"/>
                <Baseline points="587,1439 6445,1425"/>
                <TextEquiv>
                    <Unicode>Hatte die Nacht ziemlich gefroren, denn es war empfindlich kalt.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_3" custom="readingOrder {index:2;}">
                <Coords points="6445,1677 909,1635 909,1665 6445,1707"/>
                <Baseline points="6445,1677 909,1635"/>
                <TextEquiv>
                    <Unicode>Träumte sehr viel wovon ich jedoch nicht viel behalten habe. </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_4" custom="readingOrder {index:3;} textStyle {offset:22; length:4;italic:true;}">
                <Coords points="755,1886 6375,1956 6375,1926 755,1856"/>
                <Baseline points="755,1886 6375,1956"/>
                <TextEquiv>
                    <Unicode>Ein Traum war von der Anna. Sie war bei mir und sagte</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_5" custom="readingOrder {index:4;}">
                <Coords points="6571,2194 811,2166 811,2196 6571,2224"/>
                <Baseline points="6571,2194 811,2166"/>
                <TextEquiv>
                    <Unicode>sie wisse recht gut, daß ich nichts um sie gäbe, daß ich nur</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_6" custom="readingOrder {index:5;}">
                <Coords points="727,2459 6627,2445 6627,2415 727,2429"/>
                <Baseline points="727,2459 6627,2445"/>
                <TextEquiv>
                    <Unicode>thue als hätte ich sie gern u. s. w. vieles habe ich nicht behalten.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_7" custom="readingOrder {index:6;}">
                <Coords points="6641,2739 895,2669 895,2699 6641,2769"/>
                <Baseline points="6641,2739 895,2669"/>
                <TextEquiv>
                    <Unicode>Was ich sagte, auch nicht. Gestern Abend dachte ich noch lange über</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_8" custom="readingOrder {index:7;}">
                <Coords points="825,2920 6501,3018 6502,2988 826,2890"/>
                <Baseline points="825,2920 6501,3018"/>
                <TextEquiv>
                    <Unicode>mein bisheriges Leben nach kam zu dem Schluß, daß</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_9" custom="readingOrder {index:8;}">
                <Coords points="6613,3312 888,3172 887,3202 6612,3342"/>
                <Baseline points="6613,3312 888,3172"/>
                <TextEquiv>
                    <Unicode>die Leute mit denen ich Umgang hatte mich doch wol</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_10" custom="readingOrder {index:9;}">
                <Coords points="888,3382 6606,3535 6607,3505 889,3352"/>
                <Baseline points="872,3532 6606,3535"/>
                <TextEquiv>
                    <Unicode>gern haben müssen. Onkel Seele hatte Thränen in den Augen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_11" custom="readingOrder {index:10;}">
                <Coords points="6564,3787 874,3759 874,3789 6564,3817"/>
                <Baseline points="6564,3787 874,3759"/>
                <TextEquiv>
                    <Unicode>als ich Abschied nahm und er mir sagte, daß gerade an demselben</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_12" custom="readingOrder {index:11;}">
                <Coords points="874,4066 6466,4080 6466,4050 874,4036"/>
                <Baseline points="874,4066 6466,4080"/>
                <TextEquiv>
                    <Unicode>Tage vor der 32 Jahren zu derselben Stunde, er in Deutschland</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_13" custom="readingOrder {index:12;} textStyle {offset:39; length:4;strikethrough:true;}">
                <Coords points="6522,4276 902,4262 902,4292 6522,4306"/>
                <Baseline points="6522,4276 902,4262"/>
                <TextEquiv>
                    <Unicode>von seinem Vater Abschied nahm um nach dens Amerika zu</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_14" custom="readingOrder {index:13;}">
                <Coords points="832,4513 6522,4667 6523,4637 833,4483"/>
                <Baseline points="832,4513 6522,4667"/>
                <TextEquiv>
                    <Unicode>gehen und versprochen hatte in sechs Jahren wieder zurück</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_15" custom="readingOrder {index:14;}">
                <Coords points="6550,4849 664,4849 664,4879 6550,4879"/>
                <Baseline points="6550,4849 664,4849"/>
                <TextEquiv>
                    <Unicode>zu sein. Jetzt sind fast 6 mal 6 Jahre vergangen ohne daß er</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_16" custom="readingOrder {index:15;}">
                <Coords points="832,5072 6564,5142 6564,5112 832,5042"/>
                <Baseline points="832,5072 6564,5142"/>
                <TextEquiv>
                    <Unicode>seinen Vater wieder gesehen hat. Ich glaube Onkel Seele hat</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_17" custom="readingOrder {index:16;} textStyle {offset:30; length:7;italic:true;}">
                <Coords points="6508,5408 846,5338 846,5368 6508,5438"/>
                <Baseline points="6508,5408 846,5338"/>
                <TextEquiv>
                    <Unicode>mich sehr gern. Auch der Frau Brecher standen die Thränen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_18" custom="readingOrder {index:17;}">
                <Coords points="804,5603 6508,5659 6508,5629 804,5573"/>
                <Baseline points="804,5603 6508,5659"/>
                <TextEquiv>
                    <Unicode>in den Augen als sie mir beim Abschied die Hand reichte und</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_19" custom="readingOrder {index:18;}">
                <Coords points="6550,5953 888,5883 888,5913 6550,5983"/>
                <Baseline points="6550,5953 888,5883"/>
                <TextEquiv>
                    <Unicode>lächelnd sagte: ich solle ja recht bald wiederkommen. Ich glaube</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_20" custom="readingOrder {index:19;}">
                <Coords points="846,6120 6452,6232 6453,6202 847,6090"/>
                <Baseline points="846,6120 6452,6232"/>
                <TextEquiv>
                    <Unicode>der guten Frau hat es auch Leid gethan, daß ich ihr Haus verlassen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_21" custom="readingOrder {index:20;}">
                <Coords points="6452,6470 1014,6414 1014,6444 6452,6500"/>
                <Baseline points="6452,6470 1014,6414"/>
                <TextEquiv>
                    <Unicode>mußte und sie hätte es lieber gesehen wenn ich immer</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_22" custom="readingOrder {index:21;}">
                <Coords points="944,6637 6480,6707 6480,6677 944,6607"/>
                <Baseline points="944,6637 6480,6707"/>
                <TextEquiv>
                    <Unicode>dort geblieben wäre. Auch meine Freunde drückten mir</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_23" custom="readingOrder {index:22;}">
                <Coords points="6536,6945 832,6959 832,6989 6536,6975"/>
                <Baseline points="6536,6945 832,6959"/>
                <TextEquiv>
                    <Unicode>alle kräftig die Hand wünschten mir herzlich eine glückliche</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_24" custom="readingOrder {index:23;}">
                <Coords points="874,7140 6508,7280 6509,7250 875,7110"/>
                <Baseline points="874,7140 6508,7280"/>
                <TextEquiv>
                    <Unicode>Reise und ein recht baldiges Wiederkommen. Wenn das</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_25" custom="readingOrder {index:24;}">
                <Coords points="6592,7490 790,7511 720,7748 3041,7846 3042,7816 755,7723 812,7540 6592,7520"/>
                <Baseline points="6592,7490 790,7511"/>
                <TextEquiv>
                    <Unicode>sein wird _ Gott weiß es; wenn es einen giebt</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_37" custom="readingOrder {index:25;}">
                <Coords points="2908,7896 837,7843 836,7873 2907,7926"/>
                <Baseline points="2908,7896 837,7843"/>
                <TextEquiv>
                    <Unicode>Hierauf schlief ich ein.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_26" custom="readingOrder {index:26;} textStyle {offset:5; length:5;italic:true;}">
                <Coords points="832,8028 6592,8112 6592,8082 832,7998"/>
                <Baseline points="832,8028 6592,8112"/>
                <TextEquiv>
                    <Unicode>Mein Dixie war noch in der Nähe und sah recht dünnleibig</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_27" custom="readingOrder {index:27;}">
                <Coords points="6550,8349 916,8307 916,8337 6550,8379"/>
                <Baseline points="6550,8349 916,8307"/>
                <TextEquiv>
                    <Unicode>aus als ich zu Tagesanbruch aufstand. Ich kann aber weder</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_28" custom="readingOrder {index:28;}">
                <Coords points="874,8559 6494,8601 6494,8571 874,8529"/>
                <Baseline points="874,8559 6494,8601"/>
                <TextEquiv>
                    <Unicode>für Geld, noch gute Worte, für mich oder mein Pferd</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_29" custom="readingOrder {index:29;} textStyle {offset:38; length:5;italic:true;}">
                <Coords points="6578,8894 881,8866 881,8896 6578,8924"/>
                <Baseline points="6578,8894 881,8866"/>
                <TextEquiv>
                    <Unicode>etwas zu essen bekommen. Sattelte den Dixie und ver-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_30" custom="readingOrder {index:30;} textStyle {offset:11; length:10;italic:true;}">
                <Coords points="867,9104 6459,9173 6459,9143 867,9074"/>
                <Baseline points="867,9104 6459,9173"/>
                <TextEquiv>
                    <Unicode>suchte den San Marcos zu durchschwimmen, mußte aber</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_31" custom="readingOrder {index:31;}">
                <Coords points="6473,9425 1105,9383 1105,9413 6473,9455"/>
                <Baseline points="6473,9425 1105,9383"/>
                <TextEquiv>
                    <Unicode>Mitte umkehren, da der Strom zu reißend</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_32" custom="readingOrder {index:32;}">
                <Coords points="909,9663 6166,9746 6166,9716 909,9633"/>
                <Baseline points="909,9663 6166,9746"/>
                <TextEquiv>
                    <Unicode>und das Ufer, an beiden Seite zu hoch war.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_33" custom="readingOrder {index:33;} textStyle {offset:35; length:4;italic:true;}">
                <Coords points="6431,9970 755,9907 755,9937 6431,10000"/>
                <Baseline points="6431,9970 755,9907"/>
                <TextEquiv>
                    <Unicode>Ritt wieder auf meinen alten alten campplatz</Unicode>
