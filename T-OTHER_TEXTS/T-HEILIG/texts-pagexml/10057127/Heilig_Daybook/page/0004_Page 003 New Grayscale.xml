            <TextLine id="l_35" custom="readingOrder {index:35;} textStyle {offset:22; length:8;italic:true;}">
                <Coords points="6389,10508 671,10438 671,10468 6389,10538"/>
                <Baseline points="6389,10508 671,10438"/>
