                <Baseline points="2063,1172 280,1138"/>
                <TextEquiv>
                    <Unicode>F. Seydler kam vorbei u. frug mich ob ich hinaufginge. Sagte ihm ich könne nicht</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_24" custom="readingOrder {index:6;}">
                <Coords points="287,1235 2039,1257 2039,1227 287,1205"/>
                <Baseline points="287,1235 2039,1257"/>
                <TextEquiv>
                    <Unicode>da die Zeit zu kurz ist. Er bat mich zur Stadt zu reiten und meinen Einfluß</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_23" custom="readingOrder {index:7;}">
                <Coords points="2032,1327 270,1332 270,1362 2032,1357"/>
                <Baseline points="2032,1327 270,1332"/>
                <TextEquiv>
                    <Unicode>aufzubieten, damit noch Delegaten gewählt werden. Sagte ihm ich würde hinein-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_22" custom="readingOrder {index:8;}">
