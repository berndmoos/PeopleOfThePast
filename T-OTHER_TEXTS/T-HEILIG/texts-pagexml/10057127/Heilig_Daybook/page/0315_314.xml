                    <Unicode>Rüffel zu schicken. _ In der Stadt waren sie eben daran eine Extraversammlung</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_19" custom="readingOrder {index:11;}">
                <Coords points="2015,1700 270,1698 270,1728 2015,1730"/>
                <Baseline points="2015,1700 270,1698"/>
