            <TextLine id="l_18" custom="readingOrder {index:12;} textStyle {offset:54; length:10;italic:true;}">
                <Coords points="299,1799 2080,1790 2080,1760 299,1769"/>
                <Baseline points="299,1799 2080,1790"/>
                <TextEquiv>
                    <Unicode>lung. Es kam kein Quorum zusammen; 3 Turner sind nach Huntsville abgegangen</Unicode>
                </TextEquiv>
