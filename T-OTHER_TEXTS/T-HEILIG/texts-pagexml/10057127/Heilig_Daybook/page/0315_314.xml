                <Baseline points="297,1422 2029,1424"/>
                <TextEquiv>
                    <Unicode>reiten aber ich werde mir nicht viel Mühe geben Delegaten zu schicken. Bei der nächsten</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_21" custom="readingOrder {index:9;}">
                <Coords points="2039,1521 309,1501 309,1531 2039,1551"/>
                <Baseline points="2039,1521 309,1501"/>
                <TextEquiv>
                    <Unicode>Versammlung aber werde ich meinen Einfluß geltend machen um dem Vorort einen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_20" custom="readingOrder {index:10;}">
                <Coords points="282,1603 2039,1606 2039,1576 282,1573"/>
                <Baseline points="282,1603 2039,1606"/>
