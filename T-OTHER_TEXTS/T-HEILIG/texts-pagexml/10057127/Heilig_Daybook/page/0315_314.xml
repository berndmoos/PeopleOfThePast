            <TextLine id="l_16" custom="readingOrder {index:14;} textStyle {offset:55; length:6;italic:true;}">
                <Coords points="292,1969 2065,1957 2065,1927 292,1939"/>
                <Baseline points="292,1969 2065,1957"/>
