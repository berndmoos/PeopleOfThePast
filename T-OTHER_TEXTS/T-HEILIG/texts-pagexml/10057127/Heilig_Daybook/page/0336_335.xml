        <TextRegion id="r_1" custom="readingOrder {index:1;} structure {type:day_start;}">
            <Coords points="45,169 2156,169 2156,3514 45,3514"/>
            <TextLine id="l_1" custom="readingOrder {index:0;} textStyle {offset:0; length:13;italic:true; underlined:true;} textStyle {offset:13; length:3;underlined:true;} textStyle {offset:16; length:2;italic:true; underlined:true; superscript:true;} textStyle {offset:18; length:5;underlined:true;}">
                <Coords points="594,289 1718,298 1718,268 594,259"/>
                <Baseline points="594,289 1718,298"/>
                <TextEquiv>
                    <Unicode>Domingo Julio 23no 1876.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_2" custom="readingOrder {index:1;}">
                <Coords points="264,435 2104,414 2104,384 264,405"/>
                <Baseline points="264,435 2104,414"/>
                <TextEquiv>
                    <Unicode>Hatte letzte Nacht einen merkwürdigen Traum.! „Ich schlief</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_3" custom="readingOrder {index:2;} textStyle {offset:28; length:16;italic:true;}">
                <Coords points="2100,491 204,512 204,542 2100,521"/>
                <Baseline points="2100,491 204,512"/>
                <TextEquiv>
                    <Unicode>draußen an einem Hause, als Prof. Theo Benne (der schon tod ist)</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_4" custom="readingOrder {index:3;}">
                <Coords points="221,624 2044,598 2044,568 221,594"/>
                <Baseline points="221,624 2044,598"/>
                <TextEquiv>
                    <Unicode>zu mir kam und mich weckte, worauf er mich bat mit ihm</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_5" custom="readingOrder {index:4;}">
                <Coords points="2070,688 204,688 204,718 2070,718"/>
                <Baseline points="2070,688 204,688"/>
                <TextEquiv>
                    <Unicode>zu gehen, als Berichterstatter. Ich frug ihn was los sei! Aber diese</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_6" custom="readingOrder {index:5;}">
                <Coords points="234,778 2091,757 2091,727 234,748"/>
                <Baseline points="234,778 2091,757"/>
                <TextEquiv>
                    <Unicode>Augenblick kamen 6 Soldaten und ein Lieutenant, mit einem</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_7" custom="readingOrder {index:6;}">
                <Coords points="2023,868 234,873 234,903 2023,898"/>
                <Baseline points="2023,868 234,873"/>
                <TextEquiv>
                    <Unicode>feingekleideten Herrn, der aber seinen Rock auf dem Arme trug.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_8" custom="readingOrder {index:7;}">
                <Coords points="234,958 2143,945 2143,915 234,928"/>
                <Baseline points="234,958 2143,945"/>
                <TextEquiv>
                    <Unicode>Sagte, ich wolle mir nur meine Schuhe und einen Rock anziehen,</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_9" custom="readingOrder {index:8;}">
                <Coords points="2079,1005 260,1044 261,1074 2080,1035"/>
                <Baseline points="2079,1005 260,1044"/>
                <TextEquiv>
                    <Unicode>und dann gleich nachkommen. Als ich auf dem Wege war, hörte</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_10" custom="readingOrder {index:9;} textStyle {offset:27; length:5;italic:true;}">
                <Coords points="260,1151 2061,1117 2060,1087 259,1121"/>
                <Baseline points="260,1151 2061,1117"/>
                <TextEquiv>
                    <Unicode>ich schießen, und etwa 500 Yards von da wo ich geschlafen hatte,</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_11" custom="readingOrder {index:10;}">
                <Coords points="2074,1211 260,1224 260,1254 2074,1241"/>
                <Baseline points="2074,1211 260,1224"/>
                <TextEquiv>
                    <Unicode>lag der Herr, der seinen Rock jetzt anhatte, erschossen. Der Offizier</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_12" custom="readingOrder {index:11;}">
                <Coords points="264,1323 2027,1293 2026,1263 263,1293"/>
                <Baseline points="264,1323 2027,1293"/>
                <TextEquiv>
                    <Unicode>befehl sodann, ihn in sein "Mausoleum" zu tragen. _ Dies</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_13" custom="readingOrder {index:12;}">
                <Coords points="2087,1400 277,1404 277,1434 2087,1430"/>
                <Baseline points="2087,1400 277,1404"/>
                <TextEquiv>
                    <Unicode>war ein ziemlich großes Gebäude, nicht weit ab, in dem sehr</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_14" custom="readingOrder {index:13;}">
                <Coords points="260,1490 2061,1460 2061,1430 260,1460"/>
                <Baseline points="260,1490 2061,1460"/>
                <TextEquiv>
                    <Unicode>viele kleine Zimmer waren. Es waren lange Gänge, in die </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_15" custom="readingOrder {index:14;}">
                <Coords points="2019,1550 277,1589 278,1619 2020,1580"/>
                <Baseline points="2019,1550 277,1589"/>
                <TextEquiv>
                    <Unicode>die Thüren der Kam̄ern mündeten, und Alles aus Spiegeln gebaut. Als</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_16" custom="readingOrder {index:15;}">
                <Coords points="260,1670 2027,1644 2027,1614 260,1640"/>
                <Baseline points="260,1670 2027,1644"/>
                <TextEquiv>
                    <Unicode>der Herr in ein solches leeres Kämmerchen gebracht worden war, _ viele</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_17" custom="readingOrder {index:16;}">
                <Coords points="2053,1752 251,1773 251,1803 2053,1782"/>
                <Baseline points="2053,1752 251,1773"/>
                <TextEquiv>
                    <Unicode>derselben waren schon mit je einem Gerippe, ausgefüllt, war</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_18" custom="readingOrder {index:17;}">
                <Coords points="264,1846 1963,1846 1963,1816 264,1816"/>
                <Baseline points="264,1846 1963,1846"/>
                <TextEquiv>
                    <Unicode>er noch lebendig und der Offizier sagte Herrn Benne, er möge</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_19" custom="readingOrder {index:18;}">
                <Coords points="2027,1932 260,1910 260,1940 2027,1962"/>
                <Baseline points="2027,1932 260,1910"/>
                <TextEquiv>
                    <Unicode>denselben untersuchen und sehen ob die Wunde tödtlich sei. Dieser</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_20" custom="readingOrder {index:19;}">
                <Coords points="247,2013 2066,2017 2066,1987 247,1983"/>
                <Baseline points="247,2013 2066,2017"/>
                <TextEquiv>
                    <Unicode>that das und sagte: "Ja, er wird daran sterben." Ich frug darauf,</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_21" custom="readingOrder {index:20;}">
                <Coords points="2074,2112 247,2133 247,2163 2074,2142"/>
                <Baseline points="2074,2112 247,2133"/>
                <TextEquiv>
                    <Unicode>wo er denn eigentlich geschossen sei und trat näher; Da sah ich eine</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_22" custom="readingOrder {index:21;}">
                <Coords points="251,2202 2014,2197 2014,2167 251,2172"/>
                <Baseline points="251,2202 2014,2197"/>
                <TextEquiv>
                    <Unicode>Schußwunde oben in der rechten Brust, die ihm das Schlüsselbein</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_23" custom="readingOrder {index:22;} textStyle {offset:51; length:9;italic:true;}">
                <Coords points="2031,2275 255,2300 255,2330 2031,2305"/>
                <Baseline points="2031,2275 255,2300"/>
                <TextEquiv>
                    <Unicode>zerschmettert hätte. Hieran würde er sterben sagte Dr. Benne.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_24" custom="readingOrder {index:23;}">
                <Coords points="260,2356 2057,2382 2057,2352 260,2326"/>
                <Baseline points="260,2356 2057,2382"/>
                <TextEquiv>
                    <Unicode>Ich sagte zu mir selber: es sei eine Schande den Menschen so zu</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_25" custom="readingOrder {index:24;}">
                <Coords points="2061,2476 268,2489 268,2519 2061,2506"/>
                <Baseline points="2061,2476 268,2489"/>
                <TextEquiv>
                    <Unicode>quälen, er habe sicher nichts verbrochen; da drehte sich der Herr,</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_26" custom="readingOrder {index:25;}">
                <Coords points="242,2579 2023,2545 2022,2515 241,2549"/>
                <Baseline points="242,2579 2023,2545"/>
                <TextEquiv>
                    <Unicode>er lag auf einer hölzernen Gartenbank, um und sah mir groß</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_27" custom="readingOrder {index:26;}">
                <Coords points="2027,2618 260,2648 261,2678 2028,2648"/>
                <Baseline points="2027,2618 260,2648"/>
                <TextEquiv>
                    <Unicode>und voll in’s Gesicht. Ich sah sein Gesicht so deutlich und dasselbe</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_28" custom="readingOrder {index:27;}">
                <Coords points="251,2751 2066,2725 2066,2695 251,2721"/>
                <Baseline points="251,2751 2066,2725"/>
                <TextEquiv>
                    <Unicode>prägte sich meinem Gedächtnisse so ein, daß ich es zu jeder Zeit malen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_29" custom="readingOrder {index:28;}">
                <Coords points="2091,2802 247,2815 247,2845 2091,2832"/>
                <Baseline points="2091,2802 247,2815"/>
                <TextEquiv>
                    <Unicode>könnte. Er hatte eine hohe Stirn, schwarzes Haar und blau-graue Augen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_30" custom="readingOrder {index:29;}">
                <Coords points="247,2918 2096,2901 2096,2871 247,2888"/>
                <Baseline points="247,2918 2096,2901"/>
                <TextEquiv>
                    <Unicode>und war von ziemlich kräftiger Natur. Am meisten Ähnlichkeit hatte</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_31" custom="readingOrder {index:30;} textStyle {offset:13; length:10;italic:true;} textStyle {offset:29; length:15;italic:true;}">
                <Coords points="2087,2982 238,2995 238,3025 2087,3012"/>
                <Baseline points="2087,2982 238,2995"/>
                <TextEquiv>
                    <Unicode>er mit Herrn J. Deutsch oder Bogumil Davison. Auch der Offizier</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_32" custom="readingOrder {index:31;}">
                <Coords points="264,3115 2019,3089 2019,3059 264,3085"/>
                <Baseline points="264,3115 2019,3089"/>
                <TextEquiv>
                    <Unicode>erinnern ich mich sehr gut. Derselbe war klein, ebenfalls bartlos; er wusch</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_33" custom="readingOrder {index:32;} textStyle {offset:60; length:5;italic:true;}">
                <Coords points="2040,3179 264,3175 264,3205 2040,3209"/>
                <Baseline points="2040,3179 264,3175"/>
                <TextEquiv>
                    <Unicode>den Herrn und dachte ihn hin und her wie ein Stück Fleisch. Benne u. ich</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_34" custom="readingOrder {index:33;}">
                <Coords points="260,3257 1195,3261 1195,3231 260,3227"/>
                <Baseline points="260,3257 1195,3261"/>
                <TextEquiv>
                    <Unicode>gingen hierauf wieder fort. _</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_35" custom="readingOrder {index:34;} textStyle {offset:40; length:7;italic:true;}">
                <Coords points="2083,3334 225,3368 226,3398 2084,3364"/>
                <Baseline points="2083,3334 225,3368"/>
                <TextEquiv>
                    <Unicode>Wurde heute Nachm. zur Sturmpartie beim Schäfer eingeladen. Ging</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_36" custom="readingOrder {index:35;} textStyle {offset:38; length:5;italic:true;}">
                <Coords points="247,3454 1817,3415 1816,3385 246,3424"/>
                <Baseline points="247,3454 1817,3415"/>
                <TextEquiv>
                    <Unicode>hin, spielte und tanzte bis 12 Uhr. _ Therm. 103 Grd. F.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextEquiv>
                <Unicode></Unicode>
            </TextEquiv>
