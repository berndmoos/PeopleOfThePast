            <TextLine id="l_1" custom="readingOrder {index:0;} textStyle {offset:0; length:8;italic:true;} textStyle {offset:9; length:3;italic:true;} textStyle {offset:15; length:4;superscript:true;} textStyle {offset:20; length:9;italic:true;}">
                <Coords points="775,920 5841,1000 5841,970 775,890"/>
                <Baseline points="775,920 5841,1000"/>
                <TextEquiv>
                    <Unicode>Mittwoch den 30sten September 1874</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_2" custom="readingOrder {index:1;}">
                <Coords points="933,1330 5959,1405 5959,1375 933,1300"/>
                <Baseline points="933,1330 5959,1405"/>
                <TextEquiv>
                    <Unicode>Die Sonne stand hoch am Himmel als wir durch ein starkes</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_3" custom="readingOrder {index:2;}">
                <Coords points="928,1576 5943,1643 5943,1613 928,1546"/>
                <Baseline points="928,1576 5943,1643"/>
                <TextEquiv>
                    <Unicode>Klopfen an der hinteren Thüre, aufgeweckt wurden. </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_4" custom="readingOrder {index:3;}">
                <Coords points="933,1806 5909,1881 5909,1851 933,1776"/>
                <Baseline points="933,1806 5909,1881"/>
                <TextEquiv>
                    <Unicode>Der Klopfer war ein Kunde welcher schon 6 Meilen ge-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_5" custom="readingOrder {index:4;}">
                <Coords points="928,2051 5880,2126 5880,2096 928,2021"/>
                <Baseline points="928,2051 5880,2126"/>
                <TextEquiv>
                    <Unicode>kommen war um etwas einzukaufen. Er wurde</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_6" custom="readingOrder {index:5;}">
                <Coords points="891,2285 5947,2347 5947,2317 891,2255"/>
                <Baseline points="891,2285 5947,2347"/>
                <TextEquiv>
                    <Unicode>befriedigt und bald darauf gingen wir zum Frühstück</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_7" custom="readingOrder {index:6;}">
                <Coords points="916,2535 5797,2589 5797,2559 916,2505"/>
                <Baseline points="916,2535 5797,2589"/>
                <TextEquiv>
                    <Unicode>welches schon lange auf uns wartete. Während des</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_8" custom="readingOrder {index:7;}">
                <Coords points="908,2781 5934,2843 5934,2813 908,2751"/>
                <Baseline points="908,2781 5934,2843"/>
                <TextEquiv>
                    <Unicode>Tages wurden noch verschiedene Flaschen Bier vertilgt. </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_9" custom="readingOrder {index:8;}">
                <Coords points="891,2985 5851,3056 5851,3026 891,2955"/>
                <Baseline points="891,2985 5851,3056"/>
                <TextEquiv>
                    <Unicode>ich machte den zerrissenen Bogen ganz wobei ich mir</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_10" custom="readingOrder {index:9;}">
                <Coords points="891,3252 5859,3314 5859,3284 891,3222"/>
                <Baseline points="891,3252 5859,3314"/>
                <TextEquiv>
                    <Unicode>gehörig in den Daumen schnitt. Nachmittags ritt ich mit</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_11" custom="readingOrder {index:10;} textStyle {offset:0; length:5;italic:true;} textStyle {offset:11; length:6;italic:true;}">
                <Coords points="908,3481 5780,3552 5780,3522 908,3451"/>
                <Baseline points="908,3481 5780,3552"/>
                <TextEquiv>
                    <Unicode>Adolf nach Wälder wo ich meine Fähigkeit und Fertig-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_12" custom="readingOrder {index:11;} textStyle {offset:8; length:11;italic:true;}">
                <Coords points="908,3739 5834,3806 5834,3776 908,3709"/>
                <Baseline points="908,3739 5834,3806"/>
                <TextEquiv>
                    <Unicode>keit im Cottonbales zeichnen einmal wieder in An-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_13" custom="readingOrder {index:12;} textStyle {offset:17; length:6;italic:true;}">
                <Coords points="887,3968 5893,4031 5893,4001 887,3938"/>
                <Baseline points="887,3968 5893,4031"/>
                <TextEquiv>
                    <Unicode>wendung brachte. Wälder ist eine kleine Eisenbahnstation</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_14" custom="readingOrder {index:13;} textStyle {offset:7; length:9;italic:true;} textStyle {offset:18; length:10;italic:true;} textStyle {offset:33; length:21;italic:true;}">
                <Coords points="887,4214 5726,4268 5726,4238 887,4184"/>
                <Baseline points="887,4214 5726,4268"/>
                <TextEquiv>
                    <Unicode>an der Galveston, Harrisburg und San Antonio Rail Road. </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_15" custom="readingOrder {index:14;} textStyle {offset:28; length:6;italic:true;}">
                <Coords points="887,4448 5788,4506 5788,4476 887,4418"/>
                <Baseline points="887,4448 5788,4506"/>
                <TextEquiv>
                    <Unicode>gelegen. Es sind nur einige Stores und Wohnhäuser da, doch </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_16" custom="readingOrder {index:15;} textStyle {offset:40; length:5;italic:true;}">
                <Coords points="884,4679 5785,4757 5785,4727 884,4649"/>
                <Baseline points="884,4679 5785,4757"/>
                <TextEquiv>
                    <Unicode>wird tüchtig gebaut. Als wir zurück zum Store kamen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_17" custom="readingOrder {index:16;} textStyle {offset:8; length:5;italic:true;}">
                <Coords points="879,4899 5941,4977 5941,4947 879,4869"/>
                <Baseline points="879,4899 5941,4977"/>
                <TextEquiv>
                    <Unicode>stellte Edgar uns einen neuangekommenen Herrn namens</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_18" custom="readingOrder {index:17;} textStyle {offset:0; length:7;italic:true;}">
                <Coords points="884,5151 5799,5215 5799,5185 884,5121"/>
                <Baseline points="884,5151 5799,5215"/>
                <TextEquiv>
                    <Unicode>Bertsch vor. Er machte gleich beim ersten Anblick einen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_19" custom="readingOrder {index:18;}">
                <Coords points="865,5407 5964,5472 5964,5442 865,5377"/>
                <Baseline points="865,5407 5964,5472"/>
                <TextEquiv>
                    <Unicode>schlechten Eindruck auf mich. Er ist ein kleiner hagerer Mann</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_20" custom="readingOrder {index:19;}">
                <Coords points="861,5646 5890,5715 5890,5685 861,5616"/>
                <Baseline points="861,5646 5890,5715"/>
                <TextEquiv>
                    <Unicode>mit einem sehr frechen Gesicht. Ich verlasse mich immer ganz</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_21" custom="readingOrder {index:20;}">
                <Coords points="879,5880 5803,5962 5803,5932 879,5850"/>
                <Baseline points="879,5880 5803,5962"/>
                <TextEquiv>
                    <Unicode>auf den ersten Eindruck den ein fremder Mensch auf mich macht, </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_22" custom="readingOrder {index:21;}">
                <Coords points="838,6095 5780,6187 5781,6157 839,6065"/>
                <Baseline points="838,6095 5780,6187"/>
                <TextEquiv>
                    <Unicode>denn das Gefühl welches ich dann empfinde hat mich noch nie</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_23" custom="readingOrder {index:22;}">
                <Coords points="847,6329 5826,6411 5826,6381 847,6299"/>
                <Baseline points="847,6329 5826,6411"/>
                <TextEquiv>
                    <Unicode>getäuscht. Ebenso hier. Ich sprach nicht mit ihm und hätte ihm doch </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_24" custom="readingOrder {index:23;}">
                <Coords points="861,6576 5923,6654 5923,6624 861,6546"/>
                <Baseline points="861,6576 5923,6654"/>
                <TextEquiv>
                    <Unicode>bald das Genick umgedreht. Während ich in der Stube auf dem</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_25" custom="readingOrder {index:24;} textStyle {offset:53; length:5;italic:true;}">
                <Coords points="847,6819 5877,6888 5877,6858 847,6789"/>
                <Baseline points="847,6819 5877,6888"/>
                <TextEquiv>
                    <Unicode>Bett saß unterhielt er sich draußen vor der Thür mit Adolf über</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_26" custom="readingOrder {index:25;}">
                <Coords points="852,7049 5771,7140 5772,7110 853,7019"/>
                <Baseline points="852,7049 5771,7140"/>
                <TextEquiv>
                    <Unicode>Deutschland und dann über Amerika wobei er fürchterlich auf</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_27" custom="readingOrder {index:26;}">
                <Coords points="842,7296 5822,7374 5822,7344 842,7266"/>
                <Baseline points="842,7296 5822,7374"/>
                <TextEquiv>
                    <Unicode>alle Amerikaner schimpfte. Ich sagte ihm, daß ich, obgleich in Deutsch-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_28" custom="readingOrder {index:27;}">
                <Coords points="820,7530 5794,7617 5795,7587 821,7500"/>
                <Baseline points="820,7530 5794,7617"/>
                <TextEquiv>
                    <Unicode>land geboren, doch auch ein Amerikaner sei und verbat mir</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_29" custom="readingOrder {index:28;} textStyle {offset:20; length:4;underlined:true;}">
                <Coords points="842,7796 5913,7864 5913,7834 842,7766"/>
                <Baseline points="842,7796 5913,7864"/>
                <TextEquiv>
                    <Unicode>diese Schimpfen auf alle Amerikaner. Als er mir noch darauf </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_30" custom="readingOrder {index:29;}">
                <Coords points="823,8009 5857,8092 5857,8062 823,7979"/>
                <Baseline points="823,8009 5857,8092"/>
                <TextEquiv>
                    <Unicode>erwiederte, sagte ich ihm: Alles was er sage sei dummes Geschwätz</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_31" custom="readingOrder {index:30;}">
                <Coords points="800,8266 5816,8344 5816,8314 800,8236"/>
                <Baseline points="800,8266 5816,8344"/>
                <TextEquiv>
                    <Unicode>und ich verbäte mir dergleichen, da ich selbst Amerikaner sei.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_32" custom="readingOrder {index:31;}">
                <Coords points="818,8495 5853,8587 5854,8557 819,8465"/>
                <Baseline points="818,8495 5853,8587"/>
                <TextEquiv>
                    <Unicode>Wäre es in meinem Hause gewesen, ich hätte ihn hinaus geworfen. </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_33" custom="readingOrder {index:32;}">
                <Coords points="832,8715 5839,8793 5839,8763 832,8685"/>
                <Baseline points="832,8715 5839,8793"/>
                <TextEquiv>
                    <Unicode>Denn ich kann mir nichts schlechteres denken als hinter Jemandes</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_34" custom="readingOrder {index:33;}">
                <Coords points="828,8944 5899,9027 5899,8997 828,8914"/>
                <Baseline points="828,8944 5899,9027"/>
                <TextEquiv>
                    <Unicode>Rücken auf ihn zu Schimpfen und ihn anzuklagen wo derselbe nicht </Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_35" custom="readingOrder {index:34;} textStyle {offset:36; length:7;italic:true;}">
                <Coords points="823,9197 5729,9270 5729,9240 823,9167"/>
                <Baseline points="823,9197 5729,9270"/>
                <TextEquiv>
                    <Unicode>da ist um sich zu vertheidigen. Als Bertsch zur Nacht eingeschlafen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_36" custom="readingOrder {index:35;} textStyle {offset:13; length:5;italic:true;} textStyle {offset:19; length:7;italic:true;} textStyle {offset:35; length:6;italic:true;}">
                <Coords points="809,9453 5885,9527 5885,9497 809,9423"/>
                <Baseline points="809,9453 5885,9527"/>
                <TextEquiv>
                    <Unicode>war spielten Edgar , Adolf und ich Piquet (wobei ich immer verlor)</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_37" custom="readingOrder {index:36;}">
                <Coords points="795,9664 5114,9751 5115,9721 796,9634"/>
                <Baseline points="795,9664 5114,9751"/>
                <TextEquiv>
                    <Unicode>und tranken Breiner Bier. Legten uns um 1 Uhr nieder.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextEquiv>
                <Unicode></Unicode>
            </TextEquiv>
