        <TextRegion id="r_1" custom="readingOrder {index:1;} structure {type:day_start;}">
            <Coords points="225,139 2153,139 2153,1192 225,1192"/>
            <TextLine id="l_1" custom="readingOrder {index:0;} textStyle {offset:0; length:15;italic:true;} textStyle {offset:18; length:2;italic:true; superscript:true;}">
                <Coords points="439,323 1777,340 1777,310 439,293"/>
                <Baseline points="439,323 1777,340"/>
                <TextEquiv>
                    <Unicode>Domingo Febrero 27mo 1876.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_2" custom="readingOrder {index:1;} textStyle {offset:47; length:7;italic:true;}">
                <Coords points="332,435 2109,469 2110,439 333,405"/>
                <Baseline points="332,435 2109,469"/>
                <TextEquiv>
                    <Unicode>Schrieb, sang und spielte. Ging hierauf in den Pasture mit meinem</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_3" custom="readingOrder {index:2;} textStyle {offset:0; length:5;italic:true;}">
                <Coords points="2002,542 315,514 315,544 2002,572"/>
                <Baseline points="2002,542 315,514"/>
                <TextEquiv>
                    <Unicode>Rifle und schoß nach der Scheibe. Schoß sehr gut. Auf 110 Schritt 4 Kugeln</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_4" custom="readingOrder {index:3;}">
                <Coords points="315,609 2126,638 2126,608 315,579"/>
                <Baseline points="315,609 2126,638"/>
                <TextEquiv>
                    <Unicode>innerhalb 2-3 Zoll, eine nach der Andern. Nachmittags, spielte und sang wieder</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_5" custom="readingOrder {index:4;} textStyle {offset:11; length:10;italic:true;} textStyle {offset:35; length:10;italic:true;}">
                <Coords points="2109,716 304,683 303,713 2108,746"/>
                <Baseline points="2109,716 304,683"/>
                <TextEquiv>
                    <Unicode>bis wir zu Sladzcyk's gingen. Herr Nordhausen mit Frau war auch da. Unter-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_6" custom="readingOrder {index:5;} textStyle {offset:45; length:7;italic:true;}">
                <Coords points="315,795 2081,812 2081,782 315,765"/>
                <Baseline points="315,795 2081,812"/>
                <TextEquiv>
                    <Unicode>hielten uns sehr gut und machten noch besser Toddies. Gegen Abend gingen wir</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_7" custom="readingOrder {index:6;} textStyle {offset:61; length:3;italic:true;}">
                <Coords points="2064,868 337,874 337,904 2064,898"/>
                <Baseline points="2064,868 337,874"/>
                <TextEquiv>
                    <Unicode>nach Hause. Abends spielten wir Whist in meinem Zimmer. Herr Eck u. ich,</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_8" custom="readingOrder {index:7;} textStyle {offset:11; length:3;italic:true;} textStyle {offset:39; length:7;italic:true;} textStyle {offset:65; length:6;italic:true;}">
                <Coords points="326,969 2075,975 2075,945 326,939"/>
                <Baseline points="326,969 2075,975"/>
                <TextEquiv>
                    <Unicode>gegen Frau Eck u. ihre Schwägerin (Fr. Richers.) Wir gewannen 39 Points.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_9" custom="readingOrder {index:8;} textStyle {offset:41; length:6;italic:true;}">
                <Coords points="2081,1087 332,1059 332,1089 2081,1117"/>
                <Baseline points="2081,1087 332,1059"/>
                <TextEquiv>
                    <Unicode>Es waren 22 Grd R. heute. Abends kam ein Norder der es auf 15 Grd herunter</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_10" custom="readingOrder {index:9;}">
                <Coords points="354,1143 1040,1138 1040,1108 354,1113"/>
                <Baseline points="354,1143 1040,1138"/>
                <TextEquiv>
                    <Unicode>brachte. Ging um 11 Uhr zu Bett.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextEquiv>
                <Unicode></Unicode>
            </TextEquiv>
        </TextRegion>
        <TextRegion id="r_2" custom="readingOrder {index:2;} structure {type:day_start;}">
            <Coords points="223,1179 2152,1179 2152,2094 223,2094"/>
            <TextLine id="l_11" custom="readingOrder {index:0;} textStyle {offset:0; length:13;italic:true;} textStyle {offset:16; length:2;italic:true; superscript:true;}">
                <Coords points="590,1312 1732,1323 1732,1293 590,1282"/>
                <Baseline points="590,1312 1732,1323"/>
                <TextEquiv>
                    <Unicode>Lunes Febrero 28mo 1876.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_12" custom="readingOrder {index:1;} textStyle {offset:20; length:5;italic:true;} textStyle {offset:60; length:6;italic:true;}">
                <Coords points="315,1424 2053,1396 2053,1366 315,1394"/>
                <Baseline points="315,1424 2053,1396"/>
                <TextEquiv>
                    <Unicode>Der Norder hält an. Therm 9 Grd. R. Wollte gestern schon zu Köhler</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_13" custom="readingOrder {index:2;} textStyle {offset:47; length:16;italic:true;}">
                <Coords points="2053,1520 321,1486 320,1516 2052,1550"/>
                <Baseline points="2053,1520 321,1486"/>
                <TextEquiv>
                    <Unicode>reiten um die Probe von Dienstag zu ändern, als Henry Sladzczyk bei uns</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_14" custom="readingOrder {index:3;} textStyle {offset:32; length:7;italic:true;}">
                <Coords points="315,1582 2092,1587 2092,1557 315,1552"/>
                <Baseline points="315,1582 2092,1587"/>
                <TextEquiv>
                    <Unicode>vorbeikam und sagte, er habe es Köhlern schon gesagt, u. bestelle eben die Spieler</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_15" custom="readingOrder {index:4;}">
                <Coords points="2025,1700 337,1661 336,1691 2024,1730"/>
                <Baseline points="2025,1700 337,1661"/>
                <TextEquiv>
                    <Unicode>auf Montag. Er war mit mir in der Stadt gewesen, als ich an den Turnerball erin-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_16" custom="readingOrder {index:5;} textStyle {offset:27; length:10;italic:true;}">
                <Coords points="326,1739 1946,1762 1946,1732 326,1709"/>
                <Baseline points="326,1739 1946,1762"/>
                <TextEquiv>
                    <Unicode>nert wurde. Werden (unsere Brass Band) einige Stück spielen, am Dienstag.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_17" custom="readingOrder {index:6;} textStyle {offset:37; length:8;italic:true;} textStyle {offset:51; length:7;italic:true;} textStyle {offset:63; length:11;italic:true;}">
                <Coords points="1963,1829 337,1824 337,1854 1963,1859"/>
                <Baseline points="1963,1829 337,1824"/>
                <TextEquiv>
                    <Unicode>Abends ritt ich zur Leseprobe in der Teutonia. Fr. Naumann und Ed. Wildner</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_18" custom="readingOrder {index:7;}">
                <Coords points="337,1958 2036,1964 2036,1934 337,1928"/>
                <Baseline points="337,1958 2036,1964"/>
                <TextEquiv>
                    <Unicode>waren nicht da, und wurde (deshalb) keine Bühnenprobe abgehalten wie zuerst besprochen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_19" custom="readingOrder {index:8;}">
                <Coords points="1760,2037 332,2015 332,2045 1760,2067"/>
                <Baseline points="1760,2037 332,2015"/>
                <TextEquiv>
                    <Unicode>wurde. Die Besetzung ist herzlich schlecht. Therm Abends 12 Gr R.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextEquiv>
                <Unicode></Unicode>
            </TextEquiv>
        </TextRegion>
        <TextRegion id="r_3" custom="readingOrder {index:3;} structure {type:comment;}">
