        <TextRegion id="r_4" custom="readingOrder {index:4;} structure {type:day_start;}">
            <Coords points="142,2100 2163,2100 2163,3159 142,3159"/>
            <TextLine id="l_20" custom="readingOrder {index:0;} textStyle {offset:0; length:14;italic:true;} textStyle {offset:17; length:2;italic:true; superscript:true;}">
                <Coords points="529,2211 1693,2234 1694,2204 530,2181"/>
                <Baseline points="529,2211 1693,2234"/>
                <TextEquiv>
                    <Unicode>Martes Febrero 29mo 1876.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_21" custom="readingOrder {index:1;} textStyle {offset:62; length:6;italic:true;}">
                <Coords points="2058,2301 326,2279 326,2309 2058,2331"/>
                <Baseline points="2058,2301 326,2279"/>
                <TextEquiv>
                    <Unicode>Es ist etwas regnerisches Wetter. Ich habe gar keine Lust zum Turner-</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_22" custom="readingOrder {index:2;} textStyle {offset:0; length:4;italic:true;}">
                <Coords points="337,2369 2070,2391 2070,2361 337,2339"/>
                <Baseline points="337,2369 2070,2391"/>
                <TextEquiv>
                    <Unicode>ball zu gehen und wenn es möglich ist, gehe ich nicht hin. Wenn ich nur</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_23" custom="readingOrder {index:3;} textStyle {offset:70; length:5;italic:true;}">
                <Coords points="2086,2447 309,2470 309,2500 2086,2477"/>
                <Baseline points="2086,2447 309,2470"/>
                <TextEquiv>
                    <Unicode>nicht versprochen hätte heute Abend zu spielen so blieb ich zu Hause. Therm</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_24" custom="readingOrder {index:4;}">
                <Coords points="304,2571 2025,2571 2025,2541 304,2541"/>
                <Baseline points="304,2571 2025,2571"/>
                <TextEquiv>
                    <Unicode>Mittags 20 Grd R. Nach der Schule holte ich mir mein Pferd, rasirte mich und</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_25" custom="readingOrder {index:5;}">
                <Coords points="2047,2616 315,2667 316,2697 2048,2646"/>
                <Baseline points="2047,2616 315,2667"/>
                <TextEquiv>
                    <Unicode>machte mich dann fertig zur Stadt zu reiten. Hätte die ganze Zeit lang geglaubt es</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_26" custom="readingOrder {index:6;}">
                <Coords points="315,2734 2070,2757 2070,2727 315,2704"/>
                <Baseline points="315,2734 2070,2757"/>
                <TextEquiv>
                    <Unicode>würde anfangen zu regnen, und wäre dann nicht geritten, - Doch es wollte nicht</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_27" custom="readingOrder {index:7;} textStyle {offset:49; length:9;italic:true;}">
                <Coords points="2081,2796 332,2830 333,2860 2082,2826"/>
                <Baseline points="2081,2796 332,2830"/>
                <TextEquiv>
                    <Unicode>und ich mußte halt gehen. Stellte mein Pferd bei Kleinerts ein und wurde genöthigt zum</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_28" custom="readingOrder {index:8;}">
                <Coords points="309,2948 2081,2897 2080,2867 308,2918"/>
                <Baseline points="309,2948 2081,2897"/>
                <TextEquiv>
                    <Unicode>Abendessen und die Nacht dazubleiben. Der Ball war sehr schön, das Theater ging recht gut</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_29" custom="readingOrder {index:9;} textStyle {offset:75; length:3;italic:true;}">
                <Coords points="2098,2970 349,3004 350,3034 2099,3000"/>
                <Baseline points="2098,2970 349,3004"/>
                <TextEquiv>
                    <Unicode>und jeder schien zufrieden. Um 3 Uhr war der Ball vorüber. Bis dahin waren ca. 30-40</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_30" custom="readingOrder {index:10;}">
                <Coords points="343,3071 1693,3128 1694,3098 344,3041"/>
                <Baseline points="343,3071 1693,3128"/>
                <TextEquiv>
                    <Unicode>Paar dageblieben, so daß bis zuletzt genug Tänzer und innen waren.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextEquiv>
                <Unicode></Unicode>
            </TextEquiv>
        </TextRegion>
        <TextRegion id="r_5" custom="readingOrder {index:5;} structure {type:day_start;}">
            <Coords points="202,3145 2171,3145 2171,3628 202,3628"/>
            <TextLine id="l_31" custom="readingOrder {index:0;} textStyle {offset:0; length:15;italic:true;} textStyle {offset:17; length:2;italic:true; superscript:true;}">
                <Coords points="1845,3240 680,3257 680,3287 1845,3270"/>
                <Baseline points="1845,3240 680,3257"/>
                <TextEquiv>
                    <Unicode>Miercoles Marzo 1mo 1876.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_32" custom="readingOrder {index:1;}">
                <Coords points="343,3330 2058,3347 2058,3317 343,3300"/>
                <Baseline points="343,3330 2058,3347"/>
                <TextEquiv>
                    <Unicode>Stand um 7 Uhr auf, frühstückte und ritt dann heim. Es ist ein wundervoller</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_33" custom="readingOrder {index:2;}">
                <Coords points="1974,3487 253,3448 252,3478 1973,3517"/>
                <Baseline points="1974,3487 253,3448"/>
                <TextEquiv>
                    <Unicode>Morgen. Nachmittags fing es bald an zu nieseln, bald schien die Sonne; einen</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="l_34" custom="readingOrder {index:3;} textStyle {offset:62; length:5;italic:true;}">
                <Coords points="276,3543 1957,3538 1957,3508 276,3513"/>
                <Baseline points="276,3543 1957,3538"/>
                <TextEquiv>
                    <Unicode>Augenblick hatten wir Norder, gleich darauf war es ganz warm. Therm 15 Grd.</Unicode>
                </TextEquiv>
            </TextLine>
            <TextEquiv>
                <Unicode></Unicode>
            </TextEquiv>
        </TextRegion>
