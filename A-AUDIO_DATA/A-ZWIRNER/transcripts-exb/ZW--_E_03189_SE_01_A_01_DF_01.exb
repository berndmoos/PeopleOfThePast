<event start="TLI_257" end="TLI_258">(0.34) </event>
<event start="TLI_258" end="TLI_259">aber trotzdem widder gesund nach Hause gekummen no Huse gekommen. </event>
<event start="TLI_259" end="TLI_260">(1.32) </event>
<event start="TLI_260" end="TLI_261">un </event>
<event start="TLI_261" end="TLI_262">(4.32) </event>
