</tier><tier id="TIE4" speaker="S2" category="norm" type="a" display-name="S2 [norm]"><event start="TLI_1" end="TLI_2">(0.39) </event>
<event start="TLI_2" end="TLI_3">ich bin aus der Schule gekommen, </event>
<event start="TLI_3" end="TLI_4">nicht. </event>
<event start="TLI_4" end="TLI_5">so meinen Sie doch, </event>
<event start="TLI_5" end="TLI_6">nicht, </event>
<event start="TLI_6" end="TLI_7">(0.69) </event>
<event start="TLI_7" end="TLI_8">in %, </event>
<event start="TLI_8" end="TLI_9">in achzehnhundertundneunzig, </event>
<event start="TLI_9" end="TLI_10">(1.05) </event>
<event start="TLI_10" end="TLI_11">nicht. </event>
<event start="TLI_11" end="TLI_12">(2.08) </event>
<event start="TLI_12" end="TLI_13">da bin ich </event>
<event start="TLI_13" end="TLI_14">(0.55) </event>
<event start="TLI_14" end="TLI_15">gleich bei die Bauern gekommen, </event>
<event start="TLI_15" end="TLI_16">(0.36) </event>
<event start="TLI_16" end="TLI_17">bei die Bauern gekommen. </event>
<event start="TLI_17" end="TLI_18">guck, </event>
<event start="TLI_18" end="TLI_19">da kann man schon- </event>
<event start="TLI_19" end="TLI_20">(0.52) </event>
<event start="TLI_21" end="TLI_22">ja</event>
<event start="TLI_23" end="TLI_24">bin ich gleich bei die Bauern gekommen. </event>
<event start="TLI_24" end="TLI_25">(0.39) </event>
<event start="TLI_25" end="TLI_26">bei meinen Paten in Immighausen. </event>
<event start="TLI_26" end="TLI_27">(0.85) </event>
<event start="TLI_27" end="TLI_28">das ist Immighausen, </event>
<event start="TLI_28" end="TLI_29">nicht. </event>
<event start="TLI_29" end="TLI_30">(0.54) </event>
<event start="TLI_30" end="TLI_31">bei meinen Paten in Immighausen. </event>
<event start="TLI_31" end="TLI_32">(2.22) </event>
<event start="TLI_32" end="TLI_33">dann </event>
<event start="TLI_33" end="TLI_34">(0.88) </event>
<event start="TLI_34" end="TLI_35">bin ich den Herbst </event>
<event start="TLI_35" end="TLI_36">(0.96) </event>
<event start="TLI_36" end="TLI_37">wieder % nach heim gekommen. </event>
<event start="TLI_37" end="TLI_38">(1.36) </event>
<event start="TLI_38" end="TLI_39">bin dann den Winter </event>
<event start="TLI_39" end="TLI_40">(0.65) </event>
<event start="TLI_40" end="TLI_41">auf die Winterschule gegangen nach Korbach. </event>
<event start="TLI_41" end="TLI_42">(1.42) </event>
<event start="TLI_42" end="TLI_43">und das Frühjahr kam ich bei unsern </event>
<event start="TLI_43" end="TLI_44">Nachbar wieder % </event>
<event start="TLI_44" end="TLI_45">in Stellung </event>
<event start="TLI_45" end="TLI_46">(0.39) </event>
<event start="TLI_46" end="TLI_47">als kleiner Knecht. </event>
<event start="TLI_47" end="TLI_48">(1.11) </event>
<event start="TLI_48" end="TLI_49">da war  </event>
<event start="TLI_49" end="TLI_50">(0.41) </event>
<event start="TLI_50" end="TLI_51">äh mein großer Knecht das war äh </event>
<event start="TLI_51" end="TLI_52">(0.36) </event>
<event start="TLI_52" end="TLI_53">Brocken Karl. </event>
<event start="TLI_53" end="TLI_54">auch aus Niederense. </event>
<event start="TLI_54" end="TLI_55">(2.34) </event>
<event start="TLI_55" end="TLI_56">dann </event>
<event start="TLI_56" end="TLI_57">(0.43) </event>
<event start="TLI_57" end="TLI_58">dachte ich den Herbst, </event>
<event start="TLI_58" end="TLI_59">(1.03) </event>
<event start="TLI_59" end="TLI_60">die behielten den kleinen Knecht nicht, </event>
<event start="TLI_60" end="TLI_61">weil das ein kleines Gut </event>
<event start="TLI_61" end="TLI_62">äh  </event>
<event start="TLI_62" end="TLI_63">ist</event>
<event start="TLI_63" end="TLI_64">(0.36) </event>
<event start="TLI_64" end="TLI_65">Gut ist, </event>
<event start="TLI_65" end="TLI_66">(0.88) </event>
<event start="TLI_66" end="TLI_67">und </event>
<event start="TLI_67" end="TLI_68">(0.19) </event>
<event start="TLI_68" end="TLI_69">da hab ich </event>
<event start="TLI_69" end="TLI_70">(0.15) </event>
<event start="TLI_70" end="TLI_71">mich den Winter </event>
<event start="TLI_71" end="TLI_72">(0.31) </event>
<event start="TLI_72" end="TLI_73">nach Goldhausen vermietet. </event>
<event start="TLI_73" end="TLI_74">(2.01) </event>
<event start="TLI_74" end="TLI_75">und bin da auch ein Jahr gewesen. </event>
<event start="TLI_75" end="TLI_76">aber da hat es mir nicht so gut gefallen. </event>
<event start="TLI_76" end="TLI_77">(1.11) </event>
<event start="TLI_77" end="TLI_78">da hab ich bloß ein Jahr gemacht. </event>
<event start="TLI_78" end="TLI_79">(1.47) </event>
<event start="TLI_81" end="TLI_82">War schlechte Kost </event>
<event start="TLI_84" end="TLI_85">weil da manches mir nicht gefiel. </event>
<event start="TLI_85" end="TLI_86">(1.32) </event>
<event start="TLI_86" end="TLI_87">die Lebensmittel waren nicht mal </event>
<event start="TLI_87" end="TLI_88">(0.25) </event>
<event start="TLI_88" end="TLI_89">nicht so gut. </event>
<event start="TLI_89" end="TLI_90">(0.96) </event>
<event start="TLI_90" end="TLI_91">und übrigens </event>
<event start="TLI_91" end="TLI_92">(0.28) </event>
<event start="TLI_92" end="TLI_93">der Mann, </event>
<event start="TLI_93" end="TLI_94">der trank sich immer einen und dann gab es Krawall! </event>
<event start="TLI_94" end="TLI_95">(0.66) </event>
<event start="TLI_95" end="TLI_96">und da habe ich gedacht: </event>
<event start="TLI_96" end="TLI_97">hier bleibst du nicht. </event>
<event start="TLI_97" end="TLI_98">(1.26) </event>
