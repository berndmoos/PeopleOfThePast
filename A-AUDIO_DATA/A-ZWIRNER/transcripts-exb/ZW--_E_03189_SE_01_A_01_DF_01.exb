<event start="TLI_433" end="TLI_434">(2.23) </event>
<event start="TLI_434" end="TLI_436">so, und dann </event>
<event start="TLI_436" end="TLI_437">(1.35) </event>
<event start="TLI_437" end="TLI_438">kam dann die </event>
<event start="TLI_438" end="TLI_439">(0.32) </event>
<event start="TLI_439" end="TLI_440">die Hafergeschichte dran, </event>
<event start="TLI_440" end="TLI_441">(0.79) </event>
<event start="TLI_441" end="TLI_442">Hafer, </event>
<event start="TLI_442" end="TLI_443">(0.3) </event>
<event start="TLI_443" end="TLI_445">na, das war auch ein kurzer Übergang. </event>
<event start="TLI_445" end="TLI_446">(0.3) </event>
<event start="TLI_446" end="TLI_447">ich war die ersten Jahre auch bei den Bauern. </event>
<event start="TLI_447" end="TLI_448">(0.24) </event>
