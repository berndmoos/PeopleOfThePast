<event start="TLI_167" end="TLI_168">(0.78) </event>
<event start="TLI_168" end="TLI_169">und von der Zeit an </event>
<event start="TLI_169" end="TLI_170">(0.79) </event>
<event start="TLI_170" end="TLI_171">habe ich das Wesen da übernommen. </event>
<event start="TLI_171" end="TLI_172">(0.42) </event>
<event start="TLI_172" end="TLI_173"><![CDATA[Das war in neunzehnhundert > . ]]></event>
<event start="TLI_173" end="TLI_174">(8.11) </event>
<event start="TLI_174" end="TLI_175">Da haben wir nun </event>
<event start="TLI_175" end="TLI_176">(0.55) </event>
<event start="TLI_176" end="TLI_177">die Zeit mit meiner Frau gelebt, </event>
<event start="TLI_177" end="TLI_178">(1.03) </event>
<event start="TLI_178" end="TLI_179"><![CDATA[und ich bin in der Zwischenzeit nach > ]]></event>
<event start="TLI_179" end="TLI_180">da war eine Ziegelbäckerei, </event>
<event start="TLI_180" end="TLI_181">hier unten im Eck, </event>
<event start="TLI_181" end="TLI_182">(0.42) </event>
<event start="TLI_182" end="TLI_183">das war ein Verwandter von mir. </event>
<event start="TLI_183" end="TLI_184">(0.15) </event>
<event start="TLI_184" end="TLI_185">Hab ich dann noch </event>
<event start="TLI_185" end="TLI_186">(0.3) </event>
<event start="TLI_186" end="TLI_187">neun Jahre </event>
<event start="TLI_187" end="TLI_188">(0.24) </event>
<event start="TLI_188" end="TLI_189">als Pferdeknecht gedient. </event>
<event start="TLI_189" end="TLI_190">(0.97) </event>
<event start="TLI_190" end="TLI_191">Weil's meine Verwandten waren, </event>
<event start="TLI_191" end="TLI_192">und mein Vater der war daheim noch, - </event>
<event start="TLI_192" end="TLI_193">der machte die Hausarbeit noch </event>
<event start="TLI_193" end="TLI_194">(0.4) </event>
<event start="TLI_194" end="TLI_195">und die Feldarbeit- </event>
<event start="TLI_195" end="TLI_196">und ich half dann bloß zur Aushilfe. </event>
<event start="TLI_196" end="TLI_197">(2.04) </event>
<event start="TLI_197" end="TLI_198">Dann </event>
<event start="TLI_198" end="TLI_199">(1.59) </event>
<event start="TLI_199" end="TLI_200">kam dann mit den Jahren wieder der erste Weltkrieg. </event>
<event start="TLI_200" end="TLI_201">(1.47) </event>
<event start="TLI_201" end="TLI_202">Wir wurden eingezogen, </event>
<event start="TLI_202" end="TLI_203">das wurde ich selber auch, </event>
<event start="TLI_203" end="TLI_204">(0.66) </event>
<event start="TLI_204" end="TLI_205">als Landsturmmann. </event>
<event start="TLI_205" end="TLI_206">(0.67) </event>
<event start="TLI_206" end="TLI_207"><![CDATA[Habe da in > ]]></event>
<event start="TLI_207" end="TLI_208">(1.21) </event>
<event start="TLI_208" end="TLI_209">bei Kassel- </event>
<event start="TLI_209" end="TLI_210">in Oberzwehren- </event>
<event start="TLI_210" end="TLI_211">in Quartier gelegen. </event>
<event start="TLI_211" end="TLI_212">(0.25) </event>
<event start="TLI_212" end="TLI_213">Zur Bewachung der Gefangenen. </event>
<event start="TLI_213" end="TLI_214">Und da kamen </event>
<event start="TLI_214" end="TLI_215">(0.24) </event>
<event start="TLI_215" end="TLI_216">die jüngsten Jahrgänge raus </event>
<event start="TLI_216" end="TLI_217">(0.18) </event>
<event start="TLI_217" end="TLI_218">und kamen nach Belgien, </event>
<event start="TLI_218" end="TLI_219">(5.38) </event>
<event start="TLI_219" end="TLI_220">nach Belgien. </event>
<event start="TLI_220" end="TLI_221">(0.42) </event>
<event start="TLI_221" end="TLI_222">Da waren wir </event>
<event start="TLI_222" end="TLI_223">(0.66) </event>
<event start="TLI_223" end="TLI_224">fünfzehn, </event>
<event start="TLI_224" end="TLI_225">(0.18) </event>
<event start="TLI_225" end="TLI_226">sechzehn, </event>
<event start="TLI_226" end="TLI_227">(1.11) </event>
<event start="TLI_227" end="TLI_228">bis das Frühjahr siebzehn. </event>
<event start="TLI_228" end="TLI_229">(0.63) </event>
<event start="TLI_229" end="TLI_230">Und da kamen die jüngsten Jahrgänge wieder da raus. </event>
<event start="TLI_230" end="TLI_231">(0.3) </event>
<event start="TLI_231" end="TLI_232">Da waren wir auch wieder bei. </event>
<event start="TLI_232" end="TLI_233">(0.16) </event>
<event start="TLI_233" end="TLI_234">Der Jahrgang fünfundsiebzig. </event>
<event start="TLI_234" end="TLI_235">(1.0) </event>
<event start="TLI_235" end="TLI_236">Und kamen nach Russland. </event>
<event start="TLI_236" end="TLI_237">(3.12) </event>
<event start="TLI_237" end="TLI_238">Da sind wir in Russland gewesen, </event>
<event start="TLI_238" end="TLI_239">an der Düna, </event>
<event start="TLI_241" end="TLI_242">(1.4) </event>
<event start="TLI_242" end="TLI_243">ja, </event>
<event start="TLI_243" end="TLI_244">(1.95) </event>
<event start="TLI_244" end="TLI_245">in Russland an der Düna. </event>
<event start="TLI_245" end="TLI_246">(1.17) </event>
<event start="TLI_246" end="TLI_247">Und wie hieß denn der? </event>
<event start="TLI_247" end="TLI_248">(1.32) </event>
<event start="TLI_248" end="TLI_249">Die Namen weiß man garnicht mehr alle. </event>
<event start="TLI_249" end="TLI_250">(2.43) </event>
<event start="TLI_251" end="TLI_252">(0.36) </event>
<event start="TLI_252" end="TLI_253">und da haben wir den Krieg glücklich überwunden. </event>
<event start="TLI_253" end="TLI_254">(0.79) </event>
<event start="TLI_254" end="TLI_255">Mit Unsern schwere </event>
<event start="TLI_255" end="TLI_256">(0.69) </event>
<event start="TLI_256" end="TLI_257">Attacke mitgemacht! </event>
<event start="TLI_257" end="TLI_258">(0.34) </event>
<event start="TLI_258" end="TLI_259"><![CDATA[Aber trotzdem wieder gesund nach Hause gekommen > nach Hause gekommen. ]]></event>
<event start="TLI_259" end="TLI_260">(1.32) </event>
<event start="TLI_260" end="TLI_261">Und </event>
<event start="TLI_261" end="TLI_262">(4.32) </event>
<event start="TLI_262" end="TLI_263"><![CDATA[> das war in ]]></event>
<event start="TLI_263" end="TLI_264">(0.39) </event>
<event start="TLI_264" end="TLI_265">achtzehn, </event>
<event start="TLI_265" end="TLI_266">nicht? </event>
<event start="TLI_266" end="TLI_267">(0.4) </event>
<event start="TLI_267" end="TLI_268">War der Krieg zu Ende, nicht? </event>
<event start="TLI_268" end="TLI_269">(3.8) </event>
<event start="TLI_269" end="TLI_270">In achtzehn </event>
<event start="TLI_270" end="TLI_271">da war der Krieg nun zu Ende. </event>
<event start="TLI_271" end="TLI_272">Da kamen wir glücklich nun wieder nach heim. </event>
<event start="TLI_272" end="TLI_273">(1.08) </event>
<event start="TLI_273" end="TLI_274">Und da hat es gut gegangen, </event>
<event start="TLI_274" end="TLI_275">gegangen </event>
<event start="TLI_275" end="TLI_276">(1.69) </event>
<event start="TLI_276" end="TLI_277"><![CDATA[bis in > ]]></event>
<event start="TLI_277" end="TLI_278">(4.57) </event>
<event start="TLI_278" end="TLI_279">bis in dreiundzwanzig. </event>
<event start="TLI_279" end="TLI_280">Da war die Entwertung, </event>
<event start="TLI_280" end="TLI_281">(0.55) </event>
<event start="TLI_281" end="TLI_282">Geldentwertung. </event>
<event start="TLI_282" end="TLI_283">Da hatten wir auch wieder drunter zu leiden </event>
<event start="TLI_283" end="TLI_284">(0.45) </event>
<event start="TLI_284" end="TLI_285">und mußten wieder von vorne anfangen. </event>
<event start="TLI_285" end="TLI_286">(2.4) </event>
<event start="TLI_286" end="TLI_287">Und so hat das dann weiter gegangen, </event>
<event start="TLI_287" end="TLI_288">weiter gegangen, </event>
<event start="TLI_288" end="TLI_289">bis daß man </event>
<event start="TLI_289" end="TLI_290">(1.8) </event>
<event start="TLI_290" end="TLI_291"><![CDATA[in > ]]></event>
<event start="TLI_291" end="TLI_292">(1.51) </event>
<event start="TLI_292" end="TLI_293">in die Hitlerzeit wieder gekommen. </event>
<event start="TLI_293" end="TLI_294">(0.72) </event>
<event start="TLI_294" end="TLI_295">Da hat man nun alle Wunder geglaubt jetzt ging es wieder bergauf. </event>
<event start="TLI_295" end="TLI_296">(0.51) </event>
<event start="TLI_296" end="TLI_297">Und aber grade verkehrt gegangen. </event>
<event start="TLI_297" end="TLI_298">(0.57) </event>
<event start="TLI_298" end="TLI_299">Gegangen. </event>
<event start="TLI_299" end="TLI_300">(0.19) </event>
<event start="TLI_300" end="TLI_301">Und sind dabei zugrunde gegangen. |</event>
<event start="TLI_301" end="TLI_302">(2.49) </event>
<event start="TLI_309" end="TLI_310">(0.67) </event>
<event start="TLI_310" end="TLI_311">Woll 'n mal sagen, </event>
<event start="TLI_311" end="TLI_312">vom Frühjahr an, </event>
<event start="TLI_312" end="TLI_313">nicht? </event>
<event start="TLI_313" end="TLI_314">(3.66) </event>
<event start="TLI_314" end="TLI_315">Ja, </event>
<event start="TLI_315" end="TLI_316">(0.33) </event>
<event start="TLI_316" end="TLI_317">das Frühjahr! </event>
<event start="TLI_317" end="TLI_318">(2.76) </event>
<event start="TLI_318" end="TLI_319">Den Winter bin ich in den Holzwald gegangen, </event>
<event start="TLI_319" end="TLI_320">gegangen. </event>
<event start="TLI_320" end="TLI_321">(0.51) </event>
<event start="TLI_321" end="TLI_322">Und</event>
<event start="TLI_322" end="TLI_323">(0.52) </event>
<event start="TLI_323" end="TLI_324">Und das Frühjahr- </event>
<event start="TLI_324" end="TLI_325">wenn dann die Bestellung los geht- </event>
<event start="TLI_325" end="TLI_326">(0.87) </event>
<event start="TLI_326" end="TLI_327">dann</event>
<event start="TLI_327" end="TLI_328">(0.37) </event>
<event start="TLI_328" end="TLI_329">dann wurde Mist gefahren. </event>
<event start="TLI_329" end="TLI_330">(0.19) </event>
<event start="TLI_330" end="TLI_331">Wenn's eggen ging, </event>
<event start="TLI_331" end="TLI_332">dann ging man ans säen. </event>
<event start="TLI_332" end="TLI_333">(0.39) </event>
<event start="TLI_333" end="TLI_334">Da wurde noch alles </event>
<event start="TLI_334" end="TLI_335">(0.16) </event>
<event start="TLI_335" end="TLI_336">mit der Hand meist gesät in den ersten Jahren, </event>
<event start="TLI_336" end="TLI_337">(0.46) </event>
<event start="TLI_337" end="TLI_338">wie ich gefreit habe. </event>
<event start="TLI_338" end="TLI_339">(0.55) </event>
<event start="TLI_339" end="TLI_340">Und nachher, </event>
<event start="TLI_340" end="TLI_341">da kamen dann so langsam die</event>
<event start="TLI_341" end="TLI_342">die Sämaschinen auch an. </event>
<event start="TLI_342" end="TLI_343">(0.93) </event>
<event start="TLI_343" end="TLI_344">Aber den Kunstdünger, </event>
<event start="TLI_344" end="TLI_345">den hab ich noch mit der Hand gestreut </event>
<event start="TLI_345" end="TLI_346">(0.49) </event>
<event start="TLI_346" end="TLI_347">und </event>
<event start="TLI_347" end="TLI_348">(0.25) </event>
<event start="TLI_348" end="TLI_349">alles. </event>
<event start="TLI_349" end="TLI_350">(1.86) </event>
<event start="TLI_350" end="TLI_351">Und da ging es auch. </event>
<event start="TLI_351" end="TLI_352">(1.29) </event>
<event start="TLI_352" end="TLI_353">Wenn man dann mit der Aussaat fertig war, </event>
<event start="TLI_353" end="TLI_354">mit den </event>
<event start="TLI_354" end="TLI_355">(0.27) </event>
<event start="TLI_355" end="TLI_356"><![CDATA[> Kartoffeln gepflanzt hatte, ]]></event>
<event start="TLI_356" end="TLI_357">(0.52) </event>
<event start="TLI_357" end="TLI_358">dann </event>
<event start="TLI_358" end="TLI_359">(1.29) </event>
<event start="TLI_359" end="TLI_360">ging's dann so langsam an die Mäherei, </event>
<event start="TLI_360" end="TLI_361">daß der Klee herbei kam. </event>
<event start="TLI_361" end="TLI_362">(0.75) </event>
<event start="TLI_362" end="TLI_363">Wurde auch alles mit der Hand gemäht. </event>
<event start="TLI_363" end="TLI_364">(1.99) </event>
<event start="TLI_364" end="TLI_365">Und so auch die Wiesen. </event>
<event start="TLI_365" end="TLI_366">Die wurden auch alle mit der Hand noch gemäht. </event>
<event start="TLI_366" end="TLI_367">(1.2) </event>
<event start="TLI_367" end="TLI_368">Was heute nicht mehr- </event>
<event start="TLI_368" end="TLI_369">(0.19) </event>
<event start="TLI_369" end="TLI_371">niemand- tut. </event>
<event start="TLI_371" end="TLI_372">(5.17) </event>
<event start="TLI_372" end="TLI_373">Und da ging es dann so langsam weiter ans Heumachen. </event>
<event start="TLI_373" end="TLI_374">(0.96) </event>
<event start="TLI_374" end="TLI_375">Das wurde auch alles mit der Hand gemäht. </event>
<event start="TLI_375" end="TLI_376">(0.51) </event>
<event start="TLI_376" end="TLI_377">Und </event>
<event start="TLI_377" end="TLI_378">(0.28) </event>
<event start="TLI_378" end="TLI_379">so reichte Eines dem Andern die Hand, </event>
<event start="TLI_379" end="TLI_380">bis man ans Korn ging. </event>
<event start="TLI_380" end="TLI_381">(0.97) </event>
<event start="TLI_381" end="TLI_382">Wenn's Korn ab war, </event>
<event start="TLI_382" end="TLI_383">dann war mitunter mal so 'ne kleine Pause. </event>
<event start="TLI_383" end="TLI_384">(1.3) </event>
<event start="TLI_384" end="TLI_385">Dann kam die Sommerfrucht wieder heran. </event>
<event start="TLI_385" end="TLI_386">Und zwischen der </event>
<event start="TLI_386" end="TLI_387">(0.58) </event>
<event start="TLI_387" end="TLI_388">Pause, </event>
<event start="TLI_388" end="TLI_389">da wurde dann maschint. </event>
<event start="TLI_389" end="TLI_390">(0.63) </event>
<event start="TLI_390" end="TLI_391">Die ersten Jahre, </event>
<event start="TLI_391" end="TLI_392"><![CDATA[da waren noch die > ]]></event>
<event start="TLI_392" end="TLI_393">(0.44) </event>
<event start="TLI_393" end="TLI_394"><![CDATA[die > ]]></event>
<event start="TLI_394" end="TLI_395">(1.12) </event>
<event start="TLI_395" end="TLI_396">die Dreschmaschinen noch nicht so, </event>
<event start="TLI_396" end="TLI_397">wie sie heute sind. </event>
<event start="TLI_397" end="TLI_398">(0.63) </event>
<event start="TLI_398" end="TLI_399"><![CDATA[Die waren > da hatten die Bauern alle Göpelmaschinen. ]]></event>
<event start="TLI_399" end="TLI_400">(0.19) </event>
<event start="TLI_400" end="TLI_401">Da wurden die Pferde vorgespannt. </event>
<event start="TLI_401" end="TLI_402">(0.81) </event>
<event start="TLI_402" end="TLI_403"><![CDATA[Und später kamen dann da die > ]]></event>
<event start="TLI_403" end="TLI_404">(0.52) </event>
<event start="TLI_404" end="TLI_405">die ersten Dampfmaschinen herbei. </event>
<event start="TLI_405" end="TLI_406">(1.68) </event>
<event start="TLI_406" end="TLI_407">Und </event>
<event start="TLI_407" end="TLI_408">(0.28) </event>
<event start="TLI_408" end="TLI_409">das hat sich dann auch wieder überlebt. </event>
<event start="TLI_409" end="TLI_410">(0.36) </event>
<event start="TLI_410" end="TLI_411"><![CDATA[Später gab es dann diese > Motor]]></event>
<event start="TLI_411" end="TLI_412">(0.61) </event>
<event start="TLI_412" end="TLI_413">geschichte kam dann heran. </event>
<event start="TLI_413" end="TLI_414">(0.73) </event>
<event start="TLI_414" end="TLI_415">Da wurden Motoren angeschafft. </event>
<event start="TLI_415" end="TLI_416">Und dann wurde alles mit Elektrisch gemacht. </event>
<event start="TLI_416" end="TLI_417">(1.0) </event>
<event start="TLI_417" end="TLI_418">Elektrizität, </event>
<event start="TLI_418" end="TLI_419">(0.22) </event>
<event start="TLI_419" end="TLI_420">die wurde auch hier angelegt. </event>
<event start="TLI_420" end="TLI_421">Das war in </event>
<event start="TLI_421" end="TLI_422">(0.51) </event>
<event start="TLI_422" end="TLI_423"><![CDATA[den > ]]></event>
<event start="TLI_423" end="TLI_424">(1.65) </event>
<event start="TLI_424" end="TLI_425">kurz vor dem Kriege. </event>
<event start="TLI_425" end="TLI_426">(0.3) </event>
<event start="TLI_426" end="TLI_427">Vorm ersten Kriege. </event>
<event start="TLI_427" end="TLI_428">(1.86) </event>
<event start="TLI_428" end="TLI_429">Und </event>
<event start="TLI_429" end="TLI_430">(2.79) </event>
<event start="TLI_430" end="TLI_431"><![CDATA[> - wo war 'n wir denn da-? ]]></event>
<event start="TLI_431" end="TLI_432">(1.9) </event>
<event start="TLI_432" end="TLI_433"><![CDATA[An der Ernte, nicht? > ]]></event>
<event start="TLI_433" end="TLI_434">(2.23) </event>
<event start="TLI_434" end="TLI_436">So, und dann </event>
<event start="TLI_436" end="TLI_437">(1.35) </event>
<event start="TLI_437" end="TLI_438"><![CDATA[kam die > ]]></event>
<event start="TLI_438" end="TLI_439">(0.32) </event>
<event start="TLI_439" end="TLI_440">die Hafergeschichte dran, </event>
<event start="TLI_440" end="TLI_441">(0.79) </event>
<event start="TLI_441" end="TLI_442">Hafer, </event>
<event start="TLI_442" end="TLI_443">(0.3) </event>
<event start="TLI_443" end="TLI_445">na, das war auch ein kurzer Übergang. </event>
<event start="TLI_445" end="TLI_446">(0.3) </event>
<event start="TLI_446" end="TLI_447">Ich war die ersten Jahre auch bei den Bauern. </event>
<event start="TLI_447" end="TLI_448">(0.24) </event>
<event start="TLI_448" end="TLI_449">Die mähten den </event>
<event start="TLI_449" end="TLI_450">(0.52) </event>
<event start="TLI_450" end="TLI_451">mit der Flügelmaschine. </event>
<event start="TLI_451" end="TLI_452">(0.63) </event>
<event start="TLI_452" end="TLI_453">Und später, </event>
<event start="TLI_453" end="TLI_454">da kamen denn auch so langsam die Binder herbei. </event>
<event start="TLI_454" end="TLI_455">(1.02) </event>
<event start="TLI_455" end="TLI_456">Und wer das nicht hatte, </event>
<event start="TLI_456" end="TLI_457">der mußte es mit der Hand abmachen. </event>
<event start="TLI_457" end="TLI_458">(0.93) </event>
<event start="TLI_458" end="TLI_459">Die kleineren Bauern. </event>
<event start="TLI_459" end="TLI_460">(7.11) </event>
<event start="TLI_460" end="TLI_461">Wenn nun die die Ernte so langsam </event>
<event start="TLI_461" end="TLI_462">(0.36) </event>
<event start="TLI_462" end="TLI_463">dadurch war, </event>
<event start="TLI_463" end="TLI_464">(0.3) </event>
<event start="TLI_464" end="TLI_465">dann kam die Maschinerei herbei. </event>
<event start="TLI_465" end="TLI_466">(0.3) </event>
<event start="TLI_466" end="TLI_467">Wurde das wieder gemacht. </event>
<event start="TLI_467" end="TLI_468">(0.66) </event>
<event start="TLI_468" end="TLI_469">Und </event>
<event start="TLI_469" end="TLI_470">(0.3) </event>
<event start="TLI_470" end="TLI_471">dazwischen wurde dann wieder die Herbstbestellung gemacht. </event>
<event start="TLI_471" end="TLI_472">(0.7) </event>
<event start="TLI_472" end="TLI_473">So reichte dann immer Eins dem Andern die Hand. |</event>
<event start="TLI_473" end="TLI_474">(11.8) </event>
<event start="TLI_477" end="TLI_478">Sonntag, Montag</event>
<event start="TLI_481" end="TLI_482">Ein, </event>
<event start="TLI_482" end="TLI_483">(0.3) </event>
<event start="TLI_483" end="TLI_484">zwei, </event>
<event start="TLI_484" end="TLI_485">(0.37) </event>
<event start="TLI_485" end="TLI_486">drei, </event>
<event start="TLI_486" end="TLI_487">(0.57) </event>
<event start="TLI_487" end="TLI_488">viere, </event>
<event start="TLI_488" end="TLI_489">(0.55) </event>
<event start="TLI_489" end="TLI_490">fünfe, </event>
<event start="TLI_490" end="TLI_491">(0.39) </event>
<event start="TLI_491" end="TLI_492">sechse, </event>
<event start="TLI_492" end="TLI_493">(0.48) </event>
<event start="TLI_493" end="TLI_494">siebene, </event>
<event start="TLI_494" end="TLI_495">(0.6) </event>
<event start="TLI_495" end="TLI_496">achte, </event>
<event start="TLI_496" end="TLI_497">(0.54) </event>
<event start="TLI_497" end="TLI_498">neune, </event>
<event start="TLI_498" end="TLI_499">(0.49) </event>
<event start="TLI_499" end="TLI_500">zehne, </event>
<event start="TLI_500" end="TLI_501">(1.41) </event>
