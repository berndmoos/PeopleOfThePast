</tier><tier id="TIE1" speaker="S2" category="v" type="t" display-name="S2"><event start="TLI_1" end="TLI_2">(0.39) </event>
<event start="TLI_2" end="TLI_3">Ich bin aus der Schule gekommen, </event>
<event start="TLI_3" end="TLI_4">nicht. - </event>
<event start="TLI_4" end="TLI_5">so meinen Sie doch, </event>
<event start="TLI_5" end="TLI_6">nicht, </event>
<event start="TLI_6" end="TLI_7">(0.69) </event>
<event start="TLI_7" end="TLI_8">in neunz, </event>
<event start="TLI_8" end="TLI_9">in achzehnhundertundneunzig, </event>
<event start="TLI_9" end="TLI_10">(1.05) </event>
<event start="TLI_10" end="TLI_11">nicht. </event>
<event start="TLI_11" end="TLI_12">(2.08) </event>
<event start="TLI_12" end="TLI_13">Da bin ich </event>
<event start="TLI_13" end="TLI_14">(0.55) </event>
<event start="TLI_14" end="TLI_15"><![CDATA[gleich bei die Bauern gekommen, > ]]></event>
<event start="TLI_15" end="TLI_16">(0.36) </event>
<event start="TLI_16" end="TLI_17">bei die Bauern gekommen. </event>
<event start="TLI_17" end="TLI_18">Guck, </event>
<event start="TLI_18" end="TLI_19">da kann man schon- |</event>
<event start="TLI_19" end="TLI_20">(0.52) </event>
<event start="TLI_21" end="TLI_22">Ja</event>
<event start="TLI_23" end="TLI_24">Ja, ich bin gleich bei die Bauern gekommen. </event>
<event start="TLI_24" end="TLI_25">(0.39) </event>
<event start="TLI_25" end="TLI_26">Bei meinen Vetter in Immighausen. </event>
<event start="TLI_26" end="TLI_27">(0.85) </event>
<event start="TLI_27" end="TLI_28">Das ist Immighausen, </event>
<event start="TLI_28" end="TLI_29">nicht. </event>
<event start="TLI_29" end="TLI_30">(0.54) </event>
<event start="TLI_30" end="TLI_31">Bei meinen Vetter in Immighausen. </event>
<event start="TLI_31" end="TLI_32">(2.22) </event>
<event start="TLI_32" end="TLI_33">Dann </event>
<event start="TLI_33" end="TLI_34">(0.88) </event>
<event start="TLI_34" end="TLI_35">bin ich den Herbst </event>
<event start="TLI_35" end="TLI_36">(0.96) </event>
<event start="TLI_36" end="TLI_37">wieder nach heim gekommen. </event>
<event start="TLI_37" end="TLI_38">(1.36) </event>
<event start="TLI_38" end="TLI_39">Sei dann den Winter </event>
<event start="TLI_39" end="TLI_40">(0.65) </event>
<event start="TLI_40" end="TLI_41">auf die Winterschule gegangen nach Korbach. </event>
<event start="TLI_41" end="TLI_42">(1.42) </event>
<event start="TLI_42" end="TLI_43">Und das Frühjahr kam ich bei unsern </event>
<event start="TLI_43" end="TLI_44">Nachbar wieder </event>
<event start="TLI_44" end="TLI_45">in Stellung </event>
<event start="TLI_45" end="TLI_46">(0.39) </event>
<event start="TLI_46" end="TLI_47">als Kleinknecht. </event>
<event start="TLI_47" end="TLI_48">(1.11) </event>
<event start="TLI_48" end="TLI_49"><![CDATA[Da war > ]]></event>
<event start="TLI_49" end="TLI_50">(0.41) </event>
<event start="TLI_50" end="TLI_51">mein großer Knecht das war</event>
<event start="TLI_51" end="TLI_52">(0.36) </event>
<event start="TLI_52" end="TLI_53">Brocken Karl. </event>
<event start="TLI_53" end="TLI_54">Auch aus Niederense. </event>
<event start="TLI_54" end="TLI_55">(2.34) </event>
<event start="TLI_55" end="TLI_56">Dann </event>
<event start="TLI_56" end="TLI_57">(0.43) </event>
<event start="TLI_57" end="TLI_58">dacht' ich den Herbst, </event>
<event start="TLI_58" end="TLI_59">(1.03) </event>
<event start="TLI_59" end="TLI_60">die behielten den kleinen Knecht nicht, </event>
<event start="TLI_60" end="TLI_61">weil das ein kleines Gut </event>
<event start="TLI_61" end="TLI_62">äh  </event>
<event start="TLI_62" end="TLI_63">ist</event>
<event start="TLI_63" end="TLI_64">(0.36) </event>
<event start="TLI_64" end="TLI_65">Gut ist, </event>
<event start="TLI_65" end="TLI_66">(0.88) </event>
<event start="TLI_66" end="TLI_67">und </event>
<event start="TLI_67" end="TLI_68">(0.19) </event>
<event start="TLI_68" end="TLI_69">da hab ich </event>
<event start="TLI_69" end="TLI_70">(0.15) </event>
<event start="TLI_70" end="TLI_71">mich den Winter </event>
<event start="TLI_71" end="TLI_72">(0.31) </event>
<event start="TLI_72" end="TLI_73">nach Goldhausen vermietet. </event>
<event start="TLI_73" end="TLI_74">(2.01) </event>
<event start="TLI_74" end="TLI_75">Und bin da auch ein Jahr gewesen. </event>
<event start="TLI_75" end="TLI_76">Aber da hat es mir nicht so gut gefallen. </event>
<event start="TLI_76" end="TLI_77">(1.11) </event>
<event start="TLI_77" end="TLI_78">Da hab ich bloß ein Jahr gemacht. </event>
<event start="TLI_78" end="TLI_79">(1.47) </event>
<event start="TLI_81" end="TLI_82">War schlechte Kost und da- |</event>
<event start="TLI_84" end="TLI_85">Weil da manches mir nicht gefiel. </event>
<event start="TLI_85" end="TLI_86">(1.32) </event>
<event start="TLI_86" end="TLI_87"><![CDATA[Die Lebensmittel waren nicht mal > ]]></event>
<event start="TLI_87" end="TLI_88">(0.25) </event>
<event start="TLI_88" end="TLI_89">nicht so gut. </event>
<event start="TLI_89" end="TLI_90">(0.96) </event>
<event start="TLI_90" end="TLI_91">Und übrigens </event>
<event start="TLI_91" end="TLI_92">(0.28) </event>
<event start="TLI_92" end="TLI_93">der Mann, </event>
<event start="TLI_93" end="TLI_94">der trank sich immer einen und dann gab es Krawall! </event>
<event start="TLI_94" end="TLI_95">(0.66) </event>
<event start="TLI_95" end="TLI_96">Da hab ich gedacht: </event>
<event start="TLI_96" end="TLI_97">hier bleibst du nicht. </event>
<event start="TLI_97" end="TLI_98">(1.26) </event>
<event start="TLI_98" end="TLI_99">Und da hab ich mich vermietet </event>
<event start="TLI_99" end="TLI_100">(0.75) </event>
<event start="TLI_100" end="TLI_101">nach Nordenbeck, </event>
<event start="TLI_101" end="TLI_102">bei den Bürgermeister Göbel. </event>
<event start="TLI_102" end="TLI_103">(1.11) </event>
<event start="TLI_103" end="TLI_104">Da bin ich </event>
<event start="TLI_104" end="TLI_105">(0.42) </event>
<event start="TLI_105" end="TLI_106">drei Jahre gewesen. </event>
<event start="TLI_106" end="TLI_107">(2.26) </event>
<event start="TLI_107" end="TLI_108">Und von da wollte ich mich mal verändern. </event>
<event start="TLI_108" end="TLI_109">(1.11) </event>
<event start="TLI_109" end="TLI_110">Da bin ich nach </event>
<event start="TLI_110" end="TLI_111">(0.51) </event>
<event start="TLI_111" end="TLI_112">Langenbach im Rheinlande </event>
<event start="TLI_112" end="TLI_113">(1.06) </event>
<event start="TLI_113" end="TLI_114">gekommen. </event>
<event start="TLI_114" end="TLI_115">(1.02) </event>
<event start="TLI_115" end="TLI_116">In Richrath- </event>
<event start="TLI_116" end="TLI_117">das war vor Langenberg </event>
<event start="TLI_117" end="TLI_118">(0.49) </event>
<event start="TLI_118" end="TLI_119">bei'n Bauern- </event>
<event start="TLI_119" end="TLI_120">(0.16) </event>
<event start="TLI_120" end="TLI_121">und da bin ich so </event>
<event start="TLI_121" end="TLI_122">(0.3) </event>
<event start="TLI_122" end="TLI_123">ungefähr anderthalb Jahr gewesen. </event>
<event start="TLI_123" end="TLI_124">(0.54) </event>
<event start="TLI_124" end="TLI_125">Und da bin ich nach- </event>
<event start="TLI_125" end="TLI_126"><![CDATA[von der andern Zeit bis > ]]></event>
<event start="TLI_126" end="TLI_127">(1.29) </event>
<event start="TLI_127" end="TLI_128"><![CDATA[bei > in Langenbach beim Fuhrunternehmer gewesen. ]]></event>
<event start="TLI_128" end="TLI_129">(1.77) </event>
<event start="TLI_129" end="TLI_130">Und da kam meine Soldatenzeit herbei. </event>
<event start="TLI_130" end="TLI_131">Mußt ich auf die Musterung </event>
<event start="TLI_131" end="TLI_132">(0.63) </event>
<event start="TLI_132" end="TLI_133">nach Korbach. </event>
<event start="TLI_133" end="TLI_134">(0.87) </event>
<event start="TLI_134" end="TLI_135">Und da kam ich bei die Dreiundachziger </event>
<event start="TLI_135" end="TLI_136">(0.21) </event>
<event start="TLI_136" end="TLI_137">nach Arolsen.</event>
<event start="TLI_137" end="TLI_138">(0.2)</event>
<event start="TLI_138" end="TLI_139"><![CDATA[Und die > ]]></event>
<event start="TLI_139" end="TLI_140">(0.95) </event>
<event start="TLI_140" end="TLI_141">während meiner Dienstzeit in Arolsen, </event>
<event start="TLI_141" end="TLI_142">da starb meine Mutter. </event>
<event start="TLI_142" end="TLI_143">(1.66) </event>
<event start="TLI_143" end="TLI_144">Und da war mein Vater alleine </event>
<event start="TLI_144" end="TLI_145">(0.44) </event>
<event start="TLI_145" end="TLI_146">mit meinem jüngsten Bruder. </event>
<event start="TLI_146" end="TLI_147">(0.54) </event>
<event start="TLI_147" end="TLI_148"><![CDATA[Und da mußte ich > ]]></event>
<event start="TLI_148" end="TLI_149">(1.53) </event>
<event start="TLI_149" end="TLI_150">da hatten sie reklamiert, </event>
<event start="TLI_150" end="TLI_151">aber das war nicht genügend. </event>
<event start="TLI_151" end="TLI_152">Sie ließen mich nicht los. </event>
<event start="TLI_152" end="TLI_153">(0.66) </event>
<event start="TLI_153" end="TLI_154">Und</event>
<event start="TLI_154" end="TLI_155">(0.9) </event>
<event start="TLI_155" end="TLI_156">Und da hab ich meine beiden Jahre da </event>
<event start="TLI_156" end="TLI_157">(0.43) </event>
<event start="TLI_157" end="TLI_158">abgedient. </event>
<event start="TLI_158" end="TLI_159">(0.72) </event>
<event start="TLI_159" end="TLI_160"><![CDATA[Und bin dann in neunzehnhundert > , ]]></event>
<event start="TLI_160" end="TLI_161">(0.88) </event>
<event start="TLI_161" end="TLI_162"><![CDATA[> neunundneunzig > , > achtzehnhundertneunundneunzig > nach heim gekommen. ]]></event>
<event start="TLI_162" end="TLI_163">(1.2) </event>
<event start="TLI_163" end="TLI_164">Da hab ich das Frühjahr </event>
<event start="TLI_164" end="TLI_165">(2.1) </event>
<event start="TLI_165" end="TLI_166">mir 'n Mädchen genommen, </event>
