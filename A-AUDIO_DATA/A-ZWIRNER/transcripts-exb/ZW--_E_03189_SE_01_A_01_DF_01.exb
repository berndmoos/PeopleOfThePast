<event start="TLI_315" end="TLI_316">(0.33) </event>
<event start="TLI_316" end="TLI_317">det Frohjoahr! </event>
<event start="TLI_317" end="TLI_318">(2.76) </event>
<event start="TLI_318" end="TLI_319">de Wintr si ik in en Holzwald gegangen, </event>
