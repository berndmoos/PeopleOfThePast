<tier id="TIE0" speaker="S2" category="lit" type="a" display-name="S2 [lit]"><event start="TLI_1" end="TLI_2">(0.91) </event>
<event start="TLI_2" end="TLI_3">det Fröijahr woar t erste erstmol, </event>
<event start="TLI_3" end="TLI_4">die erste Awet die is, </event>
<event start="TLI_4" end="TLI_5">do wird dat Korn gestrowet un de Weizen wird gestrowet. </event>
<event start="TLI_5" end="TLI_6">(0.31) </event>
<event start="TLI_6" end="TLI_7">soballe wie de Frost ut en </event>
<event start="TLI_7" end="TLI_8">(0.37) </event>
<event start="TLI_8" end="TLI_9">Längern rute is, </event>
<event start="TLI_9" end="TLI_10">(0.24) </event>
<event start="TLI_10" end="TLI_11">un mer so eben iber t Land gon kann, </event>
<event start="TLI_11" end="TLI_12">(0.22) </event>
<event start="TLI_12" end="TLI_13">dat mer nit drinne stecken bliwet, </event>
<event start="TLI_13" end="TLI_14">dann fänget mer an zu strowen. </event>
<event start="TLI_14" end="TLI_15">(0.45) </event>
<event start="TLI_15" end="TLI_16">die enen </event>
<event start="TLI_16" end="TLI_17">(0.58) </event>
<event start="TLI_17" end="TLI_18">die meinen nu, </event>
<event start="TLI_18" end="TLI_19">se müssten immer stowen un strowen Volldünger oder wie se </event>
<event start="TLI_19" end="TLI_20">wat et nit so alle gibt </event>
<event start="TLI_20" end="TLI_21">(0.48) </event>
<event start="TLI_21" end="TLI_22">un strowen richta feste. </event>
<event start="TLI_22" end="TLI_23">die andern, </event>
<event start="TLI_23" end="TLI_24">die hänn de Tid un strowen erst ma wenner </event>
<event start="TLI_24" end="TLI_25">(0.36) </event>
<event start="TLI_25" end="TLI_26">un dann hinge no </event>
<event start="TLI_26" end="TLI_27">wann se merken, </event>
<event start="TLI_27" end="TLI_28">dat et nit so recht will, </event>
<event start="TLI_28" end="TLI_29">(0.34) </event>
<event start="TLI_29" end="TLI_30">dann, </event>
<event start="TLI_30" end="TLI_31">(0.37) </event>
<event start="TLI_31" end="TLI_32">giw et no ma sou </event>
<event start="TLI_32" end="TLI_33">(0.27) </event>
<event start="TLI_33" end="TLI_34">wat up em Kopp. </event>
<event start="TLI_34" end="TLI_35">(1.98) </event>
<event start="TLI_35" end="TLI_36">dat nächste is dann, </event>
<event start="TLI_36" end="TLI_37">soballe wie de Felder </event>
<event start="TLI_37" end="TLI_38">(0.93) </event>
<event start="TLI_38" end="TLI_39">trügge sin, </event>
<event start="TLI_39" end="TLI_40">dat ma an zu schleppen fänget un dann gait dat </event>
<event start="TLI_40" end="TLI_41">(0.21) </event>
<event start="TLI_41" end="TLI_43">de Säggerigge laus. </event>
<event start="TLI_43" end="TLI_44">(0.4) </event>
<event start="TLI_44" end="TLI_45">jetzt is et ja forchbar einfach, </event>
<event start="TLI_45" end="TLI_46">(0.85) </event>
<event start="TLI_46" end="TLI_47">sus immert, </event>
<event start="TLI_47" end="TLI_48">da muss mer sik mit de Küken darüme quällen. </event>
<event start="TLI_48" end="TLI_49">grade bi uns kleinen Lüden; </event>
<event start="TLI_49" end="TLI_50">(0.57) </event>
<event start="TLI_50" end="TLI_51">aber jetz hänn sie ge balle all en Trecker </event>
<event start="TLI_51" end="TLI_52">(0.51) </event>
<event start="TLI_52" end="TLI_53">un do gai et sehr schnell. </event>
<event start="TLI_53" end="TLI_54">(1.84) </event>
<event start="TLI_54" end="TLI_55">do dur et gar nit lange, </event>
<event start="TLI_55" end="TLI_56">(0.15) </event>
<event start="TLI_56" end="TLI_57">do werd scho widder geecht un am Obend wird no mo geecht un n annern Dach wird gesägget un schon </event>
<event start="TLI_57" end="TLI_58">(0.4) </event>
<event start="TLI_58" end="TLI_59">is der Haver drinne. </event>
<event start="TLI_59" end="TLI_60">(1.42) </event>
<event start="TLI_60" end="TLI_61">dann gait et widder </event>
<event start="TLI_61" end="TLI_62">(1.78) </event>
<event start="TLI_62" end="TLI_63">an die Tufelen. </event>
<event start="TLI_63" end="TLI_64">dann wern die Tufelen geplantet. </event>
<event start="TLI_64" end="TLI_65">(0.3) </event>
<event start="TLI_65" end="TLI_66">fröjer do woarn se immer </event>
<event start="TLI_66" end="TLI_67">(0.84) </event>
<event start="TLI_67" end="TLI_68">dann wurd die ganze Mist im Winter </event>
<event start="TLI_68" end="TLI_69">(0.75) </event>
<event start="TLI_69" end="TLI_70">daheime behaldn </event>
<event start="TLI_70" end="TLI_71">(0.48) </event>
<event start="TLI_71" end="TLI_72">un dann wuard acht Tage lang Mist gefahrn. </event>
<event start="TLI_72" end="TLI_73">(0.45) </event>
<event start="TLI_73" end="TLI_74">dann musste gestruwet wern, </event>
<event start="TLI_74" end="TLI_75">(0.45) </event>
<event start="TLI_75" end="TLI_76">un dann wur geplantet, </event>
<event start="TLI_76" end="TLI_77">hinger m Plauge her. </event>
<event start="TLI_77" end="TLI_78">(0.15) </event>
<event start="TLI_78" end="TLI_79">awer </event>
<event start="TLI_79" end="TLI_80">(0.36) </event>
<event start="TLI_80" end="TLI_81">dat giw et ja hüde auch ni meh. </event>
<event start="TLI_81" end="TLI_82">do wird im Winter </event>
<event start="TLI_82" end="TLI_83">(0.45) </event>
<event start="TLI_83" end="TLI_84">un wann s eben möchlig is, </event>
<event start="TLI_84" end="TLI_85">dat ener mit m Trecker debuten dur de Feldwege dür kann, </event>
<event start="TLI_85" end="TLI_86">(0.27) </event>
<event start="TLI_86" end="TLI_87">dann wird Mist gefahren. </event>
<event start="TLI_87" end="TLI_88">(0.39) </event>
<event start="TLI_88" end="TLI_89">un dodür wern ja auch vill de Feldwege kaputt gefahren. </event>
<event start="TLI_89" end="TLI_90">besonders disse letzten Johre, </event>
<event start="TLI_90" end="TLI_91">(0.33) </event>
<event start="TLI_91" end="TLI_92">weil t immer so vill geregget hät, </event>
<event start="TLI_92" end="TLI_93">(0.36) </event>
<event start="TLI_93" end="TLI_94">sin die Feldwege vill kabutt gefahren. </event>
<event start="TLI_94" end="TLI_95">(0.96) </event>
<event start="TLI_95" end="TLI_96">also die Mist is dann fröjer wird dann no mo </event>
<event start="TLI_96" end="TLI_97">wat die letzten Weken angefallen is, </event>
<event start="TLI_97" end="TLI_98">dat wird no ruter gefahren, </event>
<event start="TLI_98" end="TLI_99">(0.87) </event>
<event start="TLI_99" end="TLI_100">un dann </event>
<event start="TLI_100" end="TLI_101">(0.36) </event>
<event start="TLI_101" end="TLI_102">wann auch </event>
<event start="TLI_102" end="TLI_103">(0.63) </event>
<event start="TLI_103" end="TLI_104">diese Tufelinger Toge sin, </event>
<event start="TLI_104" end="TLI_105">dann wern die Tufeln geplantet. </event>
<event start="TLI_105" end="TLI_106">un die weren jetz mit so m Vielfachgerät </event>
<event start="TLI_106" end="TLI_107">(0.33) </event>
<event start="TLI_107" end="TLI_108">geplantet. </event>
<event start="TLI_108" end="TLI_109">(0.45) </event>
<event start="TLI_109" end="TLI_110">dat wird ers schön terechte gemacht. </event>
<event start="TLI_110" end="TLI_111">de Kunstdünger wird womöchlich glich detau gestrowet. </event>
<event start="TLI_111" end="TLI_112">(0.34) </event>
<event start="TLI_112" end="TLI_113">dann were Löcher gemacht, </event>
<event start="TLI_113" end="TLI_114">un dann gait mer ganz bequem </event>
<event start="TLI_114" end="TLI_115">(0.27) </event>
<event start="TLI_115" end="TLI_116">hät mer ne Schörte fer sik hangen voll Tufelen </event>
<event start="TLI_116" end="TLI_117">(0.85) </event>
<event start="TLI_117" end="TLI_118">gait die Fürjen entlang un schmit dann in jede Loch seine Tufel rin tritt mit dem Faute dup </event>
<event start="TLI_118" end="TLI_119">(0.37) </event>
<event start="TLI_119" end="TLI_120">un dann wern se hinge no tau gemacht </event>
<event start="TLI_120" end="TLI_121">(1.92) </event>
<event start="TLI_121" end="TLI_122">mit dem selben Geräte un schon sin au die Tufeln geplantet. </event>
<event start="TLI_122" end="TLI_123">et nächste is </event>
<event start="TLI_123" end="TLI_124">(0.51) </event>
<event start="TLI_124" end="TLI_125">dann die Dickwortelnkerne. </event>
<event start="TLI_125" end="TLI_126">(0.48) </event>
<event start="TLI_126" end="TLI_127">die wern jo alle wie fröjer auch mit de Maschine gelecht. </event>
<event start="TLI_127" end="TLI_128">fröjer do hat ma noch kene Druckrollen. </event>
<event start="TLI_128" end="TLI_129">hüde </event>
<event start="TLI_129" end="TLI_130">(0.37) </event>
<event start="TLI_130" end="TLI_131">sin Druckrollen dranne, </event>
<event start="TLI_131" end="TLI_132">damide dat se schön tau kummen; </event>
<event start="TLI_132" end="TLI_133">(1.24) </event>
<event start="TLI_133" end="TLI_134">un </event>
<event start="TLI_134" end="TLI_135">(0.97) </event>
<event start="TLI_135" end="TLI_136">besonders düt Joahr, </event>
<event start="TLI_136" end="TLI_137">(0.37) </event>
<event start="TLI_137" end="TLI_138">do ging dat alles schnell vonstatten. </event>
<event start="TLI_138" end="TLI_139">(0.93) </event>
<event start="TLI_139" end="TLI_140">awer </event>
<event start="TLI_140" end="TLI_141">(0.66) </event>
<event start="TLI_141" end="TLI_142">noher, </event>
<event start="TLI_142" end="TLI_143">wie mer fetach woarn, </event>
<event start="TLI_143" end="TLI_144">do dachte mer et gäv ma düchter rägen, </event>
<event start="TLI_144" end="TLI_145">aber der Rägen bliffde ute; </event>
<event start="TLI_145" end="TLI_146">(0.42) </event>
<event start="TLI_146" end="TLI_147">un </event>
<event start="TLI_147" end="TLI_148">(2.46) </event>
<event start="TLI_148" end="TLI_149">de </event>
<event start="TLI_149" end="TLI_150">(0.37) </event>
<event start="TLI_150" end="TLI_151">Koan, </event>
<event start="TLI_151" end="TLI_152">dat wull nit so richdach </event>
<event start="TLI_152" end="TLI_153">(0.94) </event>
<event start="TLI_153" end="TLI_154">wassen, </event>
<event start="TLI_154" end="TLI_155">(0.43) </event>
<event start="TLI_155" end="TLI_156">un vor allen Dingen, </event>
<event start="TLI_156" end="TLI_157">(0.48) </event>
<event start="TLI_157" end="TLI_158">mir hadde viel Nachtfröchde, </event>
<event start="TLI_158" end="TLI_159">(0.48) </event>
<event start="TLI_159" end="TLI_160">un dat Gras uf de Wiasen wus auk nit so </event>
<event start="TLI_160" end="TLI_161">(0.37) </event>
<event start="TLI_161" end="TLI_162">wie süs de Johre. </event>
<event start="TLI_162" end="TLI_163">(1.47) </event>
<event start="TLI_163" end="TLI_164">et Wedder woar awer gutt, </event>
<event start="TLI_164" end="TLI_165">un mir fingen schon bitiden an Heu te maken. </event>
<event start="TLI_165" end="TLI_166">(0.57) </event>
<event start="TLI_166" end="TLI_167">un </event>
<event start="TLI_167" end="TLI_168">(0.72) </event>
<event start="TLI_168" end="TLI_169">mer hän in dissem Johre in acht Dagen fast det ganze Heu gemacht, </event>
<event start="TLI_169" end="TLI_170">wat mir süs woll </event>
<event start="TLI_170" end="TLI_171">(0.61) </event>
<event start="TLI_171" end="TLI_172">nit gemacht han. </event>
<event start="TLI_172" end="TLI_173">(1.15) </event>
<event start="TLI_173" end="TLI_174">vürges Joahr, </event>
<event start="TLI_174" end="TLI_175">ik gloibe, </event>
<event start="TLI_175" end="TLI_176">(0.39) </event>
<event start="TLI_176" end="TLI_177">wa ma do e Wache vull Heu han wull, </event>
<event start="TLI_177" end="TLI_178">(0.33) </event>
<event start="TLI_178" end="TLI_179">dann musste mer n am Mondach mäggen, </event>
<event start="TLI_179" end="TLI_180">(0.48) </event>
<event start="TLI_180" end="TLI_181">un wann man en dann en Sunnowend han wull, </event>
<event start="TLI_181" end="TLI_182">dann musst et gut gohn. </event>
<event start="TLI_182" end="TLI_183">(0.54) </event>
<event start="TLI_183" end="TLI_184">intgemein här et dann nach </event>
<event start="TLI_184" end="TLI_185">(0.33) </event>
<event start="TLI_185" end="TLI_186">äwer acht Dage gedurt, </event>
<event start="TLI_186" end="TLI_187">bis dat mer n esten Wagen hollen kunnt. </event>
<event start="TLI_187" end="TLI_188">dann dit Joahr woar t glau ümgekehrt, </event>
<event start="TLI_188" end="TLI_189">(0.15) </event>
<event start="TLI_189" end="TLI_190">do woar in ener Wek et ganze Heu gemacht. </event>
<event start="TLI_190" end="TLI_191">(1.45) </event>
<event start="TLI_191" end="TLI_192">Dickworteln worn dann gehacket, </event>
<event start="TLI_192" end="TLI_193">auch värrer woarn se scho mo gehacket. </event>
<event start="TLI_193" end="TLI_194">se woarn dit Johr, </event>
<event start="TLI_194" end="TLI_195">weil t nit so viel geregget hadde schlecht upgegonn, </event>
<event start="TLI_195" end="TLI_196">(0.4) </event>
<event start="TLI_196" end="TLI_197">un </event>
<event start="TLI_197" end="TLI_198">(0.79) </event>
<event start="TLI_198" end="TLI_199">mer </event>
<event start="TLI_199" end="TLI_200">wusste kaum, </event>
<event start="TLI_200" end="TLI_201">der Riegen te erkennen, </event>
<event start="TLI_201" end="TLI_202">(0.36) </event>
<event start="TLI_202" end="TLI_203">wo sie iwerhaupt stunn. </event>
<event start="TLI_203" end="TLI_204">(0.81) </event>
<event start="TLI_204" end="TLI_205">awer hinge no, </event>
<event start="TLI_205" end="TLI_206">(0.16) </event>
<event start="TLI_206" end="TLI_207">wie mer t Heu gemacht hatten, </event>
<event start="TLI_207" end="TLI_208">(0.54) </event>
<event start="TLI_208" end="TLI_209">do fing et auch </event>
<event start="TLI_209" end="TLI_210">(0.18) </event>
<event start="TLI_210" end="TLI_211">an te reggen, </event>
<event start="TLI_211" end="TLI_212">un de hen sik auch die Dickworteln un auch die Winterfrucht hat sich noch ganz gut gemacht. </event>
<event start="TLI_212" end="TLI_213">(0.63) </event>
<event start="TLI_213" end="TLI_214">un äh mir könn im Groten un Ganzen tefräjden sin, </event>
<event start="TLI_214" end="TLI_215">(0.91) </event>
<event start="TLI_215" end="TLI_216">denn äh </event>
<event start="TLI_216" end="TLI_217">(0.25) </event>
<event start="TLI_217" end="TLI_218">mi maken dit Joahr noch ne ganz gute Arne. </event>
<event start="TLI_218" end="TLI_219">(0.63) </event>
<event start="TLI_219" end="TLI_220">fürges Joahr, </event>
<event start="TLI_220" end="TLI_221">do hadde mer </event>
<event start="TLI_221" end="TLI_222">(1.77) </event>
<event start="TLI_222" end="TLI_223">nicht so ne gute Arne, </event>
<event start="TLI_223" end="TLI_224">weil et am einendriesten Mai </event>
<event start="TLI_224" end="TLI_225">(0.67) </event>
<event start="TLI_225" end="TLI_226">äh hagelde hie in de Gemarkung. </event>
<event start="TLI_226" end="TLI_227">un ik habe dat min Leben no nicht erlewet. </event>
<event start="TLI_227" end="TLI_228">(0.37) </event>
<event start="TLI_228" end="TLI_229">min Vatter vertellt, </event>
<event start="TLI_229" end="TLI_230">hie hätt et die letzten mole gehachelt: </event>
<event start="TLI_230" end="TLI_231">(0.43) </event>
<event start="TLI_231" end="TLI_232">achtehnhunnertfivenneunzich </event>
<event start="TLI_232" end="TLI_233">(0.78) </event>
<event start="TLI_233" end="TLI_234">un die meisten die hatten deswejgen auch nicht versikert. </event>
<event start="TLI_234" end="TLI_235">(0.78) </event>
<event start="TLI_235" end="TLI_236">die alden Lüde sachten immer: </event>
<event start="TLI_236" end="TLI_237">hie hagel et so schnell nit.  </event>
<event start="TLI_237" end="TLI_238">(0.45) </event>
<event start="TLI_238" end="TLI_239">denn äh </event>
<event start="TLI_239" end="TLI_240">(0.61) </event>
<event start="TLI_240" end="TLI_241">mir hen up de enen Side, </event>
<event start="TLI_241" end="TLI_242">hen mer die Edertalsperre, </event>
<event start="TLI_242" end="TLI_243">die tehen die Gewitter an, </event>
<event start="TLI_243" end="TLI_244">(0.28) </event>
<event start="TLI_244" end="TLI_245">owen in Upplande da höm mer die Diemeltalsperre. </event>
<event start="TLI_245" end="TLI_246">(0.69) </event>
<event start="TLI_246" end="TLI_247">un do wird immer vunne gesacht: </event>
<event start="TLI_247" end="TLI_248">de tehen die Gewitter an. </event>
<event start="TLI_248" end="TLI_249">(0.67) </event>
<event start="TLI_249" end="TLI_250">awer </event>
<event start="TLI_250" end="TLI_251">(0.81) </event>
<event start="TLI_251" end="TLI_252">vürges Joahr woar t ümgekehrt, </event>
<event start="TLI_252" end="TLI_253">do kam en Gewitter von hunnen op un dat stutt hier oben verm Isenberch un konnte nit dribber wechen, </event>
<event start="TLI_253" end="TLI_254">(0.25) </event>
<event start="TLI_254" end="TLI_255">un do </event>
<event start="TLI_255" end="TLI_256">(0.16) </event>
<event start="TLI_256" end="TLI_257">hadde mer die graute Bescherung. </event>
<event start="TLI_257" end="TLI_258">(0.39) </event>
<event start="TLI_258" end="TLI_259">un da hätt et dermaßen gehagelt, </event>
<event start="TLI_259" end="TLI_260">(0.55) </event>
<event start="TLI_260" end="TLI_261">dat mi kaum noch äh </event>
<event start="TLI_261" end="TLI_262">(0.25) </event>
<event start="TLI_262" end="TLI_263">unser Brotfrucht oder </event>
<event start="TLI_263" end="TLI_264">(0.67) </event>
<event start="TLI_264" end="TLI_265">un auch noch unser Kor ter Soot hadden. </event>
<event start="TLI_265" end="TLI_266">(0.48) </event>
<event start="TLI_266" end="TLI_267">allerdings nit die ganze Germarkunge, </event>
<event start="TLI_267" end="TLI_268">sundern </event>
<event start="TLI_268" end="TLI_269">(0.28) </event>
<event start="TLI_269" end="TLI_270">blouß die Hälfte, </event>
<event start="TLI_270" end="TLI_271">(0.48) </event>
<event start="TLI_271" end="TLI_272">die hadde wat middegekricht. </event>
<event start="TLI_272" end="TLI_273">(2.28) </event>
<event start="TLI_273" end="TLI_274">deswegen sin mer dit Johr frauh, </event>
<event start="TLI_274" end="TLI_275">dat dat ma nich der Fall is. </event>
<event start="TLI_275" end="TLI_276">un </event>
<event start="TLI_276" end="TLI_277">(0.21) </event>
<event start="TLI_277" end="TLI_278">wann t auk jetz mo widder warme wird, </event>
<event start="TLI_278" end="TLI_279">mir würn gerne schwaiten, </event>
<event start="TLI_279" end="TLI_280">denn mer sin frauh, </event>
<event start="TLI_280" end="TLI_281">dat mer dit Joahr mo wirrer en Bansen Korn han, </event>
<event start="TLI_281" end="TLI_282">(0.52) </event>
<event start="TLI_282" end="TLI_283">un dat mer mo maschine können, </event>
<event start="TLI_283" end="TLI_284">(0.28) </event>
<event start="TLI_284" end="TLI_285">un dat vor allen Dingen die Schuld, </event>
<event start="TLI_285" end="TLI_286">dur den Kunstdünger, </event>
<event start="TLI_286" end="TLI_287">den mer up dem Kornhuse han, </event>
<event start="TLI_287" end="TLI_288">(0.6) </event>
<event start="TLI_288" end="TLI_289">dat der dit Joahr mo von der Latte vonne kümmet. </event>
<event start="TLI_289" end="TLI_290">süs äh maket et ken Spass meh. </event>
<event start="TLI_290" end="TLI_291">(0.82) </event>
<event start="TLI_291" end="TLI_292">denn äh </event>
<event start="TLI_292" end="TLI_293">(1.0) </event>
<event start="TLI_293" end="TLI_294">mut mer Zinsen bezahlen un et kümmet jeres Joahr debie, un </event>
<event start="TLI_294" end="TLI_295">(0.21) </event>
<event start="TLI_295" end="TLI_296">et is jo sou, </event>
<event start="TLI_296" end="TLI_297">wa mer ken Kunstdünger struwet, </event>
<event start="TLI_297" end="TLI_298">dann hat mer ja auch nix. </event>
<event start="TLI_298" end="TLI_299">(3.75) </event>
<event start="TLI_301" end="TLI_302">so, </event>
<event start="TLI_302" end="TLI_303">jetz soll ik mo wat vertäle von dem Dorfgemeinschaftshaus. </event>
<event start="TLI_303" end="TLI_304">(2.43) </event>
<event start="TLI_304" end="TLI_305">vürges Joahr </event>
<event start="TLI_305" end="TLI_306">(0.36) </event>
<event start="TLI_306" end="TLI_307">mir hatten hie in de Gemeinde nit ver, </event>
<event start="TLI_307" end="TLI_308">en Dorfgemeinschaftshus te buggen, </event>
<event start="TLI_308" end="TLI_309">sundern ik hotte mo vor Joahrn ente gesehn up so ner Besichtijungsfahrt, </event>
<event start="TLI_309" end="TLI_310">un do hab ik gedacht, </event>
<event start="TLI_310" end="TLI_311">wann de jetz in die Gemeinde kümmes un wit </event>
<event start="TLI_311" end="TLI_312">(0.22) </event>
<event start="TLI_312" end="TLI_313">do vertäle wüllten auk en Dorfgemeinschaftshus buggen, </event>
<event start="TLI_313" end="TLI_314">(0.33) </event>
<event start="TLI_314" end="TLI_315">dann sägen die: </event>
<event start="TLI_315" end="TLI_316">glowe du bis verrückt!, </event>
<event start="TLI_316" end="TLI_317">(0.4) </event>
<event start="TLI_317" end="TLI_318">denn mir hen die ganze Joahr schun sou vill gemach. </event>
<event start="TLI_318" end="TLI_319">mir hen de Waterleitung gemacht un Strote gebugget </event>
<event start="TLI_319" end="TLI_320">(0.28) </event>
<event start="TLI_320" end="TLI_321">un wann de jetz aach noch mit solchen Plänen ankimmest, </event>
<event start="TLI_321" end="TLI_322">dann äh </event>
<event start="TLI_322" end="TLI_323">(0.46) </event>
<event start="TLI_323" end="TLI_324">dann sägen die die: </event>
<event start="TLI_324" end="TLI_325">t wird Tid, </event>
<event start="TLI_325" end="TLI_326">dat mer den bal in Äs treden, </event>
<event start="TLI_326" end="TLI_327">die macht uns bald tu viel dodrinne rümme.  </event>
<event start="TLI_327" end="TLI_328">(0.36) </event>
<event start="TLI_328" end="TLI_329">un da hab ik gedacht: </event>
<event start="TLI_329" end="TLI_330">mir wüllten so ne Gefrieranlage buggen, </event>
<event start="TLI_330" end="TLI_331">(0.3) </event>
<event start="TLI_331" end="TLI_332">denn äh </event>
<event start="TLI_332" end="TLI_333">(1.5) </event>
<event start="TLI_333" end="TLI_334">in Herbes is et sou, </event>
<event start="TLI_334" end="TLI_335">(0.24) </event>
<event start="TLI_335" end="TLI_336">besundas wenn t balle nix mehr up de Raukkammer gibt un ma kann no nit schlachten, </event>
<event start="TLI_336" end="TLI_337">(0.3) </event>
<event start="TLI_337" end="TLI_338">dann hätt mer gerne wat frischket. </event>
<event start="TLI_338" end="TLI_339">(0.52) </event>
<event start="TLI_339" end="TLI_340">un </event>
<event start="TLI_340" end="TLI_341">(0.42) </event>
<event start="TLI_341" end="TLI_342">in Herbest is grade die meiste Arwet, </event>
<event start="TLI_342" end="TLI_343">do wird maschint, </event>
<event start="TLI_343" end="TLI_344">(0.97) </event>
<event start="TLI_344" end="TLI_345">do wird maschint, </event>
<event start="TLI_345" end="TLI_346">un do mut </event>
<event start="TLI_346" end="TLI_347">(0.18) </event>
<event start="TLI_347" end="TLI_348">Fleisch gekoft wern, </event>
<event start="TLI_348" end="TLI_349">und we mer hüde no Metzger mut, </event>
<event start="TLI_349" end="TLI_350">(1.03) </event>
<event start="TLI_350" end="TLI_351">bi maschine wün die Lüde auch ni mehr den gelwen Speck eten, </event>
<event start="TLI_351" end="TLI_352">(0.33) </event>
<event start="TLI_352" end="TLI_353">da wülln se gerne sou wat  </event>
<event start="TLI_353" end="TLI_354">(0.31) </event>
<event start="TLI_354" end="TLI_355">wat Betteres han. </event>
<event start="TLI_355" end="TLI_356">(0.24) </event>
<event start="TLI_356" end="TLI_357">un da wur immer Fleisch gekoft un dat koste gesmol ne Ge/ echte Stange Geld. </event>
<event start="TLI_357" end="TLI_358">(0.39) </event>
<event start="TLI_358" end="TLI_359">un da hab ik gedacht; </event>
<event start="TLI_359" end="TLI_360">(0.72) </event>
<event start="TLI_360" end="TLI_361">et Frojoahr, </event>
<event start="TLI_361" end="TLI_362">wann so de Sukke billach sin, </event>
<event start="TLI_362" end="TLI_363">(0.81) </event>
<event start="TLI_363" end="TLI_364">dann könnt ma dann emal schlachten und könnte dann </event>
<event start="TLI_364" end="TLI_365">disse </event>
<event start="TLI_365" end="TLI_366">(0.64) </event>
<event start="TLI_366" end="TLI_367">Fleisch in e Ge/ in so ne Gefrieranlage bringen, </event>
<event start="TLI_367" end="TLI_368">un mer hädde dann te jeder Tid te jeder Festlikkeit oder wann süs wat wür, </event>
<event start="TLI_368" end="TLI_369">(0.22) </event>
<event start="TLI_369" end="TLI_370">hädde mer schön frisch Fleisch. </event>
<event start="TLI_370" end="TLI_371">(0.9) </event>
<event start="TLI_371" end="TLI_372">un da dadür hab ik dat de Gemeinde mo vertallt, </event>
<event start="TLI_372" end="TLI_373">un da hän se auch gesacht dat wär gar nit verkehrt. </event>
<event start="TLI_373" end="TLI_374">un ik dachte </event>
<event start="TLI_374" end="TLI_375">mir hadden hie </event>
<event start="TLI_375" end="TLI_376">(0.76) </event>
<event start="TLI_376" end="TLI_377">so n alt Gemeindehus </event>
<event start="TLI_377" end="TLI_378">und wir hatten do Platz ik dachte mir krächten die Gefrieranlage do </event>
<event start="TLI_378" end="TLI_379">könnt mer do inbuggen </event>
<event start="TLI_379" end="TLI_380">(0.31) </event>
<event start="TLI_380" end="TLI_381">un ik glovte, </event>
<event start="TLI_381" end="TLI_382">(0.73) </event>
<event start="TLI_382" end="TLI_383">mir krichten auch fer diese Gefrieranlage von dem Lande Hessen </event>
<event start="TLI_383" end="TLI_384">(0.7) </event>
<event start="TLI_384" end="TLI_385">ge/ genausoviel Zuschuss, </event>
<event start="TLI_385" end="TLI_386">als we mer en Dorfgemeinschaftshus buggen. </event>
<event start="TLI_386" end="TLI_387">awer wie die Herrns von der Land- </event>
<event start="TLI_387" end="TLI_388">un Forstwirtschaftskammer kamen, </event>
<event start="TLI_388" end="TLI_389">(0.36) </event>
<event start="TLI_389" end="TLI_390">un sik det Gebügge ansohen, </event>
<event start="TLI_390" end="TLI_391">do hän se mir gesacht: </event>
<event start="TLI_391" end="TLI_393">nee, dat gait nit, </event>
<event start="TLI_393" end="TLI_394">(0.7) </event>
<event start="TLI_394" end="TLI_395">do gewwe di/</event>
<event start="TLI_395" end="TLI_396">(0.49) </event>
<event start="TLI_396" end="TLI_397">könn mir och ken Zuschuss dann gean, </event>
<event start="TLI_397" end="TLI_398">sondern nur en Darlehn, </event>
<event start="TLI_398" end="TLI_399">(0.24) </event>
<event start="TLI_399" end="TLI_400">un die ganze Anlage die kostet uch dann in der twintachtausend Mark", </event>
<event start="TLI_400" end="TLI_401">(0.72) </event>
<event start="TLI_401" end="TLI_402">un do is dieser Plan wirrer fallen gelossen. </event>
<event start="TLI_402" end="TLI_403">(0.64) </event>
<event start="TLI_403" end="TLI_404">un dä hän die mir awer gesacht, </event>
<event start="TLI_404" end="TLI_405">wann mi en schöne Platz hädden, </event>
<event start="TLI_405" end="TLI_406">(1.03) </event>
<event start="TLI_406" end="TLI_407">un wann me düchter arweten, </event>
<event start="TLI_407" end="TLI_408">un dat sin mer ja der letztn Tide </event>
<event start="TLI_408" end="TLI_409">(0.37) </event>
<event start="TLI_409" end="TLI_410">Joahr immer gewonnt gewest, </event>
<event start="TLI_410" end="TLI_411">(0.63) </event>
<event start="TLI_411" end="TLI_412">dann äh könnten mir auch en Hus buggen, </event>
<event start="TLI_412" end="TLI_413">dann brüchten mer auch nit vill meh Geld up de Beine te bringen wie twintertausend Mark, </event>
<event start="TLI_413" end="TLI_414">mir müssten bloß düchter arweten. </event>
<event start="TLI_414" end="TLI_415">do si ik mit den Herrns up den Festplatz gegonn, </event>
<event start="TLI_415" end="TLI_416">(0.33) </event>
<event start="TLI_416" end="TLI_417">wo mer immer die f/ ge/ Feste gefiert hadden, </event>
<event start="TLI_417" end="TLI_418">is en schöne grauten Platz, </event>
<event start="TLI_418" end="TLI_419">de lieget fast mitten in Dorpe. </event>
<event start="TLI_419" end="TLI_420">(0.81) </event>
<event start="TLI_420" end="TLI_421">un do hen sie gesacht, </event>
<event start="TLI_421" end="TLI_422">dat wür die </event>
<event start="TLI_422" end="TLI_423">(0.31) </event>
<event start="TLI_423" end="TLI_424">dat wür en ganz schöne Platz. </event>
<event start="TLI_424" end="TLI_425">(0.67) </event>
<event start="TLI_425" end="TLI_426">un </event>
<event start="TLI_426" end="TLI_427">(1.06) </event>
<event start="TLI_427" end="TLI_428">do hab ik mo gesacht: </event>
<event start="TLI_428" end="TLI_430">got, wenn dat sou is, </event>
<event start="TLI_430" end="TLI_431">awer ik </event>
<event start="TLI_431" end="TLI_432">(1.16) </event>
<event start="TLI_432" end="TLI_433">troggede mi dem Brodn no nit so recht </event>
<event start="TLI_433" end="TLI_435">ik dachte, mi müssten noch vill meh betahlen, </event>
<event start="TLI_435" end="TLI_436">un do macht ik mi bange ver, </event>
<event start="TLI_436" end="TLI_437">awer </event>
<event start="TLI_437" end="TLI_438">(0.37) </event>
<event start="TLI_438" end="TLI_439">up de andern Side hab ik gedacht, </event>
<event start="TLI_439" end="TLI_440">t wird jet ers mo verseuken, </event>
<event start="TLI_440" end="TLI_441">(0.61) </event>
<event start="TLI_441" end="TLI_442">un da häm mer mit den Herrns in Kassel geschwatzet, </event>
<event start="TLI_442" end="TLI_443">un </event>
<event start="TLI_443" end="TLI_444">(0.45) </event>
<event start="TLI_444" end="TLI_445">do </event>
<event start="TLI_445" end="TLI_446">(0.72) </event>
<event start="TLI_446" end="TLI_447">anschlietend kamen die von Wissbaden, </event>
<event start="TLI_447" end="TLI_448">(0.63) </event>
<event start="TLI_448" end="TLI_449">un da häm mer denen vertahlt wat mer so </event>
<event start="TLI_449" end="TLI_450">(1.14) </event>
<event start="TLI_450" end="TLI_451">in Johre sou up de Beine bringen, </event>
<event start="TLI_451" end="TLI_452">hab ik eima gesacht, </event>
<event start="TLI_452" end="TLI_453">dat könnte höchstens </event>
<event start="TLI_453" end="TLI_454">(0.25) </event>
<event start="TLI_454" end="TLI_455">siwentausend Mark sin, </event>
<event start="TLI_455" end="TLI_456">dat wörn dann in twei Johre </event>
<event start="TLI_456" end="TLI_457">(0.57) </event>
<event start="TLI_457" end="TLI_458">äh värtehn- </event>
<event start="TLI_458" end="TLI_459">oder fieftehndausen Mark un meh ging unmöchlik, </event>
<event start="TLI_459" end="TLI_460">un do hen sie gesacht: </event>
<event start="TLI_460" end="TLI_461">got wenn er t  </event>
<event start="TLI_461" end="TLI_462">(0.57) </event>
<event start="TLI_462" end="TLI_463">trotzdem äh, </event>
<event start="TLI_463" end="TLI_464">wollt, würden se uns auk helpen, </event>
<event start="TLI_464" end="TLI_465">(0.9) </event>
<event start="TLI_465" end="TLI_466">un so is et dann doch gelungen, </event>
<event start="TLI_466" end="TLI_467">dat mer </event>
<event start="TLI_467" end="TLI_468">(1.0) </event>
<event start="TLI_468" end="TLI_469">tau den Huse gekummen sin, </event>
<event start="TLI_469" end="TLI_470">et is ja no nit ganz fedäch, </event>
<event start="TLI_470" end="TLI_471">(0.51) </event>
<event start="TLI_471" end="TLI_472">awer </event>
<event start="TLI_472" end="TLI_473">(1.75) </event>
<event start="TLI_473" end="TLI_474">mi hänn s sou wiet fedä, </event>
<event start="TLI_474" end="TLI_475">dat mer am achten September die Einweihung fiern können. </event>
<event start="TLI_475" end="TLI_476">(0.93) </event>
<event start="TLI_476" end="TLI_477">dat ganze Hus soll nu kosten: </event>
<event start="TLI_477" end="TLI_478">hunnertsiebenendreijsichtausend Mark, </event>
<event start="TLI_478" end="TLI_479">un dovonne äh gibt uns dat Land Hessen, </event>
<event start="TLI_479" end="TLI_480">als Zuschuss siweneneunzechtausend Mark. </event>
<event start="TLI_480" end="TLI_481">de Kreis, </event>
<event start="TLI_481" end="TLI_482">de gibt fivtausend Mark, </event>
<event start="TLI_482" end="TLI_483">(0.46) </event>
<event start="TLI_483" end="TLI_484">mir bringen also fiftehntausen Mark noch in bar up </event>
<event start="TLI_484" end="TLI_485">(0.37) </event>
<event start="TLI_485" end="TLI_486">un mütten allerdings tehntausend Mark afferdenen </event>
<event start="TLI_486" end="TLI_487">(0.75) </event>
<event start="TLI_487" end="TLI_488">dür Arweten. </event>
<event start="TLI_488" end="TLI_489">un dat häm mer auch gemacht. </event>
<event start="TLI_489" end="TLI_490">de f/ letzte Winter de woar ge nit sou </event>
<event start="TLI_490" end="TLI_491">(0.28) </event>
<event start="TLI_491" end="TLI_492">kalt. </event>
<event start="TLI_492" end="TLI_493">(1.39) </event>
<event start="TLI_493" end="TLI_494">mir konnten do vill fahren </event>
<event start="TLI_494" end="TLI_495">(0.33) </event>
<event start="TLI_495" end="TLI_496">un </event>
<event start="TLI_496" end="TLI_497">(0.19) </event>
<event start="TLI_497" end="TLI_498">konnten auch vill arweten! </event>
<event start="TLI_498" end="TLI_499">(0.27) </event>
<event start="TLI_499" end="TLI_500">weil wer vill anfülle mussten </event>
<event start="TLI_500" end="TLI_501">(0.58) </event>
<event start="TLI_501" end="TLI_502">un do kumm mer ganz guat hinne, </event>
<event start="TLI_502" end="TLI_503">dat mer unse tehntausend Mark afferdiene können.</event>
<event start="TLI_503" end="TLI_504">(0.67) </event>
<event start="TLI_505" end="TLI_506">ente, </event>
<event start="TLI_506" end="TLI_507">twei, </event>
<event start="TLI_507" end="TLI_508">drej, </event>
<event start="TLI_508" end="TLI_509">(0.21) </event>
<event start="TLI_509" end="TLI_510">väre, </event>
<event start="TLI_510" end="TLI_511">five, </event>
<event start="TLI_511" end="TLI_512">sesse, </event>
<event start="TLI_512" end="TLI_513">siwene, </event>
<event start="TLI_513" end="TLI_514">(0.21) </event>
<event start="TLI_514" end="TLI_515">achte, </event>
<event start="TLI_515" end="TLI_516">nüggene, </event>
<event start="TLI_516" end="TLI_517">tehne. </event>
<event start="TLI_517" end="TLI_518">(0.79) </event>
<event start="TLI_518" end="TLI_519">Mondach, </event>
<event start="TLI_519" end="TLI_520">Dinsdach, </event>
<event start="TLI_520" end="TLI_521">Middeweken, </event>
<event start="TLI_521" end="TLI_522">Donnersdach, </event>
<event start="TLI_522" end="TLI_523">Friedach, </event>
<event start="TLI_523" end="TLI_524">Sunnowend, </event>
<event start="TLI_524" end="TLI_525">Sunndach.</event>
</tier><tier id="TIE4" speaker="S2" category="norm" type="a" display-name="S2 [norm]"><event start="TLI_1" end="TLI_2">(0.91) </event>
<event start="TLI_2" end="TLI_3">dieses Frühjahr war es erst mal, </event>
<event start="TLI_3" end="TLI_4">die erste Arbeit die ist, </event>
<event start="TLI_4" end="TLI_5">da wird das Korn gestreut und der Weizen wird gestreut. </event>
<event start="TLI_5" end="TLI_6">(0.31) </event>
<event start="TLI_6" end="TLI_7">Sobald wie der Frost aus den </event>
<event start="TLI_7" end="TLI_8">(0.37) </event>
<event start="TLI_8" end="TLI_9">Ländern raus ist, </event>
<event start="TLI_9" end="TLI_10">(0.24) </event>
<event start="TLI_10" end="TLI_11">und man so eben über das Land gehen kann, </event>
<event start="TLI_11" end="TLI_12">(0.22) </event>
<event start="TLI_12" end="TLI_13">dass man nicht drin stecken bleibt, </event>
<event start="TLI_13" end="TLI_14">dann fängt man an zu streuen. </event>
<event start="TLI_14" end="TLI_15">(0.45) </event>
<event start="TLI_15" end="TLI_16">die einen </event>
<event start="TLI_16" end="TLI_17">(0.58) </event>
<event start="TLI_17" end="TLI_18">die meinen nun, </event>
<event start="TLI_18" end="TLI_19">sie müssten immer streuen und streuen Volldünger oder wie sie </event>
<event start="TLI_19" end="TLI_20">was es nicht so alles gibt </event>
<event start="TLI_20" end="TLI_21">(0.48) </event>
<event start="TLI_21" end="TLI_22">und streuen richtig feste. </event>
<event start="TLI_22" end="TLI_23">die anderen, </event>
<event start="TLI_23" end="TLI_24">die haben die Zeit und streuen erst mal weniger </event>
<event start="TLI_24" end="TLI_25">(0.36) </event>
<event start="TLI_25" end="TLI_26">und dann hinten nach, </event>
<event start="TLI_26" end="TLI_27">wenn sie merken, </event>
<event start="TLI_27" end="TLI_28">dass es nicht so recht will, </event>
<event start="TLI_28" end="TLI_29">(0.34) </event>
<event start="TLI_29" end="TLI_30">dann, </event>
<event start="TLI_30" end="TLI_31">(0.37) </event>
<event start="TLI_31" end="TLI_32">gibt es noch mal so </event>
<event start="TLI_32" end="TLI_33">(0.27) </event>
<event start="TLI_33" end="TLI_34">was auf den Kopf. </event>
<event start="TLI_34" end="TLI_35">(1.98) </event>
<event start="TLI_35" end="TLI_36">das nächste ist dann, </event>
<event start="TLI_36" end="TLI_37">sobald wie die Felder </event>
<event start="TLI_37" end="TLI_38">(0.93) </event>
<event start="TLI_38" end="TLI_39">trocken sind, </event>
<event start="TLI_39" end="TLI_40">dass man an zu schleppen fängt und dann geht das </event>
<event start="TLI_40" end="TLI_41">(0.21) </event>
<event start="TLI_41" end="TLI_43">die Säerei los. </event>
<event start="TLI_43" end="TLI_44">(0.4) </event>
<event start="TLI_44" end="TLI_45">jetzt ist es ja furchtbar einfach, </event>
<event start="TLI_45" end="TLI_46">(0.85) </event>
<event start="TLI_46" end="TLI_47">sonst immer, </event>
<event start="TLI_47" end="TLI_48">da musste man sich mit den Kühen darum quälen. </event>
<event start="TLI_48" end="TLI_49">gerade bei uns kleinen Leuten; </event>
<event start="TLI_49" end="TLI_50">(0.57) </event>
<event start="TLI_50" end="TLI_51">aber jetzt haben sie ja bald alle einen Trecker </event>
<event start="TLI_51" end="TLI_52">(0.51) </event>
<event start="TLI_52" end="TLI_53">und da geht es sehr schnell. </event>
<event start="TLI_53" end="TLI_54">(1.84) </event>
<event start="TLI_54" end="TLI_55">da dauert es gar nicht lange, </event>
<event start="TLI_55" end="TLI_56">(0.15) </event>
<event start="TLI_56" end="TLI_57">da wird schon wieder geeggt und am Abend wird noch mal geeggt und den anderen Tag wird gesät und schon </event>
<event start="TLI_57" end="TLI_58">(0.4) </event>
<event start="TLI_58" end="TLI_59">ist der Hafer drin. </event>
<event start="TLI_59" end="TLI_60">(1.42) </event>
<event start="TLI_60" end="TLI_61">dann geht es weiter </event>
<event start="TLI_61" end="TLI_62">(1.78) </event>
<event start="TLI_62" end="TLI_63">an die Kartoffeln. </event>
<event start="TLI_63" end="TLI_64">dann werden die Kartoffeln gepflanzt. </event>
<event start="TLI_64" end="TLI_65">(0.3) </event>
<event start="TLI_65" end="TLI_66">früher da wurden sie immer </event>
<event start="TLI_66" end="TLI_67">(0.84) </event>
<event start="TLI_67" end="TLI_68">da wurde der ganze Mist im Winter </event>
<event start="TLI_68" end="TLI_69">(0.75) </event>
<event start="TLI_69" end="TLI_70">daheim behalten </event>
<event start="TLI_70" end="TLI_71">(0.48) </event>
<event start="TLI_71" end="TLI_72">und dann wurde acht Tage lang Mist gefahren. </event>
<event start="TLI_72" end="TLI_73">(0.45) </event>
<event start="TLI_73" end="TLI_74">dann musste gestreut werden, </event>
<event start="TLI_74" end="TLI_75">(0.45) </event>
<event start="TLI_75" end="TLI_76">und dann wurde gepflanzt, </event>
<event start="TLI_76" end="TLI_77">hinter dem Pflug her. </event>
<event start="TLI_77" end="TLI_78">(0.15) </event>
<event start="TLI_78" end="TLI_79">aber </event>
<event start="TLI_79" end="TLI_80">(0.36) </event>
<event start="TLI_80" end="TLI_81">das gibt es ja heute auch nicht mehr. </event>
<event start="TLI_81" end="TLI_82">da wird im Winter </event>
<event start="TLI_82" end="TLI_83">(0.45) </event>
<event start="TLI_83" end="TLI_84">und wenn es eben möglich ist, </event>
<event start="TLI_84" end="TLI_85">dass einer mit dem Trecker draußen durch die Feldwege durch kann, </event>
<event start="TLI_85" end="TLI_86">(0.27) </event>
<event start="TLI_86" end="TLI_87">dann wird Mist gefahren. </event>
<event start="TLI_87" end="TLI_88">(0.39) </event>
<event start="TLI_88" end="TLI_89">und dadurch werden ja auch viel die Feldwege kaputt gefahren. </event>
<event start="TLI_89" end="TLI_90">besonders diese letzten Jahre, </event>
<event start="TLI_90" end="TLI_91">(0.33) </event>
<event start="TLI_91" end="TLI_92">weil es immer so viel geregnet hat, </event>
<event start="TLI_92" end="TLI_93">(0.36) </event>
<event start="TLI_93" end="TLI_94">sind die Feldwege viel kaputt gefahren. </event>
<event start="TLI_94" end="TLI_95">(0.96) </event>
<event start="TLI_95" end="TLI_96">also die Mist ist dann früher wird dann noch mal </event>
<event start="TLI_96" end="TLI_97">was die letzten Wochen angefallen ist, </event>
<event start="TLI_97" end="TLI_98">das wird noch raus gefahren, </event>
<event start="TLI_98" end="TLI_99">(0.87) </event>
<event start="TLI_99" end="TLI_100">und dann </event>
<event start="TLI_100" end="TLI_101">(0.36) </event>
<event start="TLI_101" end="TLI_102">wenn auch </event>
<event start="TLI_102" end="TLI_103">(0.63) </event>
<event start="TLI_103" end="TLI_104">diese Kartoffeln Tage sind </event>
<event start="TLI_104" end="TLI_105">dann werden die Kartoffeln gepflanzt. </event>
<event start="TLI_105" end="TLI_106">und die werden jetzt mit so einem Vielfachgerät </event>
<event start="TLI_106" end="TLI_107">(0.33) </event>
<event start="TLI_107" end="TLI_108">gepflanzt. </event>
<event start="TLI_108" end="TLI_109">(0.45) </event>
<event start="TLI_109" end="TLI_110">das wird erst schön zurecht gemacht. </event>
<event start="TLI_110" end="TLI_111">der Kunstdünger wird womöglich gleich dazu gestreut. </event>
<event start="TLI_111" end="TLI_112">(0.34) </event>
<event start="TLI_112" end="TLI_113">dann werden Löcher gemacht, </event>
<event start="TLI_113" end="TLI_114">und dann geht man ganz bequem </event>
<event start="TLI_114" end="TLI_115">(0.27) </event>
<event start="TLI_115" end="TLI_116">hat man eine Schürze vor sich hängen voll Kartoffeln </event>
<event start="TLI_116" end="TLI_117">(0.85) </event>
<event start="TLI_117" end="TLI_118">geht die Furchen entlang und schmeißt dann in jedes Loch seine Kartoffel rein tritt mit dem Fuß drauf </event>
<event start="TLI_118" end="TLI_119">(0.37) </event>
<event start="TLI_119" end="TLI_120">und dann werden sie hinte nnach zu gemacht </event>
<event start="TLI_120" end="TLI_121">(1.92) </event>
<event start="TLI_121" end="TLI_122">mit dem selben Gerät und schon sind auch die Kartoffeln gepflanzt. </event>
<event start="TLI_122" end="TLI_123">das nächste ist </event>
<event start="TLI_123" end="TLI_124">(0.51) </event>
<event start="TLI_124" end="TLI_125">dann die Dickwurzelkerne. </event>
<event start="TLI_125" end="TLI_126">(0.48) </event>
<event start="TLI_126" end="TLI_127">die werden ja alle wie früher auch mit der Maschine gelegt. </event>
<event start="TLI_127" end="TLI_128">früher da hatte man noch keine Druckrollen. </event>
<event start="TLI_128" end="TLI_129">heute </event>
<event start="TLI_129" end="TLI_130">(0.37) </event>
<event start="TLI_130" end="TLI_131">sind Druckrollen dran, </event>
<event start="TLI_131" end="TLI_132">damit dass sie schön zu kommen; </event>
<event start="TLI_132" end="TLI_133">(1.24) </event>
<event start="TLI_133" end="TLI_134">und </event>
<event start="TLI_134" end="TLI_135">(0.97) </event>
<event start="TLI_135" end="TLI_136">besonders dieses Jahr, </event>
<event start="TLI_136" end="TLI_137">(0.37) </event>
<event start="TLI_137" end="TLI_138">da ging das alles schnell vonstatten. </event>
<event start="TLI_138" end="TLI_139">(0.93) </event>
<event start="TLI_139" end="TLI_140">aber </event>
<event start="TLI_140" end="TLI_141">(0.66) </event>
<event start="TLI_141" end="TLI_142">nachher, </event>
<event start="TLI_142" end="TLI_143">wie wir fertig waren, </event>
<event start="TLI_143" end="TLI_144">da dachten wir es gäb mal tüchtig regen, </event>
<event start="TLI_144" end="TLI_145">aber der Regen blieb aus; </event>
<event start="TLI_145" end="TLI_146">(0.42) </event>
<event start="TLI_146" end="TLI_147">und </event>
<event start="TLI_147" end="TLI_148">(2.46) </event>
<event start="TLI_148" end="TLI_149">das </event>
<event start="TLI_149" end="TLI_150">(0.37) </event>
<event start="TLI_150" end="TLI_151">Korn, </event>
<event start="TLI_151" end="TLI_152">das wollt nicht so richtig </event>
<event start="TLI_152" end="TLI_153">(0.94) </event>
<event start="TLI_153" end="TLI_154">wachsen, </event>
<event start="TLI_154" end="TLI_155">(0.43) </event>
<event start="TLI_155" end="TLI_156">und vor allen Dingen, </event>
<event start="TLI_156" end="TLI_157">(0.48) </event>
<event start="TLI_157" end="TLI_158">wir hatten viel Nachtfröste, </event>
<event start="TLI_158" end="TLI_159">(0.48) </event>
<event start="TLI_159" end="TLI_160">und das Gras auf den Wiesen wuchs auch nicht so </event>
<event start="TLI_160" end="TLI_161">(0.37) </event>
<event start="TLI_161" end="TLI_162">wie sonst die Jahre. </event>
<event start="TLI_162" end="TLI_163">(1.47) </event>
<event start="TLI_163" end="TLI_164">das Wetter war aber gut, </event>
<event start="TLI_164" end="TLI_165">und wir fingen schon beizeiten an Heu zu machen. </event>
<event start="TLI_165" end="TLI_166">(0.57) </event>
<event start="TLI_166" end="TLI_167">und </event>
<event start="TLI_167" end="TLI_168">(0.72) </event>
<event start="TLI_168" end="TLI_169">wir haben in diesem Jahre in acht Tagen fast das ganze Heu gemacht, </event>
<event start="TLI_169" end="TLI_170">was wir sonst wohl </event>
<event start="TLI_170" end="TLI_171">(0.61) </event>
<event start="TLI_171" end="TLI_172">nicht gemacht haben. </event>
<event start="TLI_172" end="TLI_173">(1.15) </event>
<event start="TLI_173" end="TLI_174">voriges Jahr, </event>
<event start="TLI_174" end="TLI_175">ich glaube, </event>
<event start="TLI_175" end="TLI_176">(0.39) </event>
<event start="TLI_176" end="TLI_177">wenn man da einen Wagen voll Heu haben wollte, </event>
<event start="TLI_177" end="TLI_178">(0.33) </event>
<event start="TLI_178" end="TLI_179">dann musste man ihn am Montag mähen, </event>
<event start="TLI_179" end="TLI_180">(0.48) </event>
<event start="TLI_180" end="TLI_181">und wenn man ihn dann am Sonnabend haben wollte, </event>
<event start="TLI_181" end="TLI_182">dann musste es gut gehen. </event>
<event start="TLI_182" end="TLI_183">(0.54) </event>
<event start="TLI_183" end="TLI_184">insgemein hat es dann noch </event>
<event start="TLI_184" end="TLI_185">(0.33) </event>
<event start="TLI_185" end="TLI_186">über acht Tage gedauert, </event>
<event start="TLI_186" end="TLI_187">bis dass man den ersten Wagen holen konnte. </event>
<event start="TLI_187" end="TLI_188">dann dieses Jahr war es glaube umgekehrt, </event>
<event start="TLI_188" end="TLI_189">(0.15) </event>
<event start="TLI_189" end="TLI_190">da war in einer Woche das ganze Heu gemacht. </event>
<event start="TLI_190" end="TLI_191">(1.45) </event>
<event start="TLI_191" end="TLI_192">Dickwurzeln wurden dann gehackt, </event>
<event start="TLI_192" end="TLI_193">auch vorher waren sie schon mal gehackt. </event>
<event start="TLI_193" end="TLI_194">sie waren dieses Jahr, </event>
<event start="TLI_194" end="TLI_195">weil es nicht so viel geregnet hatte schlecht aufgegangen, </event>
<event start="TLI_195" end="TLI_196">(0.4) </event>
<event start="TLI_196" end="TLI_197">und </event>
<event start="TLI_197" end="TLI_198">(0.79) </event>
<event start="TLI_198" end="TLI_199">man </event>
<event start="TLI_199" end="TLI_200">wusste kaum, </event>
<event start="TLI_200" end="TLI_201">die Reihen zu erkennen, </event>
<event start="TLI_201" end="TLI_202">(0.36) </event>
<event start="TLI_202" end="TLI_203">wo sie überhaupt standen. </event>
<event start="TLI_203" end="TLI_204">(0.81) </event>
<event start="TLI_204" end="TLI_205">aber hinten nach, </event>
<event start="TLI_205" end="TLI_206">(0.16) </event>
<event start="TLI_206" end="TLI_207">wie wir das Heu gemacht hatten, </event>
<event start="TLI_207" end="TLI_208">(0.54) </event>
<event start="TLI_208" end="TLI_209">da fing es auch </event>
<event start="TLI_209" end="TLI_210">(0.18) </event>
<event start="TLI_210" end="TLI_211">an zu regnen, </event>
<event start="TLI_211" end="TLI_212">und da haben sich auch die Dickwurzeln und auch die Winterfrucht hat sich noch ganz gut gemacht. </event>
<event start="TLI_212" end="TLI_213">(0.63) </event>
<event start="TLI_213" end="TLI_214">und äh wir können im Großen und Ganzen zufrieden sein, </event>
<event start="TLI_214" end="TLI_215">(0.91) </event>
<event start="TLI_215" end="TLI_216">denn äh </event>
<event start="TLI_216" end="TLI_217">(0.25) </event>
<event start="TLI_217" end="TLI_218">wir machen dieses Jahr noch eine ganz gute Ernte. </event>
<event start="TLI_218" end="TLI_219">(0.63) </event>
<event start="TLI_219" end="TLI_220">voriges Jahr, </event>
<event start="TLI_220" end="TLI_221">da hatten wir </event>
<event start="TLI_221" end="TLI_222">(1.77) </event>
<event start="TLI_222" end="TLI_223">nicht so eine gute Ernte, </event>
<event start="TLI_223" end="TLI_224">weil es am einunddreißigsten Mai </event>
<event start="TLI_224" end="TLI_225">(0.67) </event>
<event start="TLI_225" end="TLI_226">äh hagelte hier in der Gemarkung. </event>
<event start="TLI_226" end="TLI_227">und ich habe das mein Leben noch nicht erlebt. </event>
<event start="TLI_227" end="TLI_228">(0.37) </event>
<event start="TLI_228" end="TLI_229">mein Vater erzählt, </event>
<event start="TLI_229" end="TLI_230">hier hätte es die letzten Male gehagelt: </event>
<event start="TLI_230" end="TLI_231">(0.43) </event>
<event start="TLI_231" end="TLI_232">achtzehnhundertfünfundneunzig </event>
<event start="TLI_232" end="TLI_233">(0.78) </event>
<event start="TLI_233" end="TLI_234">und die meisten die hatten deswegen auch nicht versichert. </event>
<event start="TLI_234" end="TLI_235">(0.78) </event>
<event start="TLI_235" end="TLI_236">die alten Leute sagten immer: </event>
<event start="TLI_236" end="TLI_237">hier hagelt es so schnell nicht. </event>
<event start="TLI_237" end="TLI_238">(0.45) </event>
<event start="TLI_238" end="TLI_239">denn äh </event>
<event start="TLI_239" end="TLI_240">(0.61) </event>
<event start="TLI_240" end="TLI_241">wir haben auf der einen Seite, </event>
<event start="TLI_241" end="TLI_242">haben wir die Edertalsperre, </event>
<event start="TLI_242" end="TLI_243">die zieht die Gewitter an, </event>
<event start="TLI_243" end="TLI_244">(0.28) </event>
<event start="TLI_244" end="TLI_245">oben im Uppland da haben wir die Diemeltalsperre. </event>
<event start="TLI_245" end="TLI_246">(0.69) </event>
<event start="TLI_246" end="TLI_247">und da wird immer von gesagt: </event>
<event start="TLI_247" end="TLI_248">die ziehen die Gewitter an. </event>
<event start="TLI_248" end="TLI_249">(0.67) </event>
<event start="TLI_249" end="TLI_250">aber </event>
<event start="TLI_250" end="TLI_251">(0.81) </event>
<event start="TLI_251" end="TLI_252">voriges Jahr war es umgekehrt, </event>
<event start="TLI_252" end="TLI_253">da kam ein Gewitter von unten rauf und das stand hier oben vorm Eisenberg und konnte nicht drüber weg, </event>
<event start="TLI_253" end="TLI_254">(0.25) </event>
<event start="TLI_254" end="TLI_255">und da </event>
<event start="TLI_255" end="TLI_256">(0.16) </event>
<event start="TLI_256" end="TLI_257">hatten wir die große Bescherung. </event>
<event start="TLI_257" end="TLI_258">(0.39) </event>
<event start="TLI_258" end="TLI_259">und da hat es dermaßen gehagelt, </event>
<event start="TLI_259" end="TLI_260">(0.55) </event>
<event start="TLI_260" end="TLI_261">daß wir kaum noch äh </event>
<event start="TLI_261" end="TLI_262">(0.25) </event>
<event start="TLI_262" end="TLI_263">unsere Brotfrucht oder </event>
<event start="TLI_263" end="TLI_264">(0.67) </event>
<event start="TLI_264" end="TLI_265">und auch noch unser Korn zur Saat hatten. </event>
<event start="TLI_265" end="TLI_266">(0.48) </event>
<event start="TLI_266" end="TLI_267">allerdings nicht die ganze Germarkung, </event>
<event start="TLI_267" end="TLI_268">sondern </event>
<event start="TLI_268" end="TLI_269">(0.28) </event>
<event start="TLI_269" end="TLI_270">bloß die Hälfte, </event>
<event start="TLI_270" end="TLI_271">(0.48) </event>
<event start="TLI_271" end="TLI_272">die hatte was mitgekriegt. </event>
<event start="TLI_272" end="TLI_273">(2.28) </event>
<event start="TLI_273" end="TLI_274">deswegen sind wir dieses Jahr froh, </event>
<event start="TLI_274" end="TLI_275">dass das mal nicht der Fall ist. </event>
<event start="TLI_275" end="TLI_276">und </event>
<event start="TLI_276" end="TLI_277">(0.21) </event>
<event start="TLI_277" end="TLI_278">wenn es auch jetzt mal wieder warm wird, </event>
<event start="TLI_278" end="TLI_279">wir würden gerne schwitzen, </event>
<event start="TLI_279" end="TLI_280">denn wir sind froh, </event>
<event start="TLI_280" end="TLI_281">dass wir dieses Jahr mal wieder einen Bansen Korn haben, </event>
<event start="TLI_281" end="TLI_282">(0.52) </event>
<event start="TLI_282" end="TLI_283">und dass wir mal maschinen können, </event>
<event start="TLI_283" end="TLI_284">(0.28) </event>
<event start="TLI_284" end="TLI_285">und dass vor allen Dingen die Schuld, </event>
<event start="TLI_285" end="TLI_286">durch den Kunstdünger, </event>
<event start="TLI_286" end="TLI_287">den wir auf dem Kornhaus haben, </event>
<event start="TLI_287" end="TLI_288">(0.6) </event>
<event start="TLI_288" end="TLI_289">dass der dieses Jahr mal von der Latte von kommt. </event>
<event start="TLI_289" end="TLI_290">sonst äh macht es keinen Spaß mehr. </event>
<event start="TLI_290" end="TLI_291">(0.82) </event>
<event start="TLI_291" end="TLI_292">denn äh </event>
<event start="TLI_292" end="TLI_293">(1.0) </event>
<event start="TLI_293" end="TLI_294">muss man Zinsen bezahlen und das kommt jedes Jahr dabei, und </event>
<event start="TLI_294" end="TLI_295">(0.21) </event>
<event start="TLI_295" end="TLI_296">es ist ja so, </event>
<event start="TLI_296" end="TLI_297">wenn man keinen Kunstdünger streut, </event>
<event start="TLI_297" end="TLI_298">dann hat man ja auch nichts. </event>
<event start="TLI_298" end="TLI_299">(3.75) </event>
<event start="TLI_301" end="TLI_302">So, </event>
<event start="TLI_302" end="TLI_303">jetzt soll ich mal was erzählen von dem Dorfgemeinschaftshaus. </event>
<event start="TLI_303" end="TLI_304">(2.43) </event>
<event start="TLI_304" end="TLI_305">voriges Jahr </event>
<event start="TLI_305" end="TLI_306">(0.36) </event>
<event start="TLI_306" end="TLI_307">wir hatten hier in der Gemeinde nicht vor, </event>
<event start="TLI_307" end="TLI_308">ein Dorfgemeinschaftshaus zu bauen, </event>
<event start="TLI_308" end="TLI_309">sondern ich hatte mal vor Jahren eines gesehen auf so einer Besichtigungsfahrt, </event>
<event start="TLI_309" end="TLI_310">und da hab ich gedacht, </event>
<event start="TLI_310" end="TLI_311">wenn du jetzt in die Gemeinde kommst und willst </event>
<event start="TLI_311" end="TLI_312">(0.22) </event>
<event start="TLI_312" end="TLI_313">da erzählen wollten auch ein Dortgemeinschaftshaus bauen, </event>
<event start="TLI_313" end="TLI_314">(0.33) </event>
<event start="TLI_314" end="TLI_315">dann sagen die: </event>
<event start="TLI_315" end="TLI_316">glaube du bist verrückt!, </event>
<event start="TLI_316" end="TLI_317">(0.4) </event>
<event start="TLI_317" end="TLI_318">denn wir haben die ganzen Jahre schon so viel gemacht. </event>
<event start="TLI_318" end="TLI_319">wir haben die Wasserleitung gemacht und Straße gebaut </event>
<event start="TLI_319" end="TLI_320">(0.28) </event>
<event start="TLI_320" end="TLI_321">und wenn du jetzt auch noch mit solchen Plänen ankommst, </event>
<event start="TLI_321" end="TLI_322">dann äh</event>
<event start="TLI_322" end="TLI_323">(0.46) </event>
<event start="TLI_323" end="TLI_324">dann sagen die die: </event>
<event start="TLI_324" end="TLI_325">es wird Zeit, </event>
<event start="TLI_325" end="TLI_326">dass wir den bald in Arsch treten, </event>
<event start="TLI_326" end="TLI_327">der macht uns bald zu viel dadrin rum. </event>
<event start="TLI_327" end="TLI_328">(0.36) </event>
<event start="TLI_328" end="TLI_329">und da hab ich gedacht: </event>
<event start="TLI_329" end="TLI_330">wir wollten so eine Gefrieranlage bauen, </event>
<event start="TLI_330" end="TLI_331">(0.3) </event>
<event start="TLI_331" end="TLI_332">denn äh </event>
<event start="TLI_332" end="TLI_333">(1.5) </event>
<event start="TLI_333" end="TLI_334">im Herbst ist es so, </event>
<event start="TLI_334" end="TLI_335">(0.24) </event>
<event start="TLI_335" end="TLI_336">besonders wenn es bald nichts mehr auf der Rauchkammer gibt und man kann noch nicht schlachten, </event>
<event start="TLI_336" end="TLI_337">(0.3) </event>
<event start="TLI_337" end="TLI_338">dann hätte man gerne was frisches. </event>
<event start="TLI_338" end="TLI_339">(0.52) </event>
<event start="TLI_339" end="TLI_340">und </event>
<event start="TLI_340" end="TLI_341">(0.42) </event>
<event start="TLI_341" end="TLI_342">im Herbst ist gerade die meiste Arbeit, </event>
<event start="TLI_342" end="TLI_343">da wird maschint, </event>
<event start="TLI_343" end="TLI_344">(0.97) </event>
<event start="TLI_344" end="TLI_345">da wird maschint, </event>
<event start="TLI_345" end="TLI_346">und da muss </event>
<event start="TLI_346" end="TLI_347">(0.18) </event>
<event start="TLI_347" end="TLI_348">Fleisch gekauft werden, </event>
<event start="TLI_348" end="TLI_349">und wenn man heute nach Metzger muss,  </event>
<event start="TLI_349" end="TLI_350">(1.03) </event>
<event start="TLI_350" end="TLI_351">beim maschinen wollen die Leute auch nicht mehr den gelben Speck essen, </event>
<event start="TLI_351" end="TLI_352">(0.33) </event>
<event start="TLI_352" end="TLI_353">da wollen sie gerne so was </event>
<event start="TLI_353" end="TLI_354">(0.31) </event>
<event start="TLI_354" end="TLI_355">was Besseres haben. </event>
<event start="TLI_355" end="TLI_356">(0.24) </event>
<event start="TLI_356" end="TLI_357">und da wurde immer Fleisch gekauft und das kostete jedesmal eine % echte Stange Geld. </event>
<event start="TLI_357" end="TLI_358">(0.39) </event>
<event start="TLI_358" end="TLI_359">und da habe ich gedacht; </event>
<event start="TLI_359" end="TLI_360">(0.72) </event>
<event start="TLI_360" end="TLI_361">das Frühjahr, </event>
<event start="TLI_361" end="TLI_362">wenn so die Säue billig sind, </event>
<event start="TLI_362" end="TLI_363">(0.81) </event>
<event start="TLI_363" end="TLI_364">da könnte man dann einmal schlachten und könnte dann </event>
<event start="TLI_364" end="TLI_365">dieses </event>
<event start="TLI_365" end="TLI_366">(0.64) </event>
<event start="TLI_366" end="TLI_367">Fleisch in % % in so eine Gefrieranlage bringen, </event>
<event start="TLI_367" end="TLI_368">und man hätte dann zu jeder Zeit zu jeder Festlichkeit oder wenn sonst was wär, </event>
<event start="TLI_368" end="TLI_369">(0.22) </event>
<event start="TLI_369" end="TLI_370">hätte man schön frisches Fleisch. </event>
<event start="TLI_370" end="TLI_371">(0.9) </event>
<event start="TLI_371" end="TLI_372">und da dafür habe ich das der Gemeinde mal erzählt, </event>
<event start="TLI_372" end="TLI_373">und da haben sie auch gesagt das wäre gar nicht verkehrt. </event>
<event start="TLI_373" end="TLI_374">und ich dachte </event>
<event start="TLI_374" end="TLI_375">wir hatten hier </event>
<event start="TLI_375" end="TLI_376">(0.76) </event>
<event start="TLI_376" end="TLI_377">so ein altes Gemeindehaus </event>
<event start="TLI_377" end="TLI_378">und wir hatten da Platz ich dachte wir könnten die Gefrieranlage da </event>
<event start="TLI_378" end="TLI_379">könnten wir da einbauen </event>
<event start="TLI_379" end="TLI_380">(0.31) </event>
<event start="TLI_380" end="TLI_381">und ich glaubte, </event>
<event start="TLI_381" end="TLI_382">(0.73) </event>
<event start="TLI_382" end="TLI_383">wir kriegten auch für diese Gefrieranlage von dem Lande Hessen </event>
<event start="TLI_383" end="TLI_384">(0.7) </event>
<event start="TLI_384" end="TLI_385">% genausoviel Zuschuß, </event>
<event start="TLI_385" end="TLI_386">als wenn wir ein Dorfgemeinschaftshaus bauten. </event>
<event start="TLI_386" end="TLI_387">aber wie die Herren von der Land- </event>
<event start="TLI_387" end="TLI_388">und Forstwirtschaftskammer kamen, </event>
<event start="TLI_388" end="TLI_389">(0.36) </event>
<event start="TLI_389" end="TLI_390">und sich das Gebäude ansahen, </event>
<event start="TLI_390" end="TLI_391">da haben sie mir gesagt: </event>
<event start="TLI_391" end="TLI_393">nee, das geht nicht, </event>
<event start="TLI_393" end="TLI_394">(0.7) </event>
<event start="TLI_394" end="TLI_395">da geben % </event>
<event start="TLI_395" end="TLI_396">(0.49) </event>
<event start="TLI_396" end="TLI_397">können wir auch keinen Zuschus dann geben, </event>
<event start="TLI_397" end="TLI_398">sondern nur ein Darlehen, </event>
<event start="TLI_398" end="TLI_399">(0.24) </event>
<event start="TLI_399" end="TLI_400">und die ganze Anlage die kostet Euch dann in die zwanzigtausend Mark", </event>
<event start="TLI_400" end="TLI_401">(0.72) </event>
<event start="TLI_401" end="TLI_402">und da ist dieser Plan wieder fallen gelassen. </event>
<event start="TLI_402" end="TLI_403">(0.64) </event>
<event start="TLI_403" end="TLI_404">und da haben die mir aber gesagt, </event>
<event start="TLI_404" end="TLI_405">wenn wir einen schönen Platz hätten, </event>
<event start="TLI_405" end="TLI_406">(1.03) </event>
<event start="TLI_406" end="TLI_407">und wenn wir tüchtig arbeiten, </event>
<event start="TLI_407" end="TLI_408">und das sind wir ja der letzten Zeit </event>
<event start="TLI_408" end="TLI_409">(0.37) </event>
<event start="TLI_409" end="TLI_410">Jahren immer gewohnt gewesen, </event>
<event start="TLI_410" end="TLI_411">(0.63) </event>
<event start="TLI_411" end="TLI_412">dann äh könnten wir auch ein Haus bauen, </event>
<event start="TLI_412" end="TLI_413">dann brauchten wir auch nicht viel mehr Geld auf die Beine zu bringen wie zwanzigtausend Mark, </event>
<event start="TLI_413" end="TLI_414">wir müssten bloß tüchtig arbeiten. </event>
<event start="TLI_414" end="TLI_415">da bin ich mit den Herren auf den Festplatz gegangen, </event>
<event start="TLI_415" end="TLI_416">(0.33) </event>
<event start="TLI_416" end="TLI_417">wo wir immer die % % Feste gefeiert haben, </event>
<event start="TLI_417" end="TLI_418">ist ein schöner großer Platz, </event>
<event start="TLI_418" end="TLI_419">der liegt fast mitten im Dorf. </event>
<event start="TLI_419" end="TLI_420">(0.81) </event>
<event start="TLI_420" end="TLI_421">und da haben sie gesagt, </event>
<event start="TLI_421" end="TLI_422">das wäre die  </event>
<event start="TLI_422" end="TLI_423">(0.31) </event>
<event start="TLI_423" end="TLI_424">das wäre ein ganz schöner Platz. </event>
<event start="TLI_424" end="TLI_425">(0.67) </event>
<event start="TLI_425" end="TLI_426">und </event>
<event start="TLI_426" end="TLI_427">(1.06) </event>
<event start="TLI_427" end="TLI_428">da habe ich mal gesagt: </event>
<event start="TLI_428" end="TLI_430">gut, wenn das so ist,  </event>
<event start="TLI_430" end="TLI_431">aber ich </event>
<event start="TLI_431" end="TLI_432">(1.16) </event>
<event start="TLI_432" end="TLI_433">traute mir dem Braten noch nicht so recht. </event>
<event start="TLI_433" end="TLI_435">ich dachte, wir müssten noch viel mehr bezahlen, </event>
<event start="TLI_435" end="TLI_436">und da machte ich mich bange vor, </event>
<event start="TLI_436" end="TLI_437">aber </event>
<event start="TLI_437" end="TLI_438">(0.37) </event>
<event start="TLI_438" end="TLI_439">auf der andern Seite habe ich gedacht, </event>
<event start="TLI_439" end="TLI_440">es wird jetzt erst mal versucht, </event>
<event start="TLI_440" end="TLI_441">(0.61) </event>
<event start="TLI_441" end="TLI_442">und da haben wir mit den Herren in Kassel geschwätzt, </event>
<event start="TLI_442" end="TLI_443">und </event>
<event start="TLI_443" end="TLI_444">(0.45) </event>
<event start="TLI_444" end="TLI_445">dann </event>
<event start="TLI_445" end="TLI_446">(0.72) </event>
<event start="TLI_446" end="TLI_447">anschließend kamen die von Wiesbaden, </event>
<event start="TLI_447" end="TLI_448">(0.63) </event>
<event start="TLI_448" end="TLI_449">und dann haben wir denen erzählt was wir so  </event>
<event start="TLI_449" end="TLI_450">(1.14) </event>
<event start="TLI_450" end="TLI_451">im Jahre so auf die Beine bringen, </event>
<event start="TLI_451" end="TLI_452">hab ich einmal gesagt, </event>
<event start="TLI_452" end="TLI_453">dass könnten höchstens </event>
<event start="TLI_453" end="TLI_454">(0.25) </event>
<event start="TLI_454" end="TLI_455">siebentausend Mark sein, </event>
<event start="TLI_455" end="TLI_456">das wären dann in zwei Jahren </event>
<event start="TLI_456" end="TLI_457">(0.57) </event>
<event start="TLI_457" end="TLI_458">äh vierzehn- </event>
<event start="TLI_458" end="TLI_459">oder fünfzehntausend Mark und mehr ging unmöglich, </event>
<event start="TLI_459" end="TLI_460">und da haben sie gesagt: </event>
<event start="TLI_460" end="TLI_461">gut wenn ihr es </event>
<event start="TLI_461" end="TLI_462">(0.57) </event>
<event start="TLI_462" end="TLI_463">trotzdem äh, </event>
<event start="TLI_463" end="TLI_464">wollt, würden sie uns auch helfen, </event>
<event start="TLI_464" end="TLI_465">(0.9) </event>
<event start="TLI_465" end="TLI_466">und so ist es dann doch gelungen, </event>
<event start="TLI_466" end="TLI_467">dass wir </event>
<event start="TLI_467" end="TLI_468">(1.0) </event>
<event start="TLI_468" end="TLI_469">zu dem Hause gekommen sind, </event>
<event start="TLI_469" end="TLI_470">es ist ja noch nicht ganz fertig, </event>
<event start="TLI_470" end="TLI_471">(0.51) </event>
<event start="TLI_471" end="TLI_472">aber </event>
<event start="TLI_472" end="TLI_473">(1.75) </event>
<event start="TLI_473" end="TLI_474">wir haben es so weit fertig, </event>
<event start="TLI_474" end="TLI_475">dass wir am achten September die Einweihung feiern können. </event>
<event start="TLI_475" end="TLI_476">(0.93) </event>
<event start="TLI_476" end="TLI_477">das ganze Haus soll nun kosten: </event>
<event start="TLI_477" end="TLI_478">einhundertsiebenunddreißigtausend Mark, </event>
<event start="TLI_478" end="TLI_479">und davon äh gibt uns das Land Hessen, </event>
<event start="TLI_479" end="TLI_480">als Zuschuss siebenundneunzigtausend Mark. </event>
<event start="TLI_480" end="TLI_481">der Kreis, </event>
<event start="TLI_481" end="TLI_482">der gibt fünftausend Mark, </event>
<event start="TLI_482" end="TLI_483">(0.46) </event>
<event start="TLI_483" end="TLI_484">wir bringen also fünfzehntausend Mark noch in bar auf </event>
<event start="TLI_484" end="TLI_485">(0.37) </event>
<event start="TLI_485" end="TLI_486">und müssen allerdings zehntausend Mark abverdienen </event>
<event start="TLI_486" end="TLI_487">(0.75) </event>
<event start="TLI_487" end="TLI_488">durch Arbeiten. </event>
<event start="TLI_488" end="TLI_489">und das haben wir auch gemacht. </event>
<event start="TLI_489" end="TLI_490">der % letzte Winter der war gar nicht so </event>
<event start="TLI_490" end="TLI_491">(0.28) </event>
<event start="TLI_491" end="TLI_492">kalt. </event>
<event start="TLI_492" end="TLI_493">(1.39) </event>
<event start="TLI_493" end="TLI_494">wir konnten da viel fahren </event>
<event start="TLI_494" end="TLI_495">(0.33) </event>
<event start="TLI_495" end="TLI_496">und </event>
<event start="TLI_496" end="TLI_497">(0.19) </event>
<event start="TLI_497" end="TLI_498">konnten auch viel arbeiten! </event>
<event start="TLI_498" end="TLI_499">(0.27) </event>
<event start="TLI_499" end="TLI_500">weil wir viel anfüllen mussten </event>
<event start="TLI_500" end="TLI_501">(0.58) </event>
<event start="TLI_501" end="TLI_502">und da kamen wir ganz gut hin, </event>
<event start="TLI_502" end="TLI_503">daß wir unsere zehntausend Mark abverdienen können.</event>
<event start="TLI_503" end="TLI_504">(0.67) </event>
<event start="TLI_505" end="TLI_506">eins, </event>
<event start="TLI_506" end="TLI_507">zwei, </event>
<event start="TLI_507" end="TLI_508">drei, </event>
<event start="TLI_508" end="TLI_509">(0.21) </event>
<event start="TLI_509" end="TLI_510">vier, </event>
<event start="TLI_510" end="TLI_511">fünf, </event>
<event start="TLI_511" end="TLI_512">sechs, </event>
<event start="TLI_512" end="TLI_513">sieben, </event>
<event start="TLI_513" end="TLI_514">(0.21) </event>
<event start="TLI_514" end="TLI_515">acht, </event>
<event start="TLI_515" end="TLI_516">neun, </event>
<event start="TLI_516" end="TLI_517">zehn. </event>
<event start="TLI_517" end="TLI_518">(0.79) </event>
<event start="TLI_518" end="TLI_519">Montag, </event>
<event start="TLI_519" end="TLI_520">Dienstag, </event>
<event start="TLI_520" end="TLI_521">Mittwoch, </event>
<event start="TLI_521" end="TLI_522">Donnerstag, </event>
<event start="TLI_522" end="TLI_523">Freitag, </event>
<event start="TLI_523" end="TLI_524">Samstag, </event>
<event start="TLI_524" end="TLI_525">Sonntag. </event>
</tier><tier id="TIE1" speaker="S2" category="v" type="t" display-name="S2"><event start="TLI_1" end="TLI_2">(0.91) </event>
<event start="TLI_2" end="TLI_3">Dies Frühjahr wars erst mal, </event>
<event start="TLI_3" end="TLI_4">die erste Arbeit die ist, </event>
<event start="TLI_4" end="TLI_5">da wird das Korn gestreut und der Weizen wird gestreut. </event>
<event start="TLI_5" end="TLI_6">(0.31) </event>
<event start="TLI_6" end="TLI_7">Sobald wie der Frost aus den </event>
<event start="TLI_7" end="TLI_8">(0.37) </event>
<event start="TLI_8" end="TLI_9">Ländern raus ist, </event>
<event start="TLI_9" end="TLI_10">(0.24) </event>
<event start="TLI_10" end="TLI_11">und man so eben übers Land gehen kann, </event>
<event start="TLI_11" end="TLI_12">(0.22) </event>
<event start="TLI_12" end="TLI_13">daß man nicht drin stecken bleibt, </event>
<event start="TLI_13" end="TLI_14">dann fängt man zu streuen an. </event>
<event start="TLI_14" end="TLI_15">(0.45) </event>
<event start="TLI_15" end="TLI_16">Die einen </event>
<event start="TLI_16" end="TLI_17">(0.58) </event>
<event start="TLI_17" end="TLI_18">die meinen nun, </event>
<event start="TLI_18" end="TLI_19"><![CDATA[sie müßten immer streuen und streuen Volldünger oder wie sie > ]]></event>
<event start="TLI_19" end="TLI_20">was es nicht so alles gibt </event>
<event start="TLI_20" end="TLI_21">(0.48) </event>
<event start="TLI_21" end="TLI_22">und streuen richtig feste. </event>
<event start="TLI_22" end="TLI_23">Die Andern, </event>
<event start="TLI_23" end="TLI_24">die haben die Zeit und streuen erst mal wenig </event>
<event start="TLI_24" end="TLI_25">(0.36) </event>
<event start="TLI_25" end="TLI_26">und dann hintennach, </event>
<event start="TLI_26" end="TLI_27">wenn sie merken, </event>
<event start="TLI_27" end="TLI_28">daß es nicht so recht will, </event>
<event start="TLI_28" end="TLI_29">(0.34) </event>
<event start="TLI_29" end="TLI_30">dann, </event>
<event start="TLI_30" end="TLI_31">(0.37) </event>
<event start="TLI_31" end="TLI_32">gibt es noch mal so </event>
<event start="TLI_32" end="TLI_33">(0.27) </event>
<event start="TLI_33" end="TLI_34">was auf den Kopf. </event>
<event start="TLI_34" end="TLI_35">(1.98) </event>
<event start="TLI_35" end="TLI_36">Das Nächste ist dann, </event>
<event start="TLI_36" end="TLI_37">sobald wie die Felder </event>
<event start="TLI_37" end="TLI_38">(0.93) </event>
<event start="TLI_38" end="TLI_39">trocken sind, </event>
<event start="TLI_39" end="TLI_40">daß man an zu schleppen fängt und dann geht das- </event>
<event start="TLI_40" end="TLI_41">(0.21) </event>
<event start="TLI_41" end="TLI_43">die Säerei- los. </event>
<event start="TLI_43" end="TLI_44">(0.4) </event>
<event start="TLI_44" end="TLI_45">Jetzt ist es ja furchtbar einfach, </event>
<event start="TLI_45" end="TLI_46">(0.85) </event>
<event start="TLI_46" end="TLI_47">sonst immer, </event>
<event start="TLI_47" end="TLI_48">da mußt man sich mit den Kühen darum quälen. </event>
<event start="TLI_48" end="TLI_49">Grade bei uns kleinen Leuten; </event>
<event start="TLI_49" end="TLI_50">(0.57) </event>
<event start="TLI_50" end="TLI_51">aber jetzt haben sie ja bald alle einen Trecker </event>
<event start="TLI_51" end="TLI_52">(0.51) </event>
<event start="TLI_52" end="TLI_53">und da geht das sehr schnell. </event>
<event start="TLI_53" end="TLI_54">(1.84) </event>
<event start="TLI_54" end="TLI_55">Da es dauert gar nicht lange, </event>
<event start="TLI_55" end="TLI_56">(0.15) </event>
<event start="TLI_56" end="TLI_57">da wird schon wieder geeggt und am Abend wird nochmal geeggt und am andern Tag wird gesät und schon </event>
<event start="TLI_57" end="TLI_58">(0.4) </event>
<event start="TLI_58" end="TLI_59">ist der Hafer drin. </event>
<event start="TLI_59" end="TLI_60">(1.42) </event>
<event start="TLI_60" end="TLI_61">Dann geht es weiter </event>
<event start="TLI_61" end="TLI_62">(1.78) </event>
<event start="TLI_62" end="TLI_63">an sie Kartoffeln. </event>
<event start="TLI_63" end="TLI_64">Dann werden die Kartoffeln gepflanzt. </event>
<event start="TLI_64" end="TLI_65">(0.3) </event>
<event start="TLI_65" end="TLI_66"><![CDATA[Früher da wurden sie immer > ]]></event>
<event start="TLI_66" end="TLI_67">(0.84) </event>
<event start="TLI_67" end="TLI_68">da wurde der ganze Mist im Winter </event>
<event start="TLI_68" end="TLI_69">(0.75) </event>
<event start="TLI_69" end="TLI_70">daheim behalten </event>
<event start="TLI_70" end="TLI_71">(0.48) </event>
<event start="TLI_71" end="TLI_72">und dann wurde acht Tage lang Mist gefahren. </event>
<event start="TLI_72" end="TLI_73">(0.45) </event>
<event start="TLI_73" end="TLI_74">Dann mußte gestreut werden, </event>
<event start="TLI_74" end="TLI_75">(0.45) </event>
<event start="TLI_75" end="TLI_76">und dann wurde gepflanzt, </event>
<event start="TLI_76" end="TLI_77">hinterm Pflug her. </event>
<event start="TLI_77" end="TLI_78">(0.15) </event>
<event start="TLI_78" end="TLI_79">Aber </event>
<event start="TLI_79" end="TLI_80">(0.36) </event>
<event start="TLI_80" end="TLI_81">das gibt es ja heute auch nicht mehr. </event>
<event start="TLI_81" end="TLI_82">Da wird im Winter </event>
<event start="TLI_82" end="TLI_83">(0.45) </event>
<event start="TLI_83" end="TLI_84">und wenn es eben möglich ist, </event>
<event start="TLI_84" end="TLI_85">daß einer mit dem Trecker draussen durch die Feldwege durch kann, </event>
<event start="TLI_85" end="TLI_86">(0.27) </event>
<event start="TLI_86" end="TLI_87">dann wird Mist gefahren. </event>
<event start="TLI_87" end="TLI_88">(0.39) </event>
<event start="TLI_88" end="TLI_89">Und dadurch werden ja auch viel die Feldwege kaputt gefahren. </event>
<event start="TLI_89" end="TLI_90">Besonders diese letzten Jahre, </event>
<event start="TLI_90" end="TLI_91">(0.33) </event>
<event start="TLI_91" end="TLI_92">weils immer so viel geregnet hat, </event>
<event start="TLI_92" end="TLI_93">(0.36) </event>
<event start="TLI_93" end="TLI_94">sind die Feldwege viel kaputt gefahren. </event>
<event start="TLI_94" end="TLI_95">(0.96) </event>
<event start="TLI_95" end="TLI_96"><![CDATA[Also die Mist ist dann > vorher wird dann nochmal > ]]></event>
<event start="TLI_96" end="TLI_97">was die letzten Wochen angefallen ist, </event>
<event start="TLI_97" end="TLI_98">das wird noch raus gefahren, </event>
<event start="TLI_98" end="TLI_99">(0.87) </event>
<event start="TLI_99" end="TLI_100">und dann- </event>
<event start="TLI_100" end="TLI_101">(0.36) </event>
<event start="TLI_101" end="TLI_102">wenn auch </event>
<event start="TLI_102" end="TLI_103">(0.63) </event>
<event start="TLI_103" end="TLI_104">diese Kartoffeln, </event>
<event start="TLI_104" end="TLI_105">dann werden die Kartoffeln gepflanzt. </event>
<event start="TLI_105" end="TLI_106">Die werden jetzt mit so einem Vielfachgerät </event>
<event start="TLI_106" end="TLI_107">(0.33) </event>
<event start="TLI_107" end="TLI_108">gepflanzt. </event>
<event start="TLI_108" end="TLI_109">(0.45) </event>
<event start="TLI_109" end="TLI_110">Das wird erst schön zurecht gemacht. </event>
<event start="TLI_110" end="TLI_111">Der Kunstdünger wird womöglich gleich dazu gestreut. </event>
<event start="TLI_111" end="TLI_112">(0.34) </event>
<event start="TLI_112" end="TLI_113">Dann werden Löcher gemacht, </event>
<event start="TLI_113" end="TLI_114">und dann geht man ganz bequem- </event>
<event start="TLI_114" end="TLI_115">(0.27) </event>
<event start="TLI_115" end="TLI_116">hat man eine Schürze vor sich hängen voll Kartoffeln </event>
<event start="TLI_116" end="TLI_117">(0.85) </event>
<event start="TLI_117" end="TLI_118">geht die Furchen entlang und schmeißt dann in jedes Loch so eine Kartoffel rein und tritt mit dem Fuß drauf </event>
<event start="TLI_118" end="TLI_119">(0.37) </event>
<event start="TLI_119" end="TLI_120">und dann werden sie hintennach zu gemacht </event>
<event start="TLI_120" end="TLI_121">(1.92) </event>
<event start="TLI_121" end="TLI_122">mit dem selben Gerät und schon sind auch die Kartoffeln gepflanzt. </event>
<event start="TLI_122" end="TLI_123">Das nächste ist </event>
<event start="TLI_123" end="TLI_124">(0.51) </event>
<event start="TLI_124" end="TLI_125">dann die Dickwurzelkerne. </event>
<event start="TLI_125" end="TLI_126">(0.48) </event>
<event start="TLI_126" end="TLI_127">Die werden ja alle wie früher auch mit der Maschine gelegt. </event>
<event start="TLI_127" end="TLI_128">Früher da hatte man noch keine Druckrollen. </event>
<event start="TLI_128" end="TLI_129">Heute </event>
<event start="TLI_129" end="TLI_130">(0.37) </event>
<event start="TLI_130" end="TLI_131">sind Druckrollen dran, </event>
<event start="TLI_131" end="TLI_132">damit daß sie schön zu kommen; </event>
<event start="TLI_132" end="TLI_133">(1.24) </event>
<event start="TLI_133" end="TLI_134">und </event>
<event start="TLI_134" end="TLI_135">(0.97) </event>
<event start="TLI_135" end="TLI_136">besonders dieses Jahr, </event>
<event start="TLI_136" end="TLI_137">(0.37) </event>
<event start="TLI_137" end="TLI_138">da ging das alles schnell vonstatten. </event>
<event start="TLI_138" end="TLI_139">(0.93) </event>
<event start="TLI_139" end="TLI_140">Aber </event>
<event start="TLI_140" end="TLI_141">(0.66) </event>
<event start="TLI_141" end="TLI_142">nachher, </event>
<event start="TLI_142" end="TLI_143">wie wir fertig waren, </event>
<event start="TLI_143" end="TLI_144">da dachten wir es gäb mal tüchtig regen, </event>
<event start="TLI_144" end="TLI_145">aber der Regen blieb da aus; </event>
<event start="TLI_145" end="TLI_146">(0.42) </event>
<event start="TLI_146" end="TLI_147">und </event>
<event start="TLI_147" end="TLI_148">(2.46) </event>
<event start="TLI_148" end="TLI_149">das </event>
<event start="TLI_149" end="TLI_150">(0.37) </event>
<event start="TLI_150" end="TLI_151">Korn, </event>
<event start="TLI_151" end="TLI_152">das wollt nicht so richtig </event>
<event start="TLI_152" end="TLI_153">(0.94) </event>
<event start="TLI_153" end="TLI_154">wachsen, </event>
<event start="TLI_154" end="TLI_155">(0.43) </event>
<event start="TLI_155" end="TLI_156">und vor allen Dingen, </event>
<event start="TLI_156" end="TLI_157">(0.48) </event>
<event start="TLI_157" end="TLI_158">wir hatten viel Nachtfröste, </event>
<event start="TLI_158" end="TLI_159">(0.48) </event>
<event start="TLI_159" end="TLI_160">und das Gras auf den Wiesen wuchs auch nicht so </event>
<event start="TLI_160" end="TLI_161">(0.37) </event>
<event start="TLI_161" end="TLI_162">wie sonst die Jahre. </event>
<event start="TLI_162" end="TLI_163">(1.47) </event>
<event start="TLI_163" end="TLI_164">S' Wetter war aber gut, </event>
<event start="TLI_164" end="TLI_165">und wir fingen schon beizeiten an Heu zu machen. </event>
<event start="TLI_165" end="TLI_166">(0.57) </event>
<event start="TLI_166" end="TLI_167">Und </event>
<event start="TLI_167" end="TLI_168">(0.72) </event>
<event start="TLI_168" end="TLI_169">wir haben in diesem Jahre in acht Tagen fast das ganze Heu gemacht, </event>
<event start="TLI_169" end="TLI_170">was wir sonst wohl </event>
<event start="TLI_170" end="TLI_171">(0.61) </event>
<event start="TLI_171" end="TLI_172">nicht gemacht haben. </event>
<event start="TLI_172" end="TLI_173">(1.15) </event>
<event start="TLI_173" end="TLI_174">Voriges Jahr, </event>
<event start="TLI_174" end="TLI_175">ich glaube, </event>
<event start="TLI_175" end="TLI_176">(0.39) </event>
<event start="TLI_176" end="TLI_177">wenn man da 'nen Wagen voll Heu haben wollte, </event>
<event start="TLI_177" end="TLI_178">(0.33) </event>
<event start="TLI_178" end="TLI_179">dann mußte man am Montag mähen, </event>
<event start="TLI_179" end="TLI_180">(0.48) </event>
<event start="TLI_180" end="TLI_181">und wenn man ihn dann am Sonnabend haben wollte, </event>
<event start="TLI_181" end="TLI_182">dann mußte es gut gehen. </event>
<event start="TLI_182" end="TLI_183">(0.54) </event>
<event start="TLI_183" end="TLI_184">Insgemein hat es dann noch </event>
<event start="TLI_184" end="TLI_185">(0.33) </event>
<event start="TLI_185" end="TLI_186">über acht Tage gedauert, </event>
<event start="TLI_186" end="TLI_187">bis daß man den ersten Wagen holen konnte. </event>
<event start="TLI_187" end="TLI_188">Und dieses Jahr war's glaube ich umgekehrt, </event>
<event start="TLI_188" end="TLI_189">(0.15) </event>
<event start="TLI_189" end="TLI_190">da war in einer Woche das ganze Heu gemacht. </event>
<event start="TLI_190" end="TLI_191">(1.45) </event>
<event start="TLI_191" end="TLI_192">Dickwurzeln wurden dann gehackt, </event>
<event start="TLI_192" end="TLI_193">auch vorher waren sie schon mal gehackt. </event>
<event start="TLI_193" end="TLI_194">Sie waren dies Jahr, </event>
<event start="TLI_194" end="TLI_195">weil's nicht so viel geregnet hatte schlecht aufgegangen, </event>
<event start="TLI_195" end="TLI_196">(0.4) </event>
<event start="TLI_196" end="TLI_197">und </event>
<event start="TLI_197" end="TLI_198">(0.79) </event>
<event start="TLI_198" end="TLI_199">man </event>
<event start="TLI_199" end="TLI_200">wußte kaum, </event>
<event start="TLI_200" end="TLI_201">die Reihen zu erkennen, </event>
<event start="TLI_201" end="TLI_202">(0.36) </event>
<event start="TLI_202" end="TLI_203">wo sie überhaupt standen. </event>
<event start="TLI_203" end="TLI_204">(0.81) </event>
<event start="TLI_204" end="TLI_205">Aber hintennach, </event>
<event start="TLI_205" end="TLI_206">(0.16) </event>
<event start="TLI_206" end="TLI_207">wie wir's Heu gemacht hatten, </event>
<event start="TLI_207" end="TLI_208">(0.54) </event>
<event start="TLI_208" end="TLI_209">da fing es auch </event>
<event start="TLI_209" end="TLI_210">(0.18) </event>
<event start="TLI_210" end="TLI_211">an zu regnen, </event>
<event start="TLI_211" end="TLI_212">und da haben sich auch Dickwurzeln und auch die Winterfrucht hat sich noch ganz gut gemacht. </event>
<event start="TLI_212" end="TLI_213">(0.63) </event>
<event start="TLI_213" end="TLI_214">Und wir können im Großen und Ganzen zufrieden sein, </event>
<event start="TLI_214" end="TLI_215">(0.91) </event>
<event start="TLI_215" end="TLI_216">denn </event>
<event start="TLI_216" end="TLI_217">(0.25) </event>
<event start="TLI_217" end="TLI_218">wir machen dies' Jahr noch 'ne ganz gute Ernte. </event>
<event start="TLI_218" end="TLI_219">(0.63) </event>
<event start="TLI_219" end="TLI_220">Voriges Jahr, </event>
<event start="TLI_220" end="TLI_221">da hatten wir </event>
<event start="TLI_221" end="TLI_222">(1.77) </event>
<event start="TLI_222" end="TLI_223">nicht so 'ne gute Ernte, </event>
<event start="TLI_223" end="TLI_224">weil es am einunddreißigsten Mai </event>
<event start="TLI_224" end="TLI_225">(0.67) </event>
<event start="TLI_225" end="TLI_226">hagelte hier in der Gemarkung. </event>
<event start="TLI_226" end="TLI_227">Und ich habe das mein Leben noch nicht erlebt. </event>
<event start="TLI_227" end="TLI_228">(0.37) </event>
<event start="TLI_228" end="TLI_229">Mein Vater erzählt, </event>
<event start="TLI_229" end="TLI_230">hier hätte es die letzten mals gehagelt: </event>
<event start="TLI_230" end="TLI_231">(0.43) </event>
<event start="TLI_231" end="TLI_232"><![CDATA[Achtzehnhundertfünfundneunzig > . ]]></event>
<event start="TLI_232" end="TLI_233">(0.78) </event>
<event start="TLI_233" end="TLI_234">Und die meisten die hatten deswegen auch nicht versichert. </event>
<event start="TLI_234" end="TLI_235">(0.78) </event>
<event start="TLI_235" end="TLI_236">Die alten Leute sagten immer: </event>
<event start="TLI_236" end="TLI_237">" Hier hagelt es so schnell nicht." </event>
<event start="TLI_237" end="TLI_238">(0.45) </event>
<event start="TLI_238" end="TLI_239">Denn </event>
<event start="TLI_239" end="TLI_240">(0.61) </event>
<event start="TLI_240" end="TLI_241">wir haben auf der einen Seite, </event>
<event start="TLI_241" end="TLI_242">haben wir die Edertalsperre, </event>
<event start="TLI_242" end="TLI_243">die zieht die Gewitter an, </event>
<event start="TLI_243" end="TLI_244">(0.28) </event>
<event start="TLI_244" end="TLI_245">oben im Uppland da haben wir die Diemeltalsperre. </event>
<event start="TLI_245" end="TLI_246">(0.69) </event>
<event start="TLI_246" end="TLI_247">Und da wird immer von gesagt: </event>
<event start="TLI_247" end="TLI_248">" Die ziehen die Gewitter an." </event>
<event start="TLI_248" end="TLI_249">(0.67) </event>
<event start="TLI_249" end="TLI_250">Aber </event>
<event start="TLI_250" end="TLI_251">(0.81) </event>
<event start="TLI_251" end="TLI_252">voriges Jahr wars umgekehrt, </event>
<event start="TLI_252" end="TLI_253">da kam ein Gewitter von unten rauf und das stand hier oben vorm Eisenberg und konnte nicht drüber weg, </event>
<event start="TLI_253" end="TLI_254">(0.25) </event>
<event start="TLI_254" end="TLI_255">und da </event>
<event start="TLI_255" end="TLI_256">(0.16) </event>
<event start="TLI_256" end="TLI_257">hatten wir die große Bescherung. </event>
<event start="TLI_257" end="TLI_258">(0.39) </event>
<event start="TLI_258" end="TLI_259">Und da hat es dermaßen gehagelt, </event>
<event start="TLI_259" end="TLI_260">(0.55) </event>
<event start="TLI_260" end="TLI_261">daß wir kaum noch </event>
<event start="TLI_261" end="TLI_262">(0.25) </event>
<event start="TLI_262" end="TLI_263">unsere Brotfrucht </event>
<event start="TLI_263" end="TLI_264">(0.67) </event>
<event start="TLI_264" end="TLI_265"><![CDATA[und auch noch unser Korn > zur Saat hatten. ]]></event>
<event start="TLI_265" end="TLI_266">(0.48) </event>
<event start="TLI_266" end="TLI_267">Allerdings nicht die ganze Germarkung, </event>
<event start="TLI_267" end="TLI_268">sondern </event>
<event start="TLI_268" end="TLI_269">(0.28) </event>
<event start="TLI_269" end="TLI_270">bloß die Hälfte, </event>
<event start="TLI_270" end="TLI_271">(0.48) </event>
<event start="TLI_271" end="TLI_272">die hatte was mitgekriegt. </event>
<event start="TLI_272" end="TLI_273">(2.28) </event>
<event start="TLI_273" end="TLI_274">Deswegen sind wir dies' Jahr froh, </event>
<event start="TLI_274" end="TLI_275">daß das mal nicht der Fall ist. </event>
<event start="TLI_275" end="TLI_276">Und</event>
<event start="TLI_276" end="TLI_277">(0.21) </event>
<event start="TLI_277" end="TLI_278">wenn's auch jetzt mal wieder warm wird, </event>
<event start="TLI_278" end="TLI_279">wir würden gerne schwitzen, </event>
<event start="TLI_279" end="TLI_280">denn wir sind froh, </event>
<event start="TLI_280" end="TLI_281">daß wir dies' Jahr mal wieder 'nen Bansen Korn haben, </event>
<event start="TLI_281" end="TLI_282">(0.52) </event>
<event start="TLI_282" end="TLI_283">und daß wir mal maschinen können, </event>
<event start="TLI_283" end="TLI_284">(0.28) </event>
<event start="TLI_284" end="TLI_285">und daß vor allen Dingen die Schuld, </event>
<event start="TLI_285" end="TLI_286">durch den Kunstdünger, </event>
<event start="TLI_286" end="TLI_287">den wir auf dem Kornhaus haben, </event>
<event start="TLI_287" end="TLI_288">(0.6) </event>
<event start="TLI_288" end="TLI_289">daß der dies' Jahr mal von der Latte von kommt. </event>
<event start="TLI_289" end="TLI_290">Sonst macht es keinen Spaß mehr. </event>
<event start="TLI_290" end="TLI_291">(0.82) </event>
<event start="TLI_291" end="TLI_292">Dann </event>
<event start="TLI_292" end="TLI_293">(1.0) </event>
<event start="TLI_293" end="TLI_294">muß man Zinsen bezahlen und das kommt jedes Jahr dabei, </event>
<event start="TLI_294" end="TLI_295">(0.21) </event>
<event start="TLI_295" end="TLI_296">und es ist ja so, </event>
<event start="TLI_296" end="TLI_297">wenn man keinen Kunstdünger streut, </event>
<event start="TLI_297" end="TLI_298">dann hat man ja auch nichts. |</event>
<event start="TLI_298" end="TLI_299">(3.75) </event>
<event start="TLI_301" end="TLI_302">So, </event>
<event start="TLI_302" end="TLI_303">jetzt soll ich mal was erzählen von dem Dorfgemeinschaftshaus. </event>
<event start="TLI_303" end="TLI_304">(2.43) </event>
<event start="TLI_304" end="TLI_305">Voriges Jahr- </event>
<event start="TLI_305" end="TLI_306">(0.36) </event>
<event start="TLI_306" end="TLI_307">wir hatten hier in der Gemeinde nicht vor, </event>
<event start="TLI_307" end="TLI_308">ein Dorfgemeinschaftshaus zu bauen, </event>
<event start="TLI_308" end="TLI_309">sondern ich hatte mal vor Jahren eines gesehen auf so 'ner Besichtigungsfahrt, </event>
<event start="TLI_309" end="TLI_310">und da hab ich gedacht, </event>
<event start="TLI_310" end="TLI_311">wenn du jetzt in die Gemeinde kommst und willst </event>
<event start="TLI_311" end="TLI_312">(0.22) </event>
<event start="TLI_312" end="TLI_313">da erzählen wir wollten auch ein Dortgemeinschaftshaus bauen, </event>
<event start="TLI_313" end="TLI_314">(0.33) </event>
<event start="TLI_314" end="TLI_315">dann sagen die: </event>
<event start="TLI_315" end="TLI_316">" Ich glaube Du bist verrückt!", </event>
<event start="TLI_316" end="TLI_317">(0.4) </event>
<event start="TLI_317" end="TLI_318">denn wir haben die ganzen Jahre schon so viel gemacht. </event>
<event start="TLI_318" end="TLI_319">Wir haben 'ne Wasserleitung gemacht und Straße gebaut </event>
<event start="TLI_319" end="TLI_320">(0.28) </event>
<event start="TLI_320" end="TLI_321">und wenn du jetzt auch noch mit solchen Plänen ankommst, </event>
<event start="TLI_321" end="TLI_322">dann- </event>
<event start="TLI_322" end="TLI_323">(0.46) </event>
<event start="TLI_323" end="TLI_324">dann sagen die: </event>
<event start="TLI_324" end="TLI_325">" Es wird Zeit, </event>
<event start="TLI_325" end="TLI_326">daß wir den bald in' Arsch treten, </event>
<event start="TLI_326" end="TLI_327">der macht uns bald zu viel dadrin rum." </event>
<event start="TLI_327" end="TLI_328">(0.36) </event>
<event start="TLI_328" end="TLI_329">Und da hab ich gedacht: </event>
<event start="TLI_329" end="TLI_330">Wir wollten so 'ne Gefrieranlage bauen, </event>
<event start="TLI_330" end="TLI_331">(0.3) </event>
<event start="TLI_331" end="TLI_332">denn </event>
<event start="TLI_332" end="TLI_333">(1.5) </event>
<event start="TLI_333" end="TLI_334">im Herbst ist es so, </event>
<event start="TLI_334" end="TLI_335">(0.24) </event>
<event start="TLI_335" end="TLI_336">besonders wenn's bald nichts mehr auf der Rauchkammer gibt und man kann noch nicht schlachten, </event>
<event start="TLI_336" end="TLI_337">(0.3) </event>
<event start="TLI_337" end="TLI_338">dann hat man gerne was Frisches. </event>
<event start="TLI_338" end="TLI_339">(0.52) </event>
<event start="TLI_339" end="TLI_340">Und </event>
<event start="TLI_340" end="TLI_341">(0.42) </event>
<event start="TLI_341" end="TLI_342">im Herbst ist grade die meiste Arbeit, </event>
<event start="TLI_342" end="TLI_343">da wird maschint, </event>
<event start="TLI_343" end="TLI_344">(0.97) </event>
<event start="TLI_344" end="TLI_345">da wird maschint, </event>
<event start="TLI_345" end="TLI_346">und da muß </event>
<event start="TLI_346" end="TLI_347">(0.18) </event>
<event start="TLI_347" end="TLI_348">Fleisch gekauft werden, </event>
<event start="TLI_348" end="TLI_349">und wenn man heute nach den Metzger muß, - </event>
<event start="TLI_349" end="TLI_350">(1.03) </event>
<event start="TLI_350" end="TLI_351">beim maschinen wollen die Leute auch nicht mehr den gelben Speck essen, </event>
<event start="TLI_351" end="TLI_352">(0.33) </event>
<event start="TLI_352" end="TLI_353">da wollen sie gerne sowas- </event>
<event start="TLI_353" end="TLI_354">(0.31) </event>
<event start="TLI_354" end="TLI_355">was Besseres haben. </event>
<event start="TLI_355" end="TLI_356">(0.24) </event>
<event start="TLI_356" end="TLI_357">Und da wurde immer Fleisch gekauft und das kostete jedesmal 'ne echte Stange Geld. </event>
<event start="TLI_357" end="TLI_358">(0.39) </event>
<event start="TLI_358" end="TLI_359">Und da hab ich gedacht; </event>
<event start="TLI_359" end="TLI_360">(0.72) </event>
<event start="TLI_360" end="TLI_361">das Frühjahr, </event>
<event start="TLI_361" end="TLI_362">wenn so die Säue billig sind, </event>
<event start="TLI_362" end="TLI_363">(0.81) </event>
<event start="TLI_363" end="TLI_364">da könnt man dann einmal schlachten und könnte dann </event>
<event start="TLI_364" end="TLI_365">dieses </event>
<event start="TLI_365" end="TLI_366">(0.64) </event>
<event start="TLI_366" end="TLI_367">Fleisch in so 'ne Gefrieranlage bringen, </event>
<event start="TLI_367" end="TLI_368">und man hätte dann zu jeder Zeit zu jeder Festlichkeit oder wenn sonst was wär, </event>
<event start="TLI_368" end="TLI_369">(0.22) </event>
<event start="TLI_369" end="TLI_370">hätte man schön frisches Fleisch. </event>
<event start="TLI_370" end="TLI_371">(0.9) </event>
<event start="TLI_371" end="TLI_372">Und da dadurch hab ich der Gemeinde das mal erzählt, </event>
<event start="TLI_372" end="TLI_373">und da haben sie auch gesagt das wär garnicht verkehrt. </event>
<event start="TLI_373" end="TLI_374">Und ich dachte- </event>
<event start="TLI_374" end="TLI_375">wir hatten hier </event>
<event start="TLI_375" end="TLI_376">(0.76) </event>
<event start="TLI_376" end="TLI_377">so 'n altes Gemeindehaus- </event>
<event start="TLI_377" end="TLI_378">und wir hatten ja Platz und ich dachte wir könnten die Gefrieranlage da- </event>
<event start="TLI_378" end="TLI_379">könnten wir da einbauen </event>
<event start="TLI_379" end="TLI_380">(0.31) </event>
<event start="TLI_380" end="TLI_381">und ich glaubte, </event>
<event start="TLI_381" end="TLI_382">(0.73) </event>
<event start="TLI_382" end="TLI_383">wir kriegten auch für diese Gefrieranlage von dem Lande Hessen </event>
<event start="TLI_383" end="TLI_384">(0.7) </event>
<event start="TLI_384" end="TLI_385">genausoviel Zuschuß, </event>
<event start="TLI_385" end="TLI_386">als wenn wir ein Dorfgemeinschaftshaus bauten. </event>
<event start="TLI_386" end="TLI_387">Aber wie die Herrn vom Land- </event>
<event start="TLI_387" end="TLI_388">und Forstwirtschaftskammer kamen, </event>
<event start="TLI_388" end="TLI_389">(0.36) </event>
<event start="TLI_389" end="TLI_390">und die das Gebäude ansahen, </event>
<event start="TLI_390" end="TLI_391">da haben sie mir gesagt: </event>
<event start="TLI_391" end="TLI_393">" Nee, das geht nicht, </event>
<event start="TLI_393" end="TLI_394">(0.7) </event>
<event start="TLI_394" end="TLI_395">da geben- da</event>
<event start="TLI_395" end="TLI_396">(0.49) </event>
<event start="TLI_396" end="TLI_397">können wir auch keinen Zuschuß zu geben, </event>
<event start="TLI_397" end="TLI_398">sondern nur ein Darlehen, </event>
<event start="TLI_398" end="TLI_399">(0.24) </event>
<event start="TLI_399" end="TLI_400">und die ganze Anlage die kostet Euch dann in die zwanzigtausend Mark", </event>
<event start="TLI_400" end="TLI_401">(0.72) </event>
<event start="TLI_401" end="TLI_402">und da ist dieser Plan wieder fallen gelassen. </event>
<event start="TLI_402" end="TLI_403">(0.64) </event>
<event start="TLI_403" end="TLI_404">Und da haben die mir aber gesagt, </event>
<event start="TLI_404" end="TLI_405">" wenn wir einen schönen Platz hätten, </event>
<event start="TLI_405" end="TLI_406">(1.03) </event>
<event start="TLI_406" end="TLI_407">und wenn wir tüchtig arbeiteten, </event>
<event start="TLI_407" end="TLI_408">und das sind wir ja in den letztn </event>
<event start="TLI_408" end="TLI_409">(0.37) </event>
<event start="TLI_409" end="TLI_410">Jahren immer gewohnt gewesen, </event>
<event start="TLI_410" end="TLI_411">(0.63) </event>
<event start="TLI_411" end="TLI_412">dann könnten wir auch ein Haus bauen, </event>
<event start="TLI_412" end="TLI_413">dann brauchten wir auch nicht viel mehr Geld auf die Beine zu bringen wie zwanzigtausend Mark, </event>
<event start="TLI_413" end="TLI_414">wir müßten nur tüchtig arbeiten. </event>
<event start="TLI_414" end="TLI_415">Da bin ich mit den Herren auf den Festplatz gegangen, </event>
<event start="TLI_415" end="TLI_416">(0.33) </event>
<event start="TLI_416" end="TLI_417">wo wir immer die Feste gefeiert haben, - </event>
<event start="TLI_417" end="TLI_418">ist ein schöner großer Platz, - </event>
<event start="TLI_418" end="TLI_419">der liegt fast mitten im Dorf. </event>
<event start="TLI_419" end="TLI_420">(0.81) </event>
<event start="TLI_420" end="TLI_421">Und da haben sie gesagt, </event>
<event start="TLI_421" end="TLI_422">das wär die- </event>
<event start="TLI_422" end="TLI_423">(0.31) </event>
<event start="TLI_423" end="TLI_424">das wär ein ganz schöner Platz. </event>
<event start="TLI_424" end="TLI_425">(0.67) </event>
<event start="TLI_425" end="TLI_426">Und </event>
<event start="TLI_426" end="TLI_427">(1.06) </event>
<event start="TLI_427" end="TLI_428">da habe ich mir gesagt: </event>
<event start="TLI_428" end="TLI_430">Gut, wenn das so ist, - </event>
<event start="TLI_430" end="TLI_431">aber ich </event>
<event start="TLI_431" end="TLI_432">(1.16) </event>
<event start="TLI_432" end="TLI_433">traute mir dem Braten noch nicht so recht-. </event>
<event start="TLI_433" end="TLI_435">Ich dachte, wir müßten noch viel mehr bezahlen, </event>
<event start="TLI_435" end="TLI_436">und da macht ich mich bange vor, </event>
<event start="TLI_436" end="TLI_437">aber </event>
<event start="TLI_437" end="TLI_438">(0.37) </event>
<event start="TLI_438" end="TLI_439">auf der andern Seite hab' ich gedacht, </event>
<event start="TLI_439" end="TLI_440">willst es erst mal versuchen, </event>
<event start="TLI_440" end="TLI_441">(0.61) </event>
<event start="TLI_441" end="TLI_442">und da haben wir mit den Herren in Kassel geschwätzt, </event>
<event start="TLI_442" end="TLI_443">und </event>
<event start="TLI_443" end="TLI_444">(0.45) </event>
<event start="TLI_444" end="TLI_445">dann </event>
<event start="TLI_445" end="TLI_446">(0.72) </event>
<event start="TLI_446" end="TLI_447">anschließend kamen die von Wiesbaden, </event>
<event start="TLI_447" end="TLI_448">(0.63) </event>
<event start="TLI_448" end="TLI_449"><![CDATA[und dann haben wir denen erzählt was wir so > ]]></event>
<event start="TLI_449" end="TLI_450">(1.14) </event>
<event start="TLI_450" end="TLI_451">im Jahre so auf die Beine bringen, </event>
<event start="TLI_451" end="TLI_452">hab ich einmal gesagt, </event>
<event start="TLI_452" end="TLI_453">daß könnten höchstens </event>
<event start="TLI_453" end="TLI_454">(0.25) </event>
<event start="TLI_454" end="TLI_455">siebentausend Mark sein, </event>
<event start="TLI_455" end="TLI_456">das wären dann in zwei Jahren </event>
<event start="TLI_456" end="TLI_457">(0.57) </event>
<event start="TLI_457" end="TLI_458">vierzehn- </event>
<event start="TLI_458" end="TLI_459">oder fünfzehntausend Mark und mehr ging unmöglich, </event>
<event start="TLI_459" end="TLI_460">und da haben sie gesagt: </event>
<event start="TLI_460" end="TLI_461">" Gut und wenn Ihr </event>
<event start="TLI_461" end="TLI_462">(0.57) </event>
<event start="TLI_462" end="TLI_463">trotzdem wollt, </event>
<event start="TLI_463" end="TLI_464">würden sie uns auch helfen", </event>
<event start="TLI_464" end="TLI_465">(0.9) </event>
<event start="TLI_465" end="TLI_466">und so ist es dann doch gelungen, </event>
<event start="TLI_466" end="TLI_467">daß wir </event>
<event start="TLI_467" end="TLI_468">(1.0) </event>
<event start="TLI_468" end="TLI_469">zu dem Hause gekommen sind, </event>
<event start="TLI_469" end="TLI_470">es ist ja noch nicht ganz fertig, </event>
<event start="TLI_470" end="TLI_471">(0.51) </event>
<event start="TLI_471" end="TLI_472">aber </event>
<event start="TLI_472" end="TLI_473">(1.75) </event>
<event start="TLI_473" end="TLI_474">wir haben's soweit fertig, </event>
<event start="TLI_474" end="TLI_475">daß wir am achten September die Einweihung feiern können. </event>
<event start="TLI_475" end="TLI_476">(0.93) </event>
<event start="TLI_476" end="TLI_477">Das ganze Haus soll nun kosten: </event>
<event start="TLI_477" end="TLI_478">einhundertsiebenunddreißigtausend Mark, </event>
<event start="TLI_478" end="TLI_479">und davon gibt uns das Land Hessen, </event>
<event start="TLI_479" end="TLI_480">als Zuschuß siebenundneunzigtausend Mark. </event>
<event start="TLI_480" end="TLI_481">Der Kreis, </event>
<event start="TLI_481" end="TLI_482">der gibt fünftausend Mark, </event>
<event start="TLI_482" end="TLI_483">(0.46) </event>
<event start="TLI_483" end="TLI_484">wir bringen also fünfzehntausend Mark noch in bar auf </event>
<event start="TLI_484" end="TLI_485">(0.37) </event>
<event start="TLI_485" end="TLI_486">und müssen allerdings zehntausend Mark abverdienen </event>
<event start="TLI_486" end="TLI_487">(0.75) </event>
<event start="TLI_487" end="TLI_488">durch Arbeiten. </event>
<event start="TLI_488" end="TLI_489">Und das haben wir auch gemacht. </event>
<event start="TLI_489" end="TLI_490">Der letzte Winter der war ja nicht so </event>
<event start="TLI_490" end="TLI_491">(0.28) </event>
<event start="TLI_491" end="TLI_492">kalt. </event>
<event start="TLI_492" end="TLI_493">(1.39) </event>
<event start="TLI_493" end="TLI_494">Wir konnten da viel fahren </event>
<event start="TLI_494" end="TLI_495">(0.33) </event>
<event start="TLI_495" end="TLI_496">und </event>
<event start="TLI_496" end="TLI_497">(0.19) </event>
<event start="TLI_497" end="TLI_498">konnten auch viel arbeiten! </event>
<event start="TLI_498" end="TLI_499">(0.27) </event>
<event start="TLI_499" end="TLI_500">Weil wir viel anfüllen mußten </event>
<event start="TLI_500" end="TLI_501">(0.58) </event>
<event start="TLI_501" end="TLI_502">und da kamen wir ganz gut hin, </event>
<event start="TLI_502" end="TLI_503">daß wir unsere zehntausend Mark abverdienen können. |</event>
<event start="TLI_503" end="TLI_504">(0.67) </event>
<event start="TLI_505" end="TLI_506">Einse, </event>
<event start="TLI_506" end="TLI_507">zwei, </event>
<event start="TLI_507" end="TLI_508">drei, </event>
<event start="TLI_508" end="TLI_509">(0.21) </event>
<event start="TLI_509" end="TLI_510">viere, </event>
<event start="TLI_510" end="TLI_511">fünfe, </event>
<event start="TLI_511" end="TLI_512">sechse, </event>
<event start="TLI_512" end="TLI_513">siebene, </event>
<event start="TLI_513" end="TLI_514">(0.21) </event>
<event start="TLI_514" end="TLI_515">achte, </event>
<event start="TLI_515" end="TLI_516">neune, </event>
<event start="TLI_516" end="TLI_517">zehne. </event>
<event start="TLI_517" end="TLI_518">(0.79) </event>
<event start="TLI_518" end="TLI_519">Montag, </event>
<event start="TLI_519" end="TLI_520">Dienstag, </event>
<event start="TLI_520" end="TLI_521">Mittwoch, </event>
<event start="TLI_521" end="TLI_522">Donnerstag, </event>
<event start="TLI_522" end="TLI_523">Freitag, </event>
<event start="TLI_523" end="TLI_524">Samstag, </event>
<event start="TLI_524" end="TLI_525">Sonntag. |</event>
</tier><tier id="TIE3" speaker="S1" category="lit" type="a" display-name="S1 [lit]"><event start="TLI_0" end="TLI_1">eins einunddreißig einundneunzig </event>
<event start="TLI_299" end="TLI_300">nun erzählen Sie erzählen Sie doch mal von dem Dorfgemeinschaftshaus. </event>
<event start="TLI_300" end="TLI_301">Von dem Plan und der Ausführung. |</event>
<event start="TLI_504" end="TLI_505">Zählen Sie bitte noch von eins bis zehn und sagen dann die Wochentage. Auch auf platt.</event>
</tier><tier id="TIE2" speaker="S1" category="v" type="t" display-name="S1"><event start="TLI_0" end="TLI_1">Eins</event>
<event start="TLI_299" end="TLI_300">Nun erzählen Sie doch mal von dem Dorfgemeinschaftshaus. </event>
<event start="TLI_300" end="TLI_301">Von dem Plan und der Ausführung. |</event>
<event start="TLI_504" end="TLI_505">Zählen Sie bitte noch von eins bis zehn und sagen dann die Wochentage auch auf platt. |</event>
</tier><tier id="TIE_NOSP" speaker="SPK_NOSPK" category="v" type="t" display-name=""></tier></basic-body>
</basic-transcription>
