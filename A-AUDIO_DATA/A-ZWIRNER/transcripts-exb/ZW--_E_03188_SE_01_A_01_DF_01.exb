</tier><tier id="TIE4" speaker="S2" category="norm" type="a" display-name="S2 [norm]"><event start="TLI_1" end="TLI_2">(0.82) </event>
<event start="TLI_2" end="TLI_3">vorige Woche, </event>
<event start="TLI_3" end="TLI_4">da war das Korn bald reif, </event>
<event start="TLI_4" end="TLI_5">(0.73) </event>
<event start="TLI_5" end="TLI_6">da sind wir dann einmal in die Bach gefahren </event>
<event start="TLI_6" end="TLI_7">(0.22) </event>
<event start="TLI_7" end="TLI_8">und haben geguckt, </event>
<event start="TLI_8" end="TLI_9">wie es war. </event>
<event start="TLI_9" end="TLI_10">(0.73) </event>
<event start="TLI_10" end="TLI_11">hatte ja vorher vierzehn Tage geregnet, </event>
<event start="TLI_11" end="TLI_12">(2.02) </event>
<event start="TLI_12" end="TLI_13">und da kamen wir dann da herab, </event>
<event start="TLI_13" end="TLI_14">(0.67) </event>
<event start="TLI_14" end="TLI_15">und da sind wir dann erst mal </event>
<event start="TLI_15" end="TLI_16">hinten die Gräben herab gegangen </event>
<event start="TLI_16" end="TLI_17">(0.63) </event>
<event start="TLI_17" end="TLI_18">und haben die Körner probiert </event>
<event start="TLI_18" end="TLI_19">(0.58) </event>
<event start="TLI_19" end="TLI_20">und nach dem Stroh geguckt. </event>
<event start="TLI_20" end="TLI_21">(0.93) </event>
<event start="TLI_21" end="TLI_22">na, </event>
<event start="TLI_22" end="TLI_23">(0.6) </event>
<event start="TLI_23" end="TLI_24">das erste meinte mein Vater, </event>
<event start="TLI_24" end="TLI_25">es wäre noch nicht richtig, </event>
<event start="TLI_25" end="TLI_26">weil die Körner noch so weich waren. </event>
<event start="TLI_26" end="TLI_27">(1.68) </event>
<event start="TLI_27" end="TLI_28">aber </event>
<event start="TLI_28" end="TLI_29">dann haben wir es uns dann </event>
<event start="TLI_29" end="TLI_30">sind wir dann weiter herab gegangen </event>
<event start="TLI_30" end="TLI_31">und sahen dann doch, </event>
<event start="TLI_31" end="TLI_32">(0.67) </event>
<event start="TLI_32" end="TLI_33">dass das Stroh schon eigentlich reif war. </event>
<event start="TLI_33" end="TLI_34">(0.36) </event>
<event start="TLI_34" end="TLI_35">es war nämlich schon ganz gelb. </event>
<event start="TLI_35" end="TLI_36">(2.76) </event>
<event start="TLI_36" end="TLI_38">na, und da sind wir dann hinten am Bahndamm wieder heraufgegangen </event>
<event start="TLI_38" end="TLI_39">(0.81) </event>
<event start="TLI_39" end="TLI_40">und wo die Lager waren, </event>
<event start="TLI_40" end="TLI_41">(0.78) </event>
<event start="TLI_41" end="TLI_42">und da sahen wir dann, </event>
<event start="TLI_42" end="TLI_43">dass es manchmal schon ausgewachsen war, </event>
<event start="TLI_43" end="TLI_44">(0.24) </event>
<event start="TLI_44" end="TLI_45">wo es so auf Haufen zusammen lag. </event>
<event start="TLI_45" end="TLI_46">(1.77) </event>
<event start="TLI_46" end="TLI_47">das war aber noch ganz nass. </event>
<event start="TLI_47" end="TLI_48">wir konnten den Tag noch nichts machen. </event>
<event start="TLI_48" end="TLI_49">(1.32) </event>
<event start="TLI_49" end="TLI_50">na, </event>
<event start="TLI_50" end="TLI_51">(0.55) </event>
<event start="TLI_51" end="TLI_52">da sind wir dann den anderen Morgen wieder da herab gefahren </event>
<event start="TLI_52" end="TLI_53">(0.34) </event>
<event start="TLI_53" end="TLI_54">mit der Sense und Gulle </event>
<event start="TLI_54" end="TLI_55">(0.76) </event>
<event start="TLI_55" end="TLI_56">und haben dann erst mal angemäht.</event>
<event start="TLI_56" end="TLI_57">(0.2)</event>
<event start="TLI_57" end="TLI_59">na, dann haben wir Mittag haben wir den Binder geholt, </event>
<event start="TLI_59" end="TLI_60">das haben wir erst mal geschmiert </event>
<event start="TLI_60" end="TLI_61">(0.49) </event>
<event start="TLI_61" end="TLI_62">und zurecht gemacht, </event>
<event start="TLI_62" end="TLI_63">(2.02) </event>
<event start="TLI_63" end="TLI_64">und da hat es dann los gegangen. </event>
<event start="TLI_64" end="TLI_65">(0.78) </event>
<event start="TLI_65" end="TLI_66">da haben wir am Abend einmal hergemäht, </event>
<event start="TLI_66" end="TLI_67">dass wir besser einsetzen konnten an der Wiese her. </event>
<event start="TLI_67" end="TLI_68">(1.54) </event>
<event start="TLI_68" end="TLI_69">und dann haben wir alles quer raufgemäht. </event>
<event start="TLI_69" end="TLI_70">(2.4) </event>
<event start="TLI_70" end="TLI_72">na, es ging aber dann trotzdem ganz gut. </event>
<event start="TLI_72" end="TLI_73">(0.22) </event>
<event start="TLI_73" end="TLI_74">waren einzelne Lager, </event>
<event start="TLI_74" end="TLI_75">die ein bisschen verkehrt lagen, </event>
<event start="TLI_75" end="TLI_76">(1.05) </event>
<event start="TLI_76" end="TLI_77">aber wir haben es dann verhältnismäßig schnell abgekriegt. </event>
<event start="TLI_77" end="TLI_78">(0.6) </event>
<event start="TLI_78" end="TLI_79">abends kam der Suchi noch von den Mauser Werken, </event>
<event start="TLI_79" end="TLI_80">(0.27) </event>
