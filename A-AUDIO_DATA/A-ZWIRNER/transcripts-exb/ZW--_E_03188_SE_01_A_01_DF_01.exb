<tier id="TIE0" speaker="S2" category="lit" type="a" display-name="S2 [lit]"><event start="TLI_1" end="TLI_2">(0.82) </event>
<event start="TLI_2" end="TLI_3">fürje Woche, </event>
<event start="TLI_3" end="TLI_4">da woar dat Korn bale rive, </event>
<event start="TLI_4" end="TLI_5">(0.73) </event>
<event start="TLI_5" end="TLI_6">do si mer dann eimo in de Bach gefohrn </event>
<event start="TLI_6" end="TLI_7">(0.22) </event>
<event start="TLI_7" end="TLI_8">un hon gegoggen, </event>
<event start="TLI_8" end="TLI_9">wie s war. </event>
<event start="TLI_9" end="TLI_10">(0.73) </event>
<event start="TLI_10" end="TLI_11">hatte ji vorher värzehn Dohe geraint, </event>
<event start="TLI_11" end="TLI_12">(2.02) </event>
