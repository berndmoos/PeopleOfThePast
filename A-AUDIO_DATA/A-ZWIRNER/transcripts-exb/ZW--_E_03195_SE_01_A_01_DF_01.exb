<tier id="TIE0" speaker="S2" category="lit" type="a" display-name="S2 [lit]"><event start="TLI_1" end="TLI_2">(1.03) </event>
<event start="TLI_2" end="TLI_3">heute morjen bin ich umme fünfe ufgestün hon die Schuhe angezon. </event>
<event start="TLI_3" end="TLI_4">(0.71) </event>
<event start="TLI_4" end="TLI_5">un dann bin ich rausgeginge un, </event>
<event start="TLI_5" end="TLI_6">(0.58) </event>
<event start="TLI_6" end="TLI_7">Woan zurechde gemach, </event>
<event start="TLI_7" end="TLI_8">det Senset uf en Woaen, </event>
<event start="TLI_8" end="TLI_9">Gawel un d Rechen. </event>
<event start="TLI_9" end="TLI_10">(1.07) </event>
<event start="TLI_10" end="TLI_11">dann hon ich men Gol ufgeschärrt. </event>
<event start="TLI_11" end="TLI_12">bin ich in de Ense gefoahrn un </event>
<event start="TLI_12" end="TLI_13">(0.54) </event>
<event start="TLI_13" end="TLI_14">drei Morjen Klee gemäht. </event>
<event start="TLI_14" end="TLI_15">(0.86) </event>
<event start="TLI_15" end="TLI_16">die hon ich ufgeloden. </event>
<event start="TLI_16" end="TLI_17">(1.26) </event>
<event start="TLI_17" end="TLI_18">de Helmut, </event>
<event start="TLI_18" end="TLI_19">der wor u middeging </event>
<event start="TLI_19" end="TLI_20">der hat Karduffeln in der Zejt gegrowen; </event>
<event start="TLI_20" end="TLI_21">(1.08) </event>
<event start="TLI_21" end="TLI_22">Friehkarduffeln </event>
<event start="TLI_22" end="TLI_23">(0.96) </event>
<event start="TLI_23" end="TLI_24">kommen Lejd no ins, </event>
<event start="TLI_24" end="TLI_25">die hollen s sich pundswejse. </event>
<event start="TLI_25" end="TLI_26">(1.22) </event>
<event start="TLI_26" end="TLI_29">na, un dann, wie ich hem kom, </event>
<event start="TLI_29" end="TLI_30">hon ich ausgespannt. </event>
<event start="TLI_30" end="TLI_31">(1.1) </event>
<event start="TLI_31" end="TLI_33">bin ich ringeging, hon Kaffee getrungen. </event>
<event start="TLI_33" end="TLI_34">(0.83) </event>
<event start="TLI_34" end="TLI_35">wie ich dos gemacht hot, </event>
<event start="TLI_35" end="TLI_36">do han ich zwei Sensen gequor. </event>
<event start="TLI_36" end="TLI_37">(1.04) </event>
<event start="TLI_37" end="TLI_38">bin dann owen zum Goarten gegehn un hon Korn gemäht. </event>
<event start="TLI_38" end="TLI_39">das ligget platt, </event>
<event start="TLI_39" end="TLI_40">das kunn mer mit der Maschin nit mähen. </event>
<event start="TLI_40" end="TLI_41">(1.0) </event>
<event start="TLI_41" end="TLI_43">na, un ümme zähne, </event>
