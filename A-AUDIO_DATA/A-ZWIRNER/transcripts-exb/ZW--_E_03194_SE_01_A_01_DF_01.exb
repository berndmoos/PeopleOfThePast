<tier id="TIE3" speaker="S2" category="lit" type="a" display-name="S2 [lit]"><event start="TLI_1" end="TLI_2">(1.08) </event>
<event start="TLI_2" end="TLI_3">im Friehjaor werd de erscht draußen s Land bestallt. </event>
<event start="TLI_3" end="TLI_4">(0.49) </event>
<event start="TLI_4" end="TLI_5">dass ousgesät wern kann, </event>
<event start="TLI_5" end="TLI_6">(0.66) </event>
<event start="TLI_6" end="TLI_7">un das machen die Mannsläte mit de Sämaschine. </event>
<event start="TLI_7" end="TLI_8">(0.33) </event>
<event start="TLI_8" end="TLI_9">un des wird noch mit Pern gemacht, </event>
<event start="TLI_9" end="TLI_10">do bruen die Wejbsläit gar nit bi ze helfen. </event>
<event start="TLI_10" end="TLI_11">(1.11) </event>
<event start="TLI_11" end="TLI_13">un dann kimmet s Karduffenlpflanzen dron. </event>
<event start="TLI_13" end="TLI_14">(0.51) </event>
<event start="TLI_14" end="TLI_15">das müssen dann die Frauen mehrschdens machen. </event>
<event start="TLI_15" end="TLI_16">(0.27) </event>
<event start="TLI_16" end="TLI_17">die Männer, </event>
<event start="TLI_17" end="TLI_18">(0.78) </event>
<event start="TLI_18" end="TLI_19">die ziehen de Furen. </event>
<event start="TLI_19" end="TLI_20">(1.53) </event>
<event start="TLI_20" end="TLI_21">un </event>
<event start="TLI_21" end="TLI_22">(0.36) </event>
<event start="TLI_22" end="TLI_23">de Karduffeln, </event>
<event start="TLI_23" end="TLI_24">die laien dann die Frauen. </event>
<event start="TLI_24" end="TLI_25">(8.46) </event>
<event start="TLI_25" end="TLI_26">un dann kommen de Rungeln dron. </event>
<event start="TLI_26" end="TLI_27">(1.98) </event>
<event start="TLI_27" end="TLI_28">die laien au die Männer, </event>
<event start="TLI_28" end="TLI_29">do hon die Weibsläide wäider nix mit ze tune. </event>
<event start="TLI_29" end="TLI_30">aber das Verziehen, </event>
<event start="TLI_30" end="TLI_31">das mün die Frauen machen. </event>
<event start="TLI_31" end="TLI_32">(0.6) </event>
<event start="TLI_32" end="TLI_33">do helfen die Männer nit gerne bie. </event>
<event start="TLI_33" end="TLI_34">(9.85) </event>
<event start="TLI_42" end="TLI_43">dann wird gehacket, </event>
<event start="TLI_43" end="TLI_44">(0.37) </event>
<event start="TLI_44" end="TLI_45">un de erschtmo de Dickwurzeln wern dann gehacktet. </event>
<event start="TLI_45" end="TLI_46">(0.49) </event>
<event start="TLI_46" end="TLI_47">un dann wisst s immer wäder. </event>
<event start="TLI_47" end="TLI_48">dann kummen de Kartuffeln an de Riehe. </event>
<event start="TLI_48" end="TLI_49">(2.04) </event>
<event start="TLI_49" end="TLI_50">un dann allmählich, </event>
<event start="TLI_50" end="TLI_51">kimmet de Heiernde herbie. </event>
<event start="TLI_51" end="TLI_52">(1.5) </event>
<event start="TLI_52" end="TLI_53">wann hübsches Wetter is, </event>
<event start="TLI_53" end="TLI_54">dann geht s ja ganz schnell, </event>
<event start="TLI_54" end="TLI_55">(0.3) </event>
<event start="TLI_55" end="TLI_56">awer wenn s schlecht ist, </event>
<event start="TLI_56" end="TLI_57">äh is es sehr lankweilich mit em Heimachen. </event>
<event start="TLI_57" end="TLI_58">(1.2) </event>
<event start="TLI_58" end="TLI_59">un dann ist ne kurze Pause und dann geht s schon </event>
<event start="TLI_59" end="TLI_60">(0.63) </event>
<event start="TLI_60" end="TLI_62">ans Getrei/ an de Frochternde.</event>
<event start="TLI_62" end="TLI_63">(2.44) </event>
<event start="TLI_63" end="TLI_64">dann wird gebindert </event>
<event start="TLI_64" end="TLI_65">(1.26) </event>
<event start="TLI_65" end="TLI_66">un </event>
<event start="TLI_66" end="TLI_67">(0.67) </event>
<event start="TLI_67" end="TLI_68">die Frauen mün dann ufstellen. </event>
<event start="TLI_68" end="TLI_69">(8.01) </event>
<event start="TLI_69" end="TLI_70">un dann ungefähr acht Doche steht dann die Frocht draußen un dann werd se ingefahrn </event>
<event start="TLI_70" end="TLI_71">(0.31) </event>
<event start="TLI_71" end="TLI_72">un gleich gedroschen. </event>
<event start="TLI_72" end="TLI_73">(1.17) </event>
<event start="TLI_73" end="TLI_74">die Bürn helfen sich ungernanner mit Dreschen </event>
<event start="TLI_74" end="TLI_75">(0.69) </event>
<event start="TLI_75" end="TLI_76">un </event>
<event start="TLI_76" end="TLI_77">(2.95) </event>
<event start="TLI_77" end="TLI_78">s müssen nämmich ville Läid dobie helfen. </event>
<event start="TLI_78" end="TLI_79">(1.77) </event>
<event start="TLI_79" end="TLI_80">in villn Därfern sin aber au schun Mähdrescher. </event>
<event start="TLI_80" end="TLI_81">awer no nit überall. </event>
<event start="TLI_81" end="TLI_82">das is ne große Erleichterung. </event>
<event start="TLI_82" end="TLI_83">(0.49) </event>
<event start="TLI_83" end="TLI_84">dann bruch s nit erscht ingefahrn zu wern, </event>
<event start="TLI_84" end="TLI_85">(0.82) </event>
<event start="TLI_85" end="TLI_86">un na ja, </event>
<event start="TLI_86" end="TLI_87">(1.65) </event>
<event start="TLI_87" end="TLI_88">s kostet aber allerhand. </event>
<event start="TLI_88" end="TLI_89">(1.44) </event>
<event start="TLI_89" end="TLI_90">awer es kimmet doch uf ens raus </event>
<event start="TLI_90" end="TLI_91">(0.24) </event>
<event start="TLI_91" end="TLI_92">wa me </event>
<event start="TLI_92" end="TLI_93">(0.37) </event>
<event start="TLI_93" end="TLI_94">s Essen un alles bim Maschinen rechnet. </event>
<event start="TLI_94" end="TLI_95">(3.96) </event>
<event start="TLI_102" end="TLI_103">mojns, </event>
<event start="TLI_103" end="TLI_104">de ärschde, </event>
<event start="TLI_104" end="TLI_105">geht s in n Stall. </event>
<event start="TLI_105" end="TLI_106">(0.6) </event>
<event start="TLI_106" end="TLI_107">dann wird gemulken </event>
<event start="TLI_107" end="TLI_108">(0.76) </event>
<event start="TLI_108" end="TLI_109">un gemestet. </event>
<event start="TLI_109" end="TLI_110">(0.18) </event>
<event start="TLI_110" end="TLI_111">de Kiwwe, </event>
<event start="TLI_111" end="TLI_112">(0.22) </event>
<event start="TLI_112" end="TLI_113">de bläibn den Dog iwer drinne. </event>
<event start="TLI_113" end="TLI_114">(0.36) </event>
<event start="TLI_114" end="TLI_115">die treim mer jetz de Nacht raus, </event>
<event start="TLI_115" end="TLI_116">weil die Fliejen so scheimm sin. </event>
<event start="TLI_116" end="TLI_117">(1.08) </event>
<event start="TLI_117" end="TLI_118">un dann </event>
<event start="TLI_118" end="TLI_119">(1.62) </event>
<event start="TLI_119" end="TLI_120">wann s draußen etwas abgetrit is  </event>
<event start="TLI_120" end="TLI_121">alleweil is ja noch so ville Tau uf em Felle, </event>
<event start="TLI_121" end="TLI_122">(1.23) </event>
<event start="TLI_122" end="TLI_123">dann </event>
<event start="TLI_123" end="TLI_124">(2.05) </event>
<event start="TLI_124" end="TLI_125">geht s raus un wird ingefohren. </event>
<event start="TLI_125" end="TLI_126">(1.08) </event>
<event start="TLI_126" end="TLI_127">alleweil is ja de Haupternde </event>
<event start="TLI_127" end="TLI_128">(1.08) </event>
<event start="TLI_128" end="TLI_129">un de Leude fahrn alle in. </event>
<event start="TLI_129" end="TLI_130">(0.75) </event>
<event start="TLI_130" end="TLI_131">jetz schon Korn </event>
<event start="TLI_131" end="TLI_132">(0.47) </event>
<event start="TLI_132" end="TLI_133">un dann kimmet der Wes dron. </event>
<event start="TLI_133" end="TLI_134">(1.06) </event>
<event start="TLI_134" end="TLI_135">un n Owed, </event>
<event start="TLI_135" end="TLI_136">(0.31) </event>
<event start="TLI_136" end="TLI_137">noher werd abgeloden. </event>
<event start="TLI_137" end="TLI_138">(0.48) </event>
<event start="TLI_138" end="TLI_139">und n Owed wenn </event>
<event start="TLI_139" end="TLI_140">(0.73) </event>
<event start="TLI_140" end="TLI_141">me </event>
<event start="TLI_141" end="TLI_142">(0.54) </event>
<event start="TLI_142" end="TLI_143">s wird allewäil etwas späda </event>
<event start="TLI_143" end="TLI_144">(0.19) </event>
<event start="TLI_144" end="TLI_145">dann werd gefüttert un gemolken. </event>
<event start="TLI_145" end="TLI_146">(0.48) </event>
<event start="TLI_146" end="TLI_147">un dann kommen die Kiwwe raus. </event>
<event start="TLI_147" end="TLI_148">(6.6) </event>
<event start="TLI_154" end="TLI_155">das fängt schon n Sunnowed aan. </event>
<event start="TLI_155" end="TLI_156">(0.57) </event>
<event start="TLI_156" end="TLI_157">en </event>
<event start="TLI_157" end="TLI_158">(1.06) </event>
<event start="TLI_158" end="TLI_159">Nomittag </event>
<event start="TLI_159" end="TLI_160">(0.3) </event>
<event start="TLI_160" end="TLI_161">geht de Kabelle schon rüm un spellt vor jeden Haus en Ständchen. </event>
<event start="TLI_161" end="TLI_162">(0.93) </event>
<event start="TLI_162" end="TLI_164">un en Owed dann geht s uf en Sool. </event>
<event start="TLI_164" end="TLI_165">die ganze Juchend </event>
<event start="TLI_165" end="TLI_166">(0.43) </event>
<event start="TLI_166" end="TLI_167">versammelt sich do un dann wird schon gedanzt bis zen annern Morjen. </event>
<event start="TLI_167" end="TLI_168">(1.45) </event>
<event start="TLI_168" end="TLI_169">un dann, </event>
<event start="TLI_169" end="TLI_170">(0.55) </event>
<event start="TLI_170" end="TLI_171">n Sunndagmittag, </event>
<event start="TLI_171" end="TLI_172">is der Kirmeszock. </event>
<event start="TLI_172" end="TLI_173">(1.08) </event>
<event start="TLI_173" end="TLI_174">so, </event>
<event start="TLI_174" end="TLI_175">(0.36) </event>
<event start="TLI_175" end="TLI_176">da geht erste die ganze Juchend bie. </event>
<event start="TLI_176" end="TLI_177">(1.15) </event>
<event start="TLI_177" end="TLI_178">die </event>
<event start="TLI_178" end="TLI_179">(2.34) </event>
<event start="TLI_179" end="TLI_180">die Kirmesborschen, </event>
<event start="TLI_180" end="TLI_181">(0.58) </event>
<event start="TLI_181" end="TLI_182">die veranstalden das un die </event>
<event start="TLI_182" end="TLI_183">(0.66) </event>
<event start="TLI_183" end="TLI_184">richten das so alles so in. </event>
<event start="TLI_184" end="TLI_185">(1.26) </event>
<event start="TLI_185" end="TLI_186">das is mehrschdens so n Wan, </event>
<event start="TLI_186" end="TLI_187">(0.3) </event>
<event start="TLI_187" end="TLI_188">wie früher die Spennstuwwe war, </event>
<event start="TLI_188" end="TLI_189">was jo allewäil nit mie es. </event>
<event start="TLI_189" end="TLI_190">(0.96) </event>
<event start="TLI_190" end="TLI_191">un </event>
<event start="TLI_191" end="TLI_192">(0.7) </event>
<event start="TLI_192" end="TLI_193">dann von der Ernte </event>
<event start="TLI_193" end="TLI_194">(0.45) </event>
<event start="TLI_194" end="TLI_195">un dann noch so n bisschen was Lostijes. </event>
<event start="TLI_195" end="TLI_196">da is en Clon dabie. </event>
<event start="TLI_196" end="TLI_197">(1.59) </event>
<event start="TLI_197" end="TLI_198">un en Owed dann, </event>
<event start="TLI_198" end="TLI_199">n Nomiddag is es dann anschließend Danz, </event>
<event start="TLI_199" end="TLI_200">wann der Zuck därch is. </event>
<event start="TLI_200" end="TLI_201">(0.34) </event>
<event start="TLI_201" end="TLI_203">un dann is Pause. </event>
<event start="TLI_203" end="TLI_204">wird gegessen </event>
<event start="TLI_204" end="TLI_205">(0.25) </event>
<event start="TLI_205" end="TLI_206">un n Owed geht s widder wäjler. </event>
<event start="TLI_206" end="TLI_207">ongefähr üme siwwene fänget s widder aan. </event>
<event start="TLI_207" end="TLI_208">(0.78) </event>
<event start="TLI_208" end="TLI_209">un dann ö bis en annern Morjn. </event>
<event start="TLI_209" end="TLI_210">(2.28) </event>
<event start="TLI_210" end="TLI_211">mit hauptsächlich is des </event>
<event start="TLI_211" end="TLI_212">(0.19) </event>
<event start="TLI_212" end="TLI_213">Tanz, </event>
<event start="TLI_213" end="TLI_214">ne? </event>
<event start="TLI_214" end="TLI_215">(6.19) </event>
<event start="TLI_217" end="TLI_218">ja. </event>
<event start="TLI_218" end="TLI_219">(1.17) </event>
<event start="TLI_222" end="TLI_224">oh jo, des geht immer zu. </event>
<event start="TLI_224" end="TLI_225">(0.63) </event>
<event start="TLI_225" end="TLI_226">dann wird gesorjt, </event>
<event start="TLI_226" end="TLI_227">dass die Sachen widder all in Ordnung kummen. </event>
<event start="TLI_227" end="TLI_228">die Frauen nähen un die Männer beschäftigen sich draußen, </event>
<event start="TLI_228" end="TLI_229">machen de Maschinen wieder in Ordnung, </event>
<event start="TLI_229" end="TLI_230">(0.36) </event>
<event start="TLI_230" end="TLI_231">wo s im Summer net so vele Zejt zu hon. </event>
<event start="TLI_231" end="TLI_232">(0.18) </event>
<event start="TLI_232" end="TLI_233">un in Stalle is dann mehr Arwet, </event>
<event start="TLI_233" end="TLI_234">weil s Vieh all in Stalle es. </event>
<event start="TLI_234" end="TLI_235">(2.28) </event>
<event start="TLI_235" end="TLI_238">un wann, wann s nit so arch kalt is, </event>
<event start="TLI_238" end="TLI_239">un nit so ville Schnai liegt, </event>
<event start="TLI_239" end="TLI_240">dann werd Mest gefohren. </event>
<event start="TLI_240" end="TLI_241">(1.53) </event>
<event start="TLI_241" end="TLI_242">das nimmt dann schon e paar Doch in Anspruch. </event>
<event start="TLI_242" end="TLI_243">(4.54) </event>
<event start="TLI_243" end="TLI_244">im Herwest </event>
<event start="TLI_244" end="TLI_245">wann nachher hübsches Wetter is dann</event>
<event start="TLI_245" end="TLI_246">(0.43) </event>
<event start="TLI_246" end="TLI_247">sorjen se schun dafür, dass se </event>
<event start="TLI_247" end="TLI_248">(0.69) </event>
<event start="TLI_248" end="TLI_249">zimmlich vele geackert hon. </event>
<event start="TLI_249" end="TLI_250">(0.33) </event>
<event start="TLI_250" end="TLI_251">dass s im Friehjohr nit mehr so vele git. </event>
<event start="TLI_251" end="TLI_252">(4.29) </event>
<event start="TLI_262" end="TLI_263">ja, </event>
<event start="TLI_263" end="TLI_264">(0.64) </event>
<event start="TLI_264" end="TLI_265">mo/ morjns en Kaffe, </event>
<event start="TLI_265" end="TLI_266">s Essen, </event>
<event start="TLI_266" end="TLI_267">da muss se doch alle fir sorjen, </event>
<event start="TLI_267" end="TLI_268">(0.88) </event>
<event start="TLI_268" end="TLI_269">un dann die Kinder versorjen, </event>
<event start="TLI_269" end="TLI_270">(0.18) </event>
<event start="TLI_270" end="TLI_271">wäschen, </event>
<event start="TLI_271" end="TLI_272">(1.32) </event>
<event start="TLI_272" end="TLI_273">ja s Kochen, </event>
<event start="TLI_273" end="TLI_274">(1.29) </event>
<event start="TLI_274" end="TLI_275">un dann muss se immer noch mitte rous. </event>
<event start="TLI_275" end="TLI_276">(0.91) </event>
<event start="TLI_276" end="TLI_277">bin Heimachen muss se helfen, </event>
<event start="TLI_277" end="TLI_278">wie ich jetz bin. </event>
<event start="TLI_278" end="TLI_279">(0.75) </event>
<event start="TLI_279" end="TLI_280">bie de Ernde </event>
<event start="TLI_280" end="TLI_281">(1.54) </event>
<event start="TLI_281" end="TLI_282">un  </event>
<event start="TLI_282" end="TLI_283">(2.62) </event>
<event start="TLI_283" end="TLI_284">also von Frühjahr aan muss se do eijentlich dauernd mit eraus. </event>
<event start="TLI_284" end="TLI_285">(0.19) </event>
<event start="TLI_285" end="TLI_286">bin Hacken, </event>
<event start="TLI_286" end="TLI_287">muss do immer helfen. </event>
<event start="TLI_287" end="TLI_288">(3.15) </event>
<event start="TLI_296" end="TLI_297">mer hon ejentlich gor nit vill Zejt gehat zum spieln. </event>
<event start="TLI_297" end="TLI_298">(0.57) </event>
<event start="TLI_298" end="TLI_299">mer mussden schon immer frieh mit eraus un helfen. </event>
<event start="TLI_299" end="TLI_300">(1.45) </event>
<event start="TLI_300" end="TLI_301">dann/ manchmal hom mer Sichen gespelt so unnernanner, </event>
<event start="TLI_301" end="TLI_302">wa mer Zejt hatten. </event>
<event start="TLI_302" end="TLI_303">(0.81) </event>
<event start="TLI_303" end="TLI_304">awer vele Zejt blejb nit dofier. </event>
<event start="TLI_304" end="TLI_305">so lichte Arweten, </event>
<event start="TLI_305" end="TLI_306">die mir machen künnten, </event>
<event start="TLI_306" end="TLI_307">musst mer schun immer helfen. </event>
<event start="TLI_307" end="TLI_308">(0.93) </event>
<event start="TLI_310" end="TLI_312">doch, im Wender dann veranstaltet de Gesangverein </event>
<event start="TLI_312" end="TLI_313">en gemischter Chor is hie  </event>
<event start="TLI_313" end="TLI_314">(0.34) </event>
