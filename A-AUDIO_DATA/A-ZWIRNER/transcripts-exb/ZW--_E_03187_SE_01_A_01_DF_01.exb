<tier id="TIE0" speaker="S1" category="lit" type="a" display-name="S1 [lit]"><event start="TLI_1" end="TLI_2">(1.02) </event>
<event start="TLI_2" end="TLI_4">also, mer sin jetz in de Ernde. </event>
<event start="TLI_4" end="TLI_5">(0.42) </event>
<event start="TLI_5" end="TLI_6">habbe mit dem Korn ahngefangen.</event>
<event start="TLI_6" end="TLI_8">na, zum Deil is ach schun Weize abgemacht, </event>
<event start="TLI_8" end="TLI_9">(0.81) </event>
<event start="TLI_9" end="TLI_11">na, tum Deil a Haver. </event>
<event start="TLI_11" end="TLI_12">(0.54) </event>
<event start="TLI_12" end="TLI_13">abr, </event>
<event start="TLI_13" end="TLI_14">(1.17) </event>
<event start="TLI_14" end="TLI_16">na, ich ze Hause, </event>
<event start="TLI_16" end="TLI_17">ich hon noch dn Weizen halb stehn. </event>
<event start="TLI_17" end="TLI_18">(1.3) </event>
<event start="TLI_18" end="TLI_19">un  </event>
<event start="TLI_19" end="TLI_20">(0.58) </event>
<event start="TLI_20" end="TLI_21">well morjen, well ich </event>
<event start="TLI_21" end="TLI_22">(0.31) </event>
<event start="TLI_22" end="TLI_23">den Rest abmachen, </event>
<event start="TLI_23" end="TLI_24">(0.39) </event>
<event start="TLI_24" end="TLI_25">na un de Haver is noch grüne. </event>
<event start="TLI_25" end="TLI_26">(1.3) </event>
<event start="TLI_26" end="TLI_27">abr, </event>
<event start="TLI_27" end="TLI_28">(0.54) </event>
<event start="TLI_28" end="TLI_30">na, värzenn Dahe werd s noch duren, </event>
<event start="TLI_30" end="TLI_31">(0.35) </event>
<event start="TLI_31" end="TLI_32">bis der Haver au so wit is, </event>
<event start="TLI_32" end="TLI_33">dass er abgemacht kann werden. </event>
<event start="TLI_33" end="TLI_34">(0.55) </event>
<event start="TLI_34" end="TLI_36">na, in de Zwischenziet fohre mer dann Korn. </event>
<event start="TLI_36" end="TLI_37">(0.52) </event>
<event start="TLI_37" end="TLI_38">fohren Weiße, </event>
<event start="TLI_38" end="TLI_39">(0.22) </event>
<event start="TLI_39" end="TLI_40">na, </event>
<event start="TLI_40" end="TLI_41">(1.14) </event>
<event start="TLI_41" end="TLI_42">und wa es da so gibt alles uf dr Landwertschaft. </event>
<event start="TLI_42" end="TLI_43">(0.54) </event>
<event start="TLI_43" end="TLI_44">na,</event>
<event start="TLI_44" end="TLI_45">(1.63) </event>
<event start="TLI_45" end="TLI_46">we mer</event>
<event start="TLI_46" end="TLI_47">(0.73) </event>
<event start="TLI_47" end="TLI_48">so hat mer jo au sine Arweit. </event>
<event start="TLI_48" end="TLI_49">(1.56) </event>
<event start="TLI_49" end="TLI_50">we mer </event>
<event start="TLI_50" end="TLI_51">(0.63) </event>
<event start="TLI_51" end="TLI_52">nu an de Ernte nix kann machen </event>
<event start="TLI_52" end="TLI_53">dann ma/ mäh mer Krummit </event>
<event start="TLI_53" end="TLI_54">(1.03) </event>
<event start="TLI_54" end="TLI_55">un </event>
<event start="TLI_55" end="TLI_56">(0.33) </event>
<event start="TLI_56" end="TLI_57">Klee. </event>
<event start="TLI_57" end="TLI_58">Klee muss ab un muss uf de Bögge gemacht wern. </event>
<event start="TLI_58" end="TLI_59">(1.08) </event>
<event start="TLI_59" end="TLI_61">na, in der Zeit ka mer des Korn heim fohrn. </event>
<event start="TLI_61" end="TLI_62">(1.6) </event>
<event start="TLI_62" end="TLI_64">na, we mer s ziemlich drheim hon, </event>
<event start="TLI_64" end="TLI_65">(0.55) </event>
<event start="TLI_65" end="TLI_66">dann fänget die Maschinerei geht los, </event>
<event start="TLI_66" end="TLI_67">(0.66) </event>
<event start="TLI_67" end="TLI_68">un, </event>
<event start="TLI_68" end="TLI_69">(1.56) </event>
<event start="TLI_69" end="TLI_71">na, so geht eins no en anderen. </event>
<event start="TLI_71" end="TLI_72">(1.2) </event>
<event start="TLI_72" end="TLI_73">awr </event>
<event start="TLI_73" end="TLI_74">(8.76) </event>
<event start="TLI_79" end="TLI_82">na ja, vom Friehjohr, na, </event>
<event start="TLI_82" end="TLI_83">(0.99) </event>
<event start="TLI_83" end="TLI_84">vom Friehjohr, </event>
<event start="TLI_84" end="TLI_85">wann s los geht, </event>
<event start="TLI_85" end="TLI_87">na, bis immer de Ländereien alles träge is, </event>
<event start="TLI_87" end="TLI_88">in der Zit, </event>
<event start="TLI_88" end="TLI_89">na, </event>
<event start="TLI_89" end="TLI_90">(0.6) </event>
<event start="TLI_90" end="TLI_91">da hot mer Mist ze fohren, Weide ze flicken, </event>
<event start="TLI_91" end="TLI_92">(2.13) </event>
<event start="TLI_92" end="TLI_93">un disse ganzen Sachen. </event>
<event start="TLI_93" end="TLI_94">(0.6) </event>
<event start="TLI_94" end="TLI_95">Arweit gibt s jo immer, </event>
<event start="TLI_95" end="TLI_96">(0.55) </event>
<event start="TLI_96" end="TLI_97">we mer nur was machen will. </event>
<event start="TLI_97" end="TLI_98">(2.22) </event>
<event start="TLI_98" end="TLI_99">na, </event>
<event start="TLI_99" end="TLI_100">(1.05) </event>
<event start="TLI_100" end="TLI_101">wenn das dann da därch is, </event>
<event start="TLI_101" end="TLI_102">(0.45) </event>
<event start="TLI_102" end="TLI_103">dann geht des </event>
<event start="TLI_103" end="TLI_104">(1.54) </event>
<event start="TLI_104" end="TLI_105">Haversäen los. </event>
<event start="TLI_105" end="TLI_106">(1.24) </event>
<event start="TLI_106" end="TLI_107">dann wern Dickwurzelgerner gelait.</event>
<event start="TLI_107" end="TLI_108">(0.7) </event>
<event start="TLI_108" end="TLI_109">Karduffeln geplanzt, </event>
<event start="TLI_109" end="TLI_110">(0.93) </event>
<event start="TLI_110" end="TLI_111">un, </event>
<event start="TLI_111" end="TLI_112">(2.23) </event>
<event start="TLI_112" end="TLI_113">na, </event>
<event start="TLI_113" end="TLI_114">bis das alles so wit is, </event>
<event start="TLI_114" end="TLI_115">(0.21) </event>
<event start="TLI_115" end="TLI_116">ka mer aanfangen ze hacken </event>
<event start="TLI_116" end="TLI_117">(0.46) </event>
<event start="TLI_117" end="TLI_118">an n Dickworzeln </event>
<event start="TLI_118" end="TLI_119">(1.89) </event>
<event start="TLI_119" end="TLI_120">un dann muss mer se dinne ruppen. </event>
<event start="TLI_120" end="TLI_121">Kardoffeln </event>
<event start="TLI_121" end="TLI_122">(0.84) </event>
<event start="TLI_122" end="TLI_123">muss mer häuveln. </event>
<event start="TLI_123" end="TLI_124">(2.49) </event>
<event start="TLI_124" end="TLI_126">na, in der Zit geht s dann mit der Ernde los. </event>
<event start="TLI_126" end="TLI_127">(1.75) </event>
<event start="TLI_129" end="TLI_131">na, dann kimmet dann die Erndearbeit. </event>
<event start="TLI_131" end="TLI_132">wann dat alles </event>
<event start="TLI_132" end="TLI_133">et Korn un de Haver un de Weizen </event>
<event start="TLI_133" end="TLI_134">alles daheim is, </event>
<event start="TLI_134" end="TLI_136">na, dann geht s dann so langsam mit der </event>
<event start="TLI_136" end="TLI_137">(0.7) </event>
<event start="TLI_137" end="TLI_138">Hackfruchternde los. </event>
<event start="TLI_138" end="TLI_139">(1.63) </event>
<event start="TLI_139" end="TLI_140">na, </event>
<event start="TLI_140" end="TLI_141">(1.03) </event>
<event start="TLI_141" end="TLI_142">we mer do  </event>
<event start="TLI_142" end="TLI_143">hoffentlich kriege mer diss Johr nit wirrer so schlechtes Wetter wie firjs Johr. </event>
<event start="TLI_143" end="TLI_144">(1.96) </event>
<event start="TLI_144" end="TLI_145">do hadden mir ja böses Wedder. </event>
<event start="TLI_145" end="TLI_146">(2.79) </event>
<event start="TLI_146" end="TLI_147">nämmich, </event>
<event start="TLI_147" end="TLI_148">(0.36) </event>
<event start="TLI_148" end="TLI_149">do wussde mir jo nix vun/ us de Erde zu kriejen un wussden nix an de Erde ze kriejen. </event>
<event start="TLI_149" end="TLI_150">(0.54) </event>
<event start="TLI_150" end="TLI_152">na, awer anscheinend no wird s doch diss Johr en bisschen besser. </event>
<event start="TLI_152" end="TLI_153">(1.62) </event>
<event start="TLI_153" end="TLI_154">we mer </event>
<event start="TLI_154" end="TLI_155">(0.4) </event>
<event start="TLI_155" end="TLI_156">we mer nu mit ere </event>
<event start="TLI_156" end="TLI_157">(0.9) </event>
<event start="TLI_157" end="TLI_158">mit de Hackfruchternde aanfangn,</event>
<event start="TLI_158" end="TLI_159">un dann wern Dickwurzeln usgemacht. </event>
<event start="TLI_159" end="TLI_160">dann geht es von morjen frieh bis in Owet, </event>
<event start="TLI_160" end="TLI_161">wo s dungel is. </event>
<event start="TLI_161" end="TLI_162">(1.05) </event>
<event start="TLI_162" end="TLI_163">un Karduffeln au un dann owen die Wore noch abladen. </event>
<event start="TLI_163" end="TLI_164">(0.18) </event>
<event start="TLI_164" end="TLI_165">ach, </event>
<event start="TLI_165" end="TLI_166">das is immer </event>
<event start="TLI_166" end="TLI_167">(0.45) </event>
<event start="TLI_167" end="TLI_168">nee </event>
<event start="TLI_168" end="TLI_169">(1.25) </event>
<event start="TLI_169" end="TLI_170">ja, </event>
<event start="TLI_170" end="TLI_171">(1.09) </event>
<event start="TLI_171" end="TLI_172">also leicht ir es nit. </event>
<event start="TLI_172" end="TLI_173">(1.06) </event>
<event start="TLI_173" end="TLI_174">man hot schon sine Arweit. </event>
<event start="TLI_174" end="TLI_175">(0.43) </event>
<event start="TLI_175" end="TLI_177">na, un bis dann wieder alles usgesät is! </event>
<event start="TLI_177" end="TLI_178">(0.61) </event>
<event start="TLI_178" end="TLI_179">in der Zit is es dann fäng et aan ze frieren. </event>
<event start="TLI_179" end="TLI_180">(0.76) </event>
<event start="TLI_180" end="TLI_181">wenn s gefroren is, </event>
<event start="TLI_181" end="TLI_182">dann hat mer daheim auch sine Hausarweit! </event>
<event start="TLI_182" end="TLI_183">(1.72) </event>
<event start="TLI_183" end="TLI_184">un </event>
<event start="TLI_184" end="TLI_185">(1.11) </event>
<event start="TLI_185" end="TLI_186">dann gibt s allerhand. </event>
<event start="TLI_186" end="TLI_187">dann wird wirrer Mist gefohren, </event>
<event start="TLI_187" end="TLI_188">(0.45) </event>
<event start="TLI_188" end="TLI_189">Mist gestreut, </event>
<event start="TLI_189" end="TLI_190">ungergeaggert, </event>
<event start="TLI_190" end="TLI_191">(0.63) </event>
<event start="TLI_191" end="TLI_192">un dann geht des ganze wirrer von vorne los. </event>
<event start="TLI_192" end="TLI_193">(3.06) </event>
<event start="TLI_195" end="TLI_196">die Frauen hon auch ihre Arbeit. </event>
<event start="TLI_196" end="TLI_197">(1.29) </event>
<event start="TLI_197" end="TLI_199">na, wann die morjen frieh, </event>
<event start="TLI_199" end="TLI_200">wann ufgestiejen wird, </event>
<event start="TLI_200" end="TLI_201">wird gemolgen, </event>
<event start="TLI_201" end="TLI_202">(0.79) </event>
<event start="TLI_202" end="TLI_203">dann wird </event>
<event start="TLI_203" end="TLI_204">(0.67) </event>
<event start="TLI_204" end="TLI_206">futtern die Frauen, futtern die Schweine, </event>
<event start="TLI_206" end="TLI_207">(0.7) </event>
<event start="TLI_207" end="TLI_208">helfen misten, </event>
<event start="TLI_208" end="TLI_209">(1.6) </event>
<event start="TLI_209" end="TLI_211">na, dann wird Kaffee getrungen, </event>
<event start="TLI_211" end="TLI_212">(1.32) </event>
<event start="TLI_212" end="TLI_214">na, un dann geht s weider. </event>
<event start="TLI_214" end="TLI_215">(0.9) </event>
<event start="TLI_215" end="TLI_217">na, d/ fangen se aan, </event>
<event start="TLI_217" end="TLI_218">de Milchkannen, </event>
<event start="TLI_218" end="TLI_219">wirrer ze waschen. </event>
<event start="TLI_219" end="TLI_220">(1.54) </event>
<event start="TLI_220" end="TLI_221">na, </event>
<event start="TLI_221" end="TLI_222">(0.78) </event>
<event start="TLI_222" end="TLI_223">wenn das rum is, </event>
<event start="TLI_223" end="TLI_224">is Mittagessen, </event>
<event start="TLI_224" end="TLI_225">muss gemacht wern. </event>
<event start="TLI_225" end="TLI_226">(1.98) </event>
<event start="TLI_226" end="TLI_227">un wenn dann äh </event>
<event start="TLI_227" end="TLI_228">(1.17) </event>
<event start="TLI_228" end="TLI_229">Nomiddag dann flicken se wirrer en bisschen. </event>
<event start="TLI_229" end="TLI_230">(0.88) </event>
<event start="TLI_230" end="TLI_231">un dann äs es schon wieder Owen zum Futtern. </event>
<event start="TLI_231" end="TLI_232">(0.18) </event>
<event start="TLI_232" end="TLI_233">dann geht s wirrer los. </event>
<event start="TLI_233" end="TLI_234">(0.44) </event>
<event start="TLI_234" end="TLI_235">werd wirrer gefuttert, </event>
<event start="TLI_235" end="TLI_236">gemolken, </event>
<event start="TLI_236" end="TLI_237">Schwine gefuttert, </event>
<event start="TLI_237" end="TLI_238">(1.02) </event>
<event start="TLI_238" end="TLI_239">Owedessen gemacht. </event>
<event start="TLI_239" end="TLI_240">(1.08) </event>
<event start="TLI_240" end="TLI_241">na, </event>
<event start="TLI_241" end="TLI_242">bis mer dann ins Bedde geht.</event>
<event start="TLI_242" end="TLI_243">(0.61) </event>
<event start="TLI_245" end="TLI_247">eija, im Wender is es wohl nit so schlimm. </event>
<event start="TLI_247" end="TLI_248">(1.21) </event>
<event start="TLI_248" end="TLI_249">im Winder is s nit so schlimm. </event>
<event start="TLI_249" end="TLI_250">im Sommer im Sommer mussen se ja immer genau so vill wie de Mann </event>
<event start="TLI_250" end="TLI_251">(0.3) </event>
<event start="TLI_251" end="TLI_252">leisten. </event>
<event start="TLI_252" end="TLI_253">(1.71) </event>
