<tier id="TIE0" speaker="S2" category="lit" type="a" display-name="S2 [lit]"><event start="TLI_1" end="TLI_2">(0.76) </event>
<event start="TLI_2" end="TLI_3">wi i noch in die Schule gink, </event>
<event start="TLI_3" end="TLI_4">(0.49) </event>
<event start="TLI_4" end="TLI_5">da gab s noch keine Ejsenbahne. </event>
<event start="TLI_5" end="TLI_6">(1.45) </event>
<event start="TLI_6" end="TLI_7">die nä/ nächste Bahnstation war Wege, </event>
<event start="TLI_7" end="TLI_8">(0.94) </event>
<event start="TLI_8" end="TLI_9">do müssten mer immer hinfahre, </event>
<event start="TLI_9" end="TLI_10">(0.9) </event>
<event start="TLI_10" end="TLI_11">musst mer dn Düngr holen. </event>
<event start="TLI_11" end="TLI_12">(1.3) </event>
<event start="TLI_12" end="TLI_14">na, do woar joa no nit so vill gestruwet wie jetz, </event>
<event start="TLI_14" end="TLI_16">jetz wär das ja alles unmägelich, ne, </event>
<event start="TLI_16" end="TLI_17">(0.49) </event>
<event start="TLI_17" end="TLI_18">kunnde mir gar nit. </event>
<event start="TLI_18" end="TLI_19">(0.58) </event>
<event start="TLI_19" end="TLI_20">musst mer de Frucht hinbringen, </event>
<event start="TLI_20" end="TLI_21">dat warn das immer so Weje. </event>
<event start="TLI_21" end="TLI_22">(0.48) </event>
<event start="TLI_22" end="TLI_23">awer dos </event>
<event start="TLI_23" end="TLI_24">do kannte mir </event>
<event start="TLI_24" end="TLI_25">(0.21) </event>
<event start="TLI_25" end="TLI_26">do wa/ kam dat Dingerstruwen ene sa on. </event>
<event start="TLI_26" end="TLI_27">(0.58) </event>
<event start="TLI_27" end="TLI_28">das erschde was mi struweten, </event>
<event start="TLI_28" end="TLI_29">(0.34) </event>
<event start="TLI_29" end="TLI_30">das war Guano </event>
<event start="TLI_30" end="TLI_31">(0.93) </event>
<event start="TLI_31" end="TLI_32">un da sait dr Vatr immer: </event>
<event start="TLI_32" end="TLI_33">dami wulln mer die Karduffele strowe ne  </event>
<event start="TLI_33" end="TLI_34">dass äh, </event>
<event start="TLI_34" end="TLI_35">dadoch kriechden dann de gude Karduffeln hier. </event>
<event start="TLI_35" end="TLI_36">(0.91) </event>
<event start="TLI_36" end="TLI_37">und dann/ dann gab s Chilesalbeter. </event>
<event start="TLI_37" end="TLI_38">(0.6) </event>
<event start="TLI_38" end="TLI_39">och un da kame so schwere Säcke. </event>
<event start="TLI_39" end="TLI_40">die Säcke woarn alle so unglichmäßig. </event>
<event start="TLI_40" end="TLI_41">in en Sacke waren </event>
<event start="TLI_41" end="TLI_42">(0.21) </event>
<event start="TLI_42" end="TLI_43">twei Zentner, </event>
<event start="TLI_43" end="TLI_44">in em anneren waren dat drei, </event>
<event start="TLI_44" end="TLI_45">un dann nuche mol. </event>
<event start="TLI_45" end="TLI_46">dann ward et so scho in e Schiere gefahren, </event>
<event start="TLI_46" end="TLI_47">(0.4) </event>
<event start="TLI_47" end="TLI_48">und da woard da das verdeilt, </event>
<event start="TLI_48" end="TLI_49">ne. </event>
<event start="TLI_49" end="TLI_50">(0.22) </event>
<event start="TLI_50" end="TLI_51">ach, </event>
<event start="TLI_51" end="TLI_52">un dann woar dat so schwierig, </event>
<event start="TLI_52" end="TLI_53">war dat so Klumpen, </event>
<event start="TLI_53" end="TLI_54">(0.38) </event>
<event start="TLI_54" end="TLI_55">dann musste mer kloppen, </event>
<event start="TLI_55" end="TLI_56">ne, </event>
<event start="TLI_56" end="TLI_57">und dang, </event>
<event start="TLI_57" end="TLI_58">(0.4) </event>
<event start="TLI_58" end="TLI_59">na, </event>
<event start="TLI_59" end="TLI_60">man brucht ja nit so vill ze strowe wie jetz, </event>
<event start="TLI_60" end="TLI_61">un et gab doch gute Ern, </event>
<event start="TLI_61" end="TLI_62">ne. </event>
<event start="TLI_62" end="TLI_63">(0.37) </event>
<event start="TLI_63" end="TLI_64">da kunnt ma um dat de drissich Pund </event>
<event start="TLI_64" end="TLI_65">(0.39) </event>
<event start="TLI_65" end="TLI_66">Chilesalpeter uf en Morjn Haver streun, </event>
<event start="TLI_66" end="TLI_67">un da hadde mer Haver wie jetz auch, </event>
<event start="TLI_67" end="TLI_68">wo/ wo wir jetz e Zentner strowe. </event>
<event start="TLI_68" end="TLI_69">(2.16) </event>
<event start="TLI_69" end="TLI_71">na, un do ging das äh awer </event>
<event start="TLI_71" end="TLI_72">(1.36) </event>
<event start="TLI_72" end="TLI_73">wie dann die </event>
<event start="TLI_73" end="TLI_74">wie dann en paar Joahr rüm warn, </event>
<event start="TLI_74" end="TLI_75">da hadde mer die Erträsche nit mi, </event>
<event start="TLI_75" end="TLI_76">do musst mer immer meh strown. </event>
<event start="TLI_76" end="TLI_78">und na, da gab s dann au</event>
<event start="TLI_78" end="TLI_79">(0.42) </event>
<event start="TLI_79" end="TLI_80">gab s widder en annere Kunstdinger ne </event>
<event start="TLI_80" end="TLI_81">na, </event>
<event start="TLI_81" end="TLI_82">(0.78) </event>
<event start="TLI_82" end="TLI_83">da war hat mer immer en bissjen ze lernen in de Landwirtschaft, </event>
<event start="TLI_83" end="TLI_84">gab s immer wirrer was anneres. </event>
<event start="TLI_84" end="TLI_85">(5.46) </event>
<event start="TLI_87" end="TLI_89">na, das Dorf, </event>
<event start="TLI_89" end="TLI_90">das war jer </event>
<event start="TLI_90" end="TLI_91">(0.33) </event>
<event start="TLI_91" end="TLI_95">bedeudend kleiner, ne,  das war jo das da hatten sie ja die Wasserleitunge gebugget, </event>
<event start="TLI_95" end="TLI_96">un do hon se jo nit dran gedacht,</event>
<event start="TLI_96" end="TLI_97">dass das/ dass das Dorf mo so groß wor. </event>
<event start="TLI_97" end="TLI_98">do san die jetzige, </event>
<event start="TLI_98" end="TLI_101">die nue sans all, jo, die Quellen liejen ja vill zu dief. </event>
<event start="TLI_101" end="TLI_102">Wasser is a do, </event>
<event start="TLI_102" end="TLI_103">(0.39) </event>
<event start="TLI_103" end="TLI_104">awer es kimmet doch gar nit do oben hin, </event>
<event start="TLI_104" end="TLI_105">wo die einen hinbuen. </event>
<event start="TLI_105" end="TLI_106">awer do hot joa friher ken Mensche dran gedacht, </event>
<event start="TLI_106" end="TLI_107">dass do noch äh Leude hinbugen kinnten, </event>
<event start="TLI_107" end="TLI_108">niche,  </event>
<event start="TLI_108" end="TLI_109">(0.46) </event>
<event start="TLI_109" end="TLI_112">so so so so. </event>
<event start="TLI_112" end="TLI_113">(7.09) </event>
<event start="TLI_114" end="TLI_116">jo, do war jo noch de Post nit, </event>
<event start="TLI_116" end="TLI_117">do ga/ war  </event>
<event start="TLI_117" end="TLI_118">(0.46) </event>
<event start="TLI_118" end="TLI_119">do ging d/ ging das hier  </event>
<event start="TLI_119" end="TLI_120">(0.51) </event>
<event start="TLI_120" end="TLI_121">i meine, </event>
<event start="TLI_121" end="TLI_122">da woarn noch keine  </event>
<event start="TLI_122" end="TLI_123">keine Autos, </event>
<event start="TLI_123" end="TLI_124">un so was kannten wir jo nit. </event>
<event start="TLI_124" end="TLI_125">ich weiß noch, </event>
<event start="TLI_125" end="TLI_126">wie mer s hier/ wie hie en Junge et erste Fahrrad hatte. </event>
<event start="TLI_126" end="TLI_128">dat is noch gar nit so/ et is verhältnismäßich jeder Zeit noch gar nit so lange her, ne. </event>
<event start="TLI_128" end="TLI_129">(0.42) </event>
<event start="TLI_129" end="TLI_131">na, das künne nu doch schon so ne  </event>
<event start="TLI_131" end="TLI_132">(1.74) </event>
<event start="TLI_132" end="TLI_133">ich neime aan, </event>
<event start="TLI_133" end="TLI_134">(0.51) </event>
<event start="TLI_134" end="TLI_135">das war so n Junge, </event>
<event start="TLI_135" end="TLI_136">der wor damolls so siebzenn, </event>
<event start="TLI_136" end="TLI_137">achtzehn Joahr, ach </event>
<event start="TLI_137" end="TLI_138">(0.51) </event>
<event start="TLI_138" end="TLI_139">na vor, </event>
<event start="TLI_139" end="TLI_140">(0.36) </event>
<event start="TLI_140" end="TLI_141">värzich Joahrn ungefähr, </event>
<event start="TLI_141" end="TLI_143">ne, da hatte hie schon en Junge es erste Fahrrad, </event>
<event start="TLI_143" end="TLI_146">da si mer als hingedrin gelaufen, ne. </event>
<event start="TLI_146" end="TLI_147">(3.96) </event>
<event start="TLI_153" end="TLI_154">ja, </event>
<event start="TLI_154" end="TLI_155">(0.27) </event>
<event start="TLI_155" end="TLI_156">von friehern, </event>
<event start="TLI_156" end="TLI_157">na ich soll von frieher mo was verzällen, </event>
<event start="TLI_157" end="TLI_158">ne. </event>
<event start="TLI_158" end="TLI_159">(0.3) </event>
<event start="TLI_159" end="TLI_160">frieher war dat erschde, </event>
<event start="TLI_160" end="TLI_161">da hatt mer nur/ nur Stallhaltung, </event>
<event start="TLI_161" end="TLI_162">net. </event>
<event start="TLI_162" end="TLI_163">na, </event>
<event start="TLI_163" end="TLI_164">ma hatt ja so keine reiche Viehwirtchaft wie jetz, </event>
<event start="TLI_164" end="TLI_165">ne, </event>
<event start="TLI_165" end="TLI_166">(0.54) </event>
<event start="TLI_166" end="TLI_167">so war das jo nit. </event>
<event start="TLI_167" end="TLI_168">awer trotzdem wor jeden Morjen ufgestien,</event>
<event start="TLI_168" end="TLI_169">(0.55) </event>
<event start="TLI_169" end="TLI_170">früh um fünfe war immer et erster Weg war Grünfutter holen, </event>
<event start="TLI_170" end="TLI_171">ne. </event>
<event start="TLI_171" end="TLI_172">(0.48) </event>
<event start="TLI_172" end="TLI_173">na, </event>
<event start="TLI_173" end="TLI_174">und dann worn die Ställe usgemistet un gefuttert. </event>
<event start="TLI_174" end="TLI_175">da war ma schon einmal todmüden, </event>
<event start="TLI_175" end="TLI_176">ne, </event>
<event start="TLI_176" end="TLI_177">(0.4) </event>
<event start="TLI_177" end="TLI_178">wo das  </event>
<event start="TLI_178" end="TLI_179">(0.83) </event>
<event start="TLI_179" end="TLI_181">mein durch die </event>
<event start="TLI_181" end="TLI_182">(0.52) </event>
<event start="TLI_182" end="TLI_183">un dann wird die wa/ </event>
<event start="TLI_183" end="TLI_184">nun kam das ja woll so: </event>
<event start="TLI_184" end="TLI_186">de Vader, inser, </event>
<event start="TLI_186" end="TLI_188">der war frieh gestorwen, ne, </event>
<event start="TLI_188" end="TLI_189">un de Brurer, </event>
<event start="TLI_189" end="TLI_190">der war  </event>
<event start="TLI_190" end="TLI_191">(0.61) </event>
<event start="TLI_191" end="TLI_192">dann äh weg als Verwaldar, </event>
<event start="TLI_192" end="TLI_193">un da hat, </event>
<event start="TLI_193" end="TLI_194">da truhe mir us immer mit dem Gedangen, </event>
<event start="TLI_194" end="TLI_195">ne, </event>
<event start="TLI_195" end="TLI_196">(0.27) </event>
<event start="TLI_196" end="TLI_197">also mer hatten jo so vill Arweit, </event>
<event start="TLI_197" end="TLI_198">ne; </event>
<event start="TLI_198" end="TLI_199">un Leude </event>
<event start="TLI_199" end="TLI_200">mir warn </event>
<event start="TLI_200" end="TLI_201">ich wor do ja erst so siebzehn Joahre, </event>
<event start="TLI_201" end="TLI_202">wie de Vater starb, </event>
<event start="TLI_202" end="TLI_203">(0.52) </event>
<event start="TLI_203" end="TLI_205">na, un dann hatten mir ers so en ahlen Knecht, </event>
<event start="TLI_205" end="TLI_206">ne, </event>
<event start="TLI_206" end="TLI_207">(0.45) </event>
<event start="TLI_207" end="TLI_208">na un da wullt der Herr spilln, </event>
<event start="TLI_208" end="TLI_209">das wullten mir Jungen uns nit gefallen lon. </event>
<event start="TLI_209" end="TLI_212">da ham mer uns en jungen nem, nahmen mir jungen en jungen so was is auch nit </event>
<event start="TLI_212" end="TLI_213">(0.37) </event>
<event start="TLI_213" end="TLI_214">da hatten mir immer den Gedanken, ins </event>
<event start="TLI_214" end="TLI_215">(0.21) </event>
<event start="TLI_215" end="TLI_216">immer/ immer de Bruder vor allen Dingen, </event>
<event start="TLI_216" end="TLI_217">sachte immer: </event>
<event start="TLI_217" end="TLI_218">ach mer muten hie verkaufen, </event>
<event start="TLI_218" end="TLI_219">muten uns en Weidegut kaufen.</event>
<event start="TLI_219" end="TLI_220">do hon die grade keine Leude, </event>
<event start="TLI_220" end="TLI_221">das s viel äh, </event>
<event start="TLI_221" end="TLI_222">viel einfacher, net. </event>
<event start="TLI_222" end="TLI_223">gibt jo lange nit äh das is/ is en viel scheneres Leben das is </event>
<event start="TLI_223" end="TLI_224">(0.57) </event>
<event start="TLI_224" end="TLI_225">na, </event>
<event start="TLI_225" end="TLI_226">nun ging das ja wohl die  </event>
<event start="TLI_226" end="TLI_228">doch hat/ un dazu krichde mir jo immer noch Leude, </event>
<event start="TLI_228" end="TLI_229">mer han noch Maide </event>
<event start="TLI_229" end="TLI_230">(0.54) </event>
<event start="TLI_230" end="TLI_231">un </event>
<event start="TLI_231" end="TLI_232">(0.37) </event>
<event start="TLI_232" end="TLI_233">so was. </event>
<event start="TLI_233" end="TLI_234">un das ging jo los immer schlechter, </event>
<event start="TLI_234" end="TLI_235">ne, </event>
<event start="TLI_235" end="TLI_236">war do schon en bisschen knappa. </event>
<event start="TLI_236" end="TLI_237">(0.52) </event>
<event start="TLI_237" end="TLI_238">un dann sait de Bruder, </event>
<event start="TLI_238" end="TLI_239">wie er weg widder kam: </event>
<event start="TLI_239" end="TLI_240">(0.29) </event>
<event start="TLI_240" end="TLI_241">das geht hie in Netze grad so gut als wie da, </event>
<event start="TLI_241" end="TLI_242">wo ich do gesehn hon au. </event>
<event start="TLI_242" end="TLI_243">do sin/ </event>
<event start="TLI_243" end="TLI_244">(0.19) </event>
<event start="TLI_244" end="TLI_245">is nur deise Industrie, </event>
<event start="TLI_245" end="TLI_246">un do konnt der ??? schun eh keine Leude mehr kriejen, </event>
<event start="TLI_246" end="TLI_247">ne. </event>
<event start="TLI_247" end="TLI_248">(0.25) </event>
<event start="TLI_248" end="TLI_249">un Netze eijnet sich als Weide </event>
<event start="TLI_249" end="TLI_250">(0.93) </event>
<event start="TLI_250" end="TLI_251">gra/ ebensogut. </event>
<event start="TLI_251" end="TLI_252">hier is so schwere Bodden un nasses Land, </event>
<event start="TLI_252" end="TLI_253">ne, </event>
<event start="TLI_253" end="TLI_254">(0.3) </event>
<event start="TLI_254" end="TLI_255">un dedorch konnten mi uns aach hieje </event>
<event start="TLI_255" end="TLI_256">(0.64) </event>
<event start="TLI_256" end="TLI_257">äh gonz gutt damit umstelln. </event>
<event start="TLI_257" end="TLI_258">un das is auch haide noch so; </event>
<event start="TLI_258" end="TLI_260">in Netze is de besde Weidebe/, die Weidebetriebe, </event>
