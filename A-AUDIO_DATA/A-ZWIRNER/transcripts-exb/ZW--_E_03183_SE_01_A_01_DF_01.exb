<event start="TLI_246" end="TLI_247">nicht. </event>
<event start="TLI_247" end="TLI_248">(0.25) </event>
<event start="TLI_248" end="TLI_249">Und Netze eignet sich als Weide </event>
<event start="TLI_249" end="TLI_250">(0.93) </event>
