<tier id="TIE0" speaker="S2" category="lit" type="a" display-name="S2 [lit]"><event start="TLI_1" end="TLI_2">(0.96) </event>
<event start="TLI_2" end="TLI_3">ich hon e harte Jugend durchgemacht. </event>
<event start="TLI_3" end="TLI_4">(0.97) </event>
<event start="TLI_4" end="TLI_5">zu meiner Zeit </event>
<event start="TLI_5" end="TLI_6">(1.65) </event>
<event start="TLI_6" end="TLI_7">gab s noch kene Maschinen. </event>
<event start="TLI_7" end="TLI_8">(1.62) </event>
<event start="TLI_8" end="TLI_9">ich hon schun </event>
<event start="TLI_9" end="TLI_10">(1.18) </event>
<event start="TLI_10" end="TLI_11">in d Schulen gehend morjen frieh uf de Schiere helfen dreschen. </event>
<event start="TLI_11" end="TLI_12">(2.52) </event>
<event start="TLI_12" end="TLI_13">mi dm Flegel. </event>
<event start="TLI_13" end="TLI_14">(1.86) </event>
<event start="TLI_14" end="TLI_15">un  </event>
<event start="TLI_15" end="TLI_16">(0.48) </event>
<event start="TLI_16" end="TLI_17">Sämaschine krichde mer erscht in </event>
<event start="TLI_17" end="TLI_18">(0.58) </event>
<event start="TLI_18" end="TLI_19">dreiundneunzig. </event>
<event start="TLI_19" end="TLI_20">(1.48) </event>
<event start="TLI_20" end="TLI_21">bis dohin hat mei Vadder noch alles mit dr Hand gesät. </event>
<event start="TLI_21" end="TLI_22">(2.11) </event>
<event start="TLI_22" end="TLI_23">en erschden Grosmäher </event>
<event start="TLI_23" end="TLI_24">(0.21) </event>
<event start="TLI_24" end="TLI_25">kriechde mer erschd in neunzehnhunnert. </event>
<event start="TLI_25" end="TLI_26">(1.08) </event>
<event start="TLI_26" end="TLI_27">do war ich schon vierundzwanzig Johre alt. </event>
<event start="TLI_27" end="TLI_28">(0.82) </event>
<event start="TLI_28" end="TLI_29">un do hon ich </event>
<event start="TLI_29" end="TLI_30">(0.6) </event>
<event start="TLI_30" end="TLI_31">müen drei, </event>
<event start="TLI_31" end="TLI_32">vier Wochen mit dr Sense </event>
<event start="TLI_32" end="TLI_33">(1.03) </event>
<event start="TLI_33" end="TLI_34">uf der Wisse mähen. </event>
<event start="TLI_34" end="TLI_35">mir hadden dreißich Morjen Wisse. </event>
<event start="TLI_35" end="TLI_36">ja da kunn se sich dengen, </event>
<event start="TLI_36" end="TLI_37">(0.6) </event>
<event start="TLI_37" end="TLI_38">wo ich do hon mussen schuften. </event>
<event start="TLI_38" end="TLI_39">(2.01) </event>
<event start="TLI_39" end="TLI_40">mit zwei Schwestern, </event>
<event start="TLI_40" end="TLI_41">ne? </event>
<event start="TLI_41" end="TLI_42">(1.02) </event>
<event start="TLI_42" end="TLI_43">mehr krichde mer selden, </event>
<event start="TLI_43" end="TLI_44">mer mussde fast alles allene mähen. </event>
<event start="TLI_44" end="TLI_45">(1.65) </event>
<event start="TLI_45" end="TLI_46">un dann </event>
<event start="TLI_46" end="TLI_47">(2.1) </event>
<event start="TLI_47" end="TLI_48">den ganzen Sommr de Frocht nur mit dr Sense obgemäht. </event>
<event start="TLI_48" end="TLI_49">(1.36) </event>
<event start="TLI_49" end="TLI_50">des hon ich all allene musse machen. </event>
<event start="TLI_50" end="TLI_51">mein Vatr, </event>
<event start="TLI_51" end="TLI_52">der wor schon ziemich alt </event>
<event start="TLI_52" end="TLI_53">(0.81) </event>
<event start="TLI_53" end="TLI_54">un wor bei ejm Meschder, </event>
<event start="TLI_54" end="TLI_55">der gunt nit vel vele mit eraus. </event>
<event start="TLI_55" end="TLI_56">(1.53) </event>
<event start="TLI_56" end="TLI_57">hon ich </event>
<event start="TLI_57" end="TLI_58">(0.61) </event>
<event start="TLI_58" end="TLI_59">das Mähn all allene musse machen, </event>
<event start="TLI_59" end="TLI_60">un meine zwei Schwestern, die hon s dann upge/, ufgenomme. </event>
<event start="TLI_60" end="TLI_61">(3.19) </event>
<event start="TLI_61" end="TLI_63">ja, un des Ackern </event>
<event start="TLI_63" end="TLI_64">(1.3) </event>
<event start="TLI_64" end="TLI_65">häde hon se jo Bulldogs. </event>
<event start="TLI_65" end="TLI_66">(1.18) </event>
<event start="TLI_66" end="TLI_67">domals musste mer dann hiner den Peren immer her schreiden </event>
<event start="TLI_67" end="TLI_68">(1.81) </event>
<event start="TLI_68" end="TLI_69">mussde </event>
<event start="TLI_69" end="TLI_70">(0.47) </event>
<event start="TLI_70" end="TLI_71">n Ackerplug in de Hand nämmn. </event>
<event start="TLI_71" end="TLI_72">(2.11) </event>
<event start="TLI_72" end="TLI_73">here geht s jo mit dem Bulldog, </event>
<event start="TLI_73" end="TLI_74">(0.22) </event>
<event start="TLI_74" end="TLI_75">geht s jo bessa. </event>
<event start="TLI_75" end="TLI_76">(1.05) </event>
<event start="TLI_76" end="TLI_77">awer trotzdem hom mer noch ken Bulldog. </event>
<event start="TLI_77" end="TLI_78">mer machen s immer noch mit en Peren. </event>
<event start="TLI_78" end="TLI_79">(0.96) </event>
<event start="TLI_79" end="TLI_80">mer hon drei Pere un </event>
<event start="TLI_80" end="TLI_81">(1.63) </event>
<event start="TLI_81" end="TLI_82">do komme mer ganz gut mide voran. </event>
<event start="TLI_82" end="TLI_83">(3.57) </event>
<event start="TLI_83" end="TLI_85">ja, es geht nadirlich nur alles mechanisch. </event>
<event start="TLI_85" end="TLI_86">(1.57) </event>
<event start="TLI_86" end="TLI_87">mer hon jetz </event>
<event start="TLI_87" end="TLI_88">(1.51) </event>
<event start="TLI_88" end="TLI_89">en Ufzug in dr Schiere. </event>
<event start="TLI_89" end="TLI_90">do wird de Frocht midde obgeladen. </event>
