</tier><tier id="TIE4" speaker="S2" category="norm" type="a" display-name="S2 [norm]"><event start="TLI_1" end="TLI_2">(0.96) </event>
<event start="TLI_2" end="TLI_3">ich habe eine harte Jugend durchgemacht. </event>
<event start="TLI_3" end="TLI_4">(0.97) </event>
<event start="TLI_4" end="TLI_5">zu meiner Zeit </event>
<event start="TLI_5" end="TLI_6">(1.65) </event>
<event start="TLI_6" end="TLI_7">gab es noch keine Maschinen. </event>
<event start="TLI_7" end="TLI_8">(1.62) </event>
<event start="TLI_8" end="TLI_9">ich habe schon </event>
<event start="TLI_9" end="TLI_10">(1.18) </event>
<event start="TLI_10" end="TLI_11">in die Schule gehend morgens früh auf der Scheune helfen dreschen. </event>
<event start="TLI_11" end="TLI_12">(2.52) </event>
<event start="TLI_12" end="TLI_13">mit dem Flegel. </event>
<event start="TLI_13" end="TLI_14">(1.86) </event>
<event start="TLI_14" end="TLI_15">und </event>
<event start="TLI_15" end="TLI_16">(0.48) </event>
<event start="TLI_16" end="TLI_17">Sämaschine kriegten wir erst in </event>
<event start="TLI_17" end="TLI_18">(0.58) </event>
<event start="TLI_18" end="TLI_19">dreiundneunzig. </event>
<event start="TLI_19" end="TLI_20">(1.48) </event>
<event start="TLI_20" end="TLI_21">bis dahin hat mein Vater noch alles mit der Hand gesät. </event>
<event start="TLI_21" end="TLI_22">(2.11) </event>
<event start="TLI_22" end="TLI_23">die ersten Grasmäher </event>
<event start="TLI_23" end="TLI_24">(0.21) </event>
<event start="TLI_24" end="TLI_25">kriegten wir erst in neunzehnhundert  . </event>
<event start="TLI_25" end="TLI_26">(1.08) </event>
<event start="TLI_26" end="TLI_27">da war ich schon vierundzwanzig Jahre alt. </event>
<event start="TLI_27" end="TLI_28">(0.82) </event>
<event start="TLI_28" end="TLI_29">und da habe ich </event>
<event start="TLI_29" end="TLI_30">(0.6) </event>
<event start="TLI_30" end="TLI_31">müssen drei, </event>
<event start="TLI_31" end="TLI_32">vier Wochen mit der Sense </event>
<event start="TLI_32" end="TLI_33">(1.03) </event>
<event start="TLI_33" end="TLI_34">auf der Wiese mähen. </event>
<event start="TLI_34" end="TLI_35">wir hatten dreißig Morgen Wiese. </event>
<event start="TLI_35" end="TLI_36">ja da können sie sich denken, </event>
<event start="TLI_36" end="TLI_37">(0.6) </event>
<event start="TLI_37" end="TLI_38">was ich da habe müssen schuften. </event>
<event start="TLI_38" end="TLI_39">(2.01) </event>
<event start="TLI_39" end="TLI_40">mit zwei Schwestern, </event>
<event start="TLI_40" end="TLI_41">nicht? </event>
<event start="TLI_41" end="TLI_42">(1.02) </event>
<event start="TLI_42" end="TLI_43">mehr kriegten wir selten, </event>
<event start="TLI_43" end="TLI_44">wir mussten fast alles alleine mähen. </event>
<event start="TLI_44" end="TLI_45">(1.65) </event>
<event start="TLI_45" end="TLI_46">und dann </event>
<event start="TLI_46" end="TLI_47">(2.1) </event>
<event start="TLI_47" end="TLI_48">den ganzen Sommer die Frucht nur mit der Sense abgemäht. </event>
<event start="TLI_48" end="TLI_49">(1.36) </event>
<event start="TLI_49" end="TLI_50">das habe ich alles allein müssen machen. </event>
<event start="TLI_50" end="TLI_51">mein Vater, </event>
<event start="TLI_51" end="TLI_52">der war schon ziemlich alt </event>
<event start="TLI_52" end="TLI_53">(0.81) </event>
<event start="TLI_53" end="TLI_54">und war bei einem Meister, </event>
<event start="TLI_54" end="TLI_55">der ging nicht % viel mit raus. </event>
<event start="TLI_55" end="TLI_56">(1.53) </event>
<event start="TLI_56" end="TLI_57">habe ich </event>
<event start="TLI_57" end="TLI_58">(0.61) </event>
<event start="TLI_58" end="TLI_59">das Mähen alles alleine müssen machen, </event>
<event start="TLI_59" end="TLI_60">und meine zwei Schwestern, die haben es dann %, aufgenommen. </event>
<event start="TLI_60" end="TLI_61">(3.19) </event>
<event start="TLI_61" end="TLI_63">ja, und das Ackern </event>
<event start="TLI_63" end="TLI_64">(1.3) </event>
<event start="TLI_64" end="TLI_65">heute haben sie ja Buldoggs. </event>
<event start="TLI_65" end="TLI_66">(1.18) </event>
<event start="TLI_66" end="TLI_67">damals mussten wir dann hinter den Pferden immer her schreiten </event>
<event start="TLI_67" end="TLI_68">(1.81) </event>
<event start="TLI_68" end="TLI_69">musste </event>
<event start="TLI_69" end="TLI_70">(0.47) </event>
<event start="TLI_70" end="TLI_71">den Ackerpflug in die Hand nehmen. </event>
<event start="TLI_71" end="TLI_72">(2.11) </event>
<event start="TLI_72" end="TLI_73">heute geht es ja mit dem Buldogg, </event>
<event start="TLI_73" end="TLI_74">(0.22) </event>
<event start="TLI_74" end="TLI_75">geht es ja besser. </event>
<event start="TLI_75" end="TLI_76">(1.05) </event>
<event start="TLI_76" end="TLI_77">aber trotzdem haben wir noch keinen Buldogg. </event>
<event start="TLI_77" end="TLI_78">wir machen es immer noch mit den Pferden. </event>
<event start="TLI_78" end="TLI_79">(0.96) </event>
<event start="TLI_79" end="TLI_80">wir haben drei Pferde und </event>
<event start="TLI_80" end="TLI_81">(1.63) </event>
<event start="TLI_81" end="TLI_82">da kommen wir ganz gut mit voran. </event>
<event start="TLI_82" end="TLI_83">(3.57) </event>
<event start="TLI_83" end="TLI_85">ja, es geht natürlich nun alles mechanisch. </event>
<event start="TLI_85" end="TLI_86">(1.57) </event>
<event start="TLI_86" end="TLI_87">wir haben jetzt </event>
<event start="TLI_87" end="TLI_88">(1.51) </event>
<event start="TLI_88" end="TLI_89">einen Aufzug in der Scheune. </event>
<event start="TLI_89" end="TLI_90">da wird die Frucht mit abgeladen. </event>
<event start="TLI_90" end="TLI_91">die Scheune ist vierunddreißig Meter lang. </event>
<event start="TLI_91" end="TLI_92">(0.57) </event>
<event start="TLI_92" end="TLI_93">und der geht durch die ganze Scheune durch. </event>
<event start="TLI_93" end="TLI_94">(0.69) </event>
<event start="TLI_94" end="TLI_95">und wo die Frucht gerade hingebanst soll werden, da wird der</event>
<event start="TLI_95" end="TLI_96">(0.84) </event>
<event start="TLI_96" end="TLI_97">der Aufzug eingestellt. </event>
<event start="TLI_97" end="TLI_98">und dann wirft es </event>
<event start="TLI_98" end="TLI_99">(0.61) </event>
<event start="TLI_99" end="TLI_100">mechanisch ab. </event>
<event start="TLI_100" end="TLI_101">(2.31) </event>
<event start="TLI_101" end="TLI_102">und dann haben wir </event>
<event start="TLI_102" end="TLI_103">(0.7) </event>
<event start="TLI_103" end="TLI_104">eine Stallbahn, </event>
<event start="TLI_104" end="TLI_105">(1.11) </event>
<event start="TLI_105" end="TLI_106">wo der Mist mit raus wird befördert. </event>
<event start="TLI_106" end="TLI_107">(1.41) </event>
<event start="TLI_107" end="TLI_108">die anderen Bauern, </event>
<event start="TLI_108" end="TLI_109">die fahren ihn immer noch mit dem </event>
<event start="TLI_109" end="TLI_110">(0.21) </event>
<event start="TLI_110" end="TLI_111">Mistkarren raus. </event>
<event start="TLI_111" end="TLI_112">das machen wir nicht mehr. </event>
<event start="TLI_112" end="TLI_113">(0.66) </event>
<event start="TLI_113" end="TLI_114">wenn die Stallbahn, </event>
<event start="TLI_114" end="TLI_115">(0.3) </event>
<event start="TLI_115" end="TLI_116">die geht bis auf die Miste, </event>
<event start="TLI_116" end="TLI_117">(0.78) </event>
<event start="TLI_117" end="TLI_118">und wenn wir auf der Miste sind angekommen, </event>
<event start="TLI_118" end="TLI_119">und dann wird nur auf den Hebel gedrückt, </event>
<event start="TLI_119" end="TLI_120">(0.63) </event>
<event start="TLI_120" end="TLI_121">dann schwenkt sich der das Becken rum und wirft den Mist raus. </event>
<event start="TLI_121" end="TLI_122">(0.7) </event>
<event start="TLI_122" end="TLI_123">eine schöne Sache! </event>
<event start="TLI_123" end="TLI_124">(0.87) </event>
<event start="TLI_124" end="TLI_125">eine große Erleichterung! </event>
<event start="TLI_125" end="TLI_126">(1.62) </event>
<event start="TLI_126" end="TLI_127">und dann hatten % dann haben wir eine  </event>
<event start="TLI_127" end="TLI_128">(0.79) </event>
<event start="TLI_128" end="TLI_129">eine Jauchenpumpe. </event>
<event start="TLI_129" end="TLI_130">die wird % elektrisch betrieben. </event>
<event start="TLI_130" end="TLI_131">und früher musste man alles machen mit der Hand. </event>
<event start="TLI_131" end="TLI_132">(0.99) </event>
<event start="TLI_132" end="TLI_133">da hat man sich kolossal müssen anstrengen. </event>
<event start="TLI_133" end="TLI_134">da ließen sie immer die Pumpen, das </event>
<event start="TLI_134" end="TLI_135">(0.39) </event>
<event start="TLI_135" end="TLI_136">die Jauche fallen. </event>
<event start="TLI_136" end="TLI_137">und da musste man </event>
<event start="TLI_137" end="TLI_138">(0.25) </event>
<event start="TLI_138" end="TLI_139">wieder Wasser oben rein </event>
<event start="TLI_139" end="TLI_140">(0.62) </event>
<event start="TLI_140" end="TLI_141">schütten, </event>
<event start="TLI_141" end="TLI_142">dass sie wieder in Gang kam. </event>
<event start="TLI_142" end="TLI_143">und mußte pumpen! </event>
<event start="TLI_143" end="TLI_144">(1.08) </event>
<event start="TLI_144" end="TLI_147">zum, ja, es war furchtbar mitunter. </event>
<event start="TLI_147" end="TLI_148">(1.02) </event>
<event start="TLI_148" end="TLI_149">heute ist alles viel leichter. </event>
<event start="TLI_149" end="TLI_150">(2.4) </event>
<event start="TLI_150" end="TLI_151">eine Melkmaschine </event>
<event start="TLI_151" end="TLI_152">(0.33) </event>
<event start="TLI_152" end="TLI_153">angeschafft, </event>
<event start="TLI_153" end="TLI_154">(1.96) </event>
<event start="TLI_154" end="TLI_155">das macht jetzt ein Schuljunge! </event>
<event start="TLI_155" end="TLI_156">(1.62) </event>
<event start="TLI_156" end="TLI_157">das Melken mit der Melkmaschine. </event>
<event start="TLI_157" end="TLI_158">(1.32) </event>
<event start="TLI_158" end="TLI_159">da haben wir den Zehnjährigen </event>
<event start="TLI_159" end="TLI_160">(0.36) </event>
<event start="TLI_160" end="TLI_161">Enkel, </event>
<event start="TLI_161" end="TLI_162">(0.87) </event>
<event start="TLI_162" end="TLI_163">der macht das </event>
<event start="TLI_163" end="TLI_164">(1.44) </event>
<event start="TLI_164" end="TLI_165">mit leichter Mühe.</event>
<event start="TLI_165" end="TLI_166">(2.38) </event>
<event start="TLI_169" end="TLI_170">Von dem Femgericht? |</event>
<event start="TLI_173" end="TLI_174">Ja, </event>
<event start="TLI_174" end="TLI_175">(0.18) </event>
<event start="TLI_175" end="TLI_176">da war vor </event>
<event start="TLI_176" end="TLI_177">(1.0) </event>
<event start="TLI_177" end="TLI_178">alter grauer Zeit wurden doch wurden doch noch die Femgerichte auf den Dörfern abgehalten. </event>
<event start="TLI_178" end="TLI_179">(3.6) </event>
<event start="TLI_179" end="TLI_180">jetzt war </event>
<event start="TLI_180" end="TLI_181">(0.39) </event>
<event start="TLI_181" end="TLI_182">eine Frau </event>
<event start="TLI_182" end="TLI_183">(0.53) </event>
<event start="TLI_183" end="TLI_184">zum Tode verurteilt.</event>
<event start="TLI_184" end="TLI_185">(1.56) </event>
<event start="TLI_185" end="TLI_186">was sie nun gemacht hatte, das</event>
<event start="TLI_186" end="TLI_187">(0.24) </event>
<event start="TLI_187" end="TLI_188">das weiß ich nicht, </event>
<event start="TLI_188" end="TLI_189">das weiß ich nicht. </event>
<event start="TLI_189" end="TLI_190">(2.37) </event>
<event start="TLI_190" end="TLI_191">kurzum, </event>
<event start="TLI_191" end="TLI_192">(0.33) </event>
<event start="TLI_192" end="TLI_193">sie war zum Tode verurteilt. </event>
<event start="TLI_193" end="TLI_194">(1.78) </event>
<event start="TLI_194" end="TLI_195">und da </event>
<event start="TLI_195" end="TLI_196">(0.42) </event>
<event start="TLI_196" end="TLI_197">hatte sie noch eine Bitte, </event>
<event start="TLI_197" end="TLI_198">die brachte sie vor. </event>
<event start="TLI_198" end="TLI_199">(1.26) </event>
<event start="TLI_199" end="TLI_200">und die wird ihr gewährt. </event>
<event start="TLI_200" end="TLI_201">(1.23) </event>
<event start="TLI_201" end="TLI_202">da wollte sie noch </event>
<event start="TLI_202" end="TLI_203">(0.3) </event>
<event start="TLI_203" end="TLI_204">einmal </event>
<event start="TLI_204" end="TLI_205">(0.56) </event>
<event start="TLI_205" end="TLI_206">säen und einmal ernten. </event>
<event start="TLI_206" end="TLI_207">(0.52) </event>
<event start="TLI_207" end="TLI_208">und das ist ihr gewährt worden. </event>
<event start="TLI_208" end="TLI_209">(1.12) </event>
<event start="TLI_209" end="TLI_210">und da hat sie Eicheln gesät! </event>
<event start="TLI_210" end="TLI_211">(1.42) </event>
<event start="TLI_211" end="TLI_212">hier in der Gegend von Salzborn. </event>
<event start="TLI_212" end="TLI_213">(0.61) </event>
<event start="TLI_213" end="TLI_214">auf dem Kircherellenen </event>
<event start="TLI_214" end="TLI_215">(1.33) </event>
<event start="TLI_215" end="TLI_216">hat sie sie gesät. </event>
<event start="TLI_216" end="TLI_217">(0.72) </event>
<event start="TLI_217" end="TLI_218">und heute stehen noch eine ganze Mengen Eichen </event>
<event start="TLI_218" end="TLI_219">da. </event>
<event start="TLI_219" end="TLI_220">(2.38) </event>
<event start="TLI_220" end="TLI_221">in Salzborn steht noch ein ganzer Rude </event>
<event start="TLI_221" end="TLI_222">(0.73) </event>
<event start="TLI_222" end="TLI_223">und dann raus zu nach Wildungen, </event>
<event start="TLI_223" end="TLI_224">wo das Kinderheim ist, da steht</event>
<event start="TLI_224" end="TLI_225">(0.67) </event>
<event start="TLI_225" end="TLI_226">noch ein Rudel, das</event>
<event start="TLI_226" end="TLI_227">(0.34) </event>
<event start="TLI_227" end="TLI_228">das heißt: </event>
<event start="TLI_228" end="TLI_229">die sechs Eichen. </event>
<event start="TLI_229" end="TLI_230">(0.99) </event>
<event start="TLI_230" end="TLI_231">und auf dem Kirchellenen oben, </event>
<event start="TLI_231" end="TLI_232">(0.15) </event>
<event start="TLI_232" end="TLI_233">da steht </event>
<event start="TLI_233" end="TLI_234">(0.24) </event>
<event start="TLI_234" end="TLI_235">auch noch eine ganze Menge Eichen. </event>
<event start="TLI_235" end="TLI_236">(1.8) </event>
<event start="TLI_236" end="TLI_237">also eine wahre Geschichte muss es schon sein. </event>
<event start="TLI_237" end="TLI_238">(2.58) </event>
<event start="TLI_240" end="TLI_241">ja, </event>
<event start="TLI_241" end="TLI_242">(4.69) </event>
<event start="TLI_242" end="TLI_243">hier auf der Jägersburg. </event>
<event start="TLI_243" end="TLI_244">(1.36) </event>
<event start="TLI_244" end="TLI_245">da hat doch ein Schloss gestanden. </event>
<event start="TLI_245" end="TLI_246">(1.56) </event>
<event start="TLI_246" end="TLI_247">ein Jagdschloss. </event>
<event start="TLI_247" end="TLI_248">(0.34) </event>
<event start="TLI_248" end="TLI_249">hat der Fürst Ulrich von </event>
<event start="TLI_249" end="TLI_250">(0.47) </event>
<event start="TLI_250" end="TLI_251">Arolsen gebaut. </event>
<event start="TLI_251" end="TLI_252">(1.95) </event>
<event start="TLI_252" end="TLI_253">der hielt hier immer die Jagd ab. </event>
<event start="TLI_253" end="TLI_254">und dann mussten die Bauern, </event>
<event start="TLI_254" end="TLI_255">(0.75) </event>
<event start="TLI_255" end="TLI_256">die mussten dann mit und mussten helfen treiben. </event>
<event start="TLI_256" end="TLI_257">(2.88) </event>
<event start="TLI_257" end="TLI_258">und </event>
<event start="TLI_258" end="TLI_259">(3.43) </event>
<event start="TLI_259" end="TLI_260">jetzt ist nun das Jagdschloss auch schon das war in den siebziger Jahren </event>
<event start="TLI_260" end="TLI_261">und erst abgebrochen und ist </event>
<event start="TLI_261" end="TLI_262">(0.51) </event>
<event start="TLI_262" end="TLI_263">in Wildungen wieder aufgebaut. </event>
<event start="TLI_263" end="TLI_264">(0.78) </event>
<event start="TLI_264" end="TLI_265">ist oben das Centraltheater. </event>
<event start="TLI_265" end="TLI_266">(0.99) </event>
<event start="TLI_266" end="TLI_267">das ist es. </event>
<event start="TLI_267" end="TLI_268">(4.69) </event>
<event start="TLI_268" end="TLI_269">jetzt </event>
<event start="TLI_269" end="TLI_270">(0.28) </event>
<event start="TLI_270" end="TLI_271">hatte nun der </event>
<event start="TLI_271" end="TLI_272">Fürst </event>
<event start="TLI_272" end="TLI_273">(0.19) </event>
<event start="TLI_273" end="TLI_274">damals </event>
<event start="TLI_274" end="TLI_275">(1.0) </event>
<event start="TLI_275" end="TLI_276">einen Leibjäger. </event>
<event start="TLI_276" end="TLI_277">(2.29) </event>
<event start="TLI_277" end="TLI_278">der war Gärtner. </event>
<event start="TLI_278" end="TLI_279">(0.91) </event>
<event start="TLI_279" end="TLI_280">und der ist mit ihm gemacht in den Türkenkrieg.</event>
<event start="TLI_280" end="TLI_281">(1.99) </event>
<event start="TLI_281" end="TLI_284">und da mussten sie flüchten gehn. </event>
<event start="TLI_284" end="TLI_285">(0.93) </event>
<event start="TLI_285" end="TLI_286">und mussten durch die Donau </event>
<event start="TLI_286" end="TLI_287">(0.34) </event>
<event start="TLI_287" end="TLI_288">reiten. </event>
<event start="TLI_288" end="TLI_289">(1.53) </event>
<event start="TLI_289" end="TLI_290">und mitten in der Donau fängt dem Fürst sein Gaul </event>
<event start="TLI_290" end="TLI_291">(0.27) </event>
<event start="TLI_291" end="TLI_292">an zu sinken. </event>
<event start="TLI_292" end="TLI_293">(1.29) </event>
<event start="TLI_293" end="TLI_298">und da spricht sein Leibjäger ihm: </event>
<event start="TLI_298" end="TLI_299">(0.57) </event>
<event start="TLI_299" end="TLI_300">stechen stechen sie dem Gaul doch mal mit dem Sebel in die Mähne, </event>
<event start="TLI_300" end="TLI_301">dann wird er wieder </event>
<event start="TLI_301" end="TLI_302">(0.9) </event>
<event start="TLI_302" end="TLI_303">neuen Mut krieben! </event>
<event start="TLI_303" end="TLI_304">(0.73) </event>
<event start="TLI_304" end="TLI_305">das hat der Fürst gemacht </event>
<event start="TLI_305" end="TLI_306">(0.49) </event>
<event start="TLI_306" end="TLI_307">und ist tatsächlich ans Ufer gekommen. </event>
<event start="TLI_307" end="TLI_308">(1.72) </event>
<event start="TLI_308" end="TLI_309">und zum Danke </event>
<event start="TLI_309" end="TLI_310">(0.78) </event>
<event start="TLI_310" end="TLI_311">hat er  </event>
<event start="TLI_311" end="TLI_312">(0.9) </event>
<event start="TLI_312" end="TLI_313">schrieb sich: </event>
<event start="TLI_313" end="TLI_314">Ark, </event>
<event start="TLI_314" end="TLI_315">mein Vater hat ihn noch gekannt, </event>
<event start="TLI_315" end="TLI_316">(1.06) </event>
<event start="TLI_316" end="TLI_317">er war Gärtner, </event>
<event start="TLI_317" end="TLI_318">(0.84) </event>
<event start="TLI_318" end="TLI_319">hat er dem die Jägersburg hier gegeben, </event>
<event start="TLI_319" end="TLI_320">so lange, </event>
<event start="TLI_320" end="TLI_321">wie männliche Erben </event>
<event start="TLI_321" end="TLI_322">(0.73) </event>
<event start="TLI_322" end="TLI_323">da waren. </event>
<event start="TLI_323" end="TLI_324">(0.82) </event>
<event start="TLI_324" end="TLI_325">nun hatte aber dieser Ark </event>
<event start="TLI_325" end="TLI_326">(0.63) </event>
<event start="TLI_326" end="TLI_327">nur </event>
<event start="TLI_327" end="TLI_328">(0.15) </event>
<event start="TLI_328" end="TLI_329">Mädchen. </event>
<event start="TLI_329" end="TLI_330">(1.29) </event>
<event start="TLI_330" end="TLI_331">zwei Mädchen. </event>
<event start="TLI_331" end="TLI_332">(0.84) </event>
<event start="TLI_332" end="TLI_334">ja, und da war das hinfällig. </event>
<event start="TLI_334" end="TLI_335">(3.24) </event>
<event start="TLI_335" end="TLI_336">nun sind nur noch </event>
<event start="TLI_336" end="TLI_337">(1.71) </event>
<event start="TLI_337" end="TLI_338">mehrere Familien, </event>
<event start="TLI_338" end="TLI_339">haben da drauf gewohnt, </event>
<event start="TLI_339" end="TLI_340">auf dem Schloss. </event>
<event start="TLI_340" end="TLI_341">(1.81) </event>
<event start="TLI_341" end="TLI_343">na, und da haben sie da oben getanzt, </event>
<event start="TLI_343" end="TLI_344">und Kegel gespielt. </event>
<event start="TLI_344" end="TLI_345">sind die ganzen </event>
<event start="TLI_345" end="TLI_346">(0.58) </event>
<event start="TLI_346" end="TLI_347">Dorfburschen aus der Umgegend immer auf die Jägersburg gekommen </event>
<event start="TLI_347" end="TLI_348">(0.69) </event>
<event start="TLI_348" end="TLI_349">und haben da getanzt und Kegel gespielt. </event>
<event start="TLI_349" end="TLI_350">(1.38) </event>
<event start="TLI_350" end="TLI_351">nun hat es aber späterhin </event>
<event start="TLI_351" end="TLI_352">(1.71) </event>
<event start="TLI_352" end="TLI_353">ist es auf % Abbruch verkauft. </event>
<event start="TLI_353" end="TLI_354">(0.9) </event>
<event start="TLI_354" end="TLI_355">ist nach Wildungen gekommen. </event>
<event start="TLI_355" end="TLI_356">(1.68) </event>
<event start="TLI_356" end="TLI_357">das Centraltheater </event>
<event start="TLI_357" end="TLI_358">draus gebaut. </event>
<event start="TLI_358" end="TLI_359">(2.52) </event>
<event start="TLI_363" end="TLI_364">Ach, </event>
<event start="TLI_364" end="TLI_365">(0.39) </event>
<event start="TLI_365" end="TLI_366">das reißt nicht ab, </event>
<event start="TLI_366" end="TLI_367">(1.03) </event>
<event start="TLI_367" end="TLI_368">das reißt nicht ab, </event>
<event start="TLI_368" end="TLI_369">auch im Winter. </event>
<event start="TLI_369" end="TLI_370">(2.91) </event>
<event start="TLI_371" end="TLI_372">im Winter, </event>
<event start="TLI_372" end="TLI_373">(1.56) </event>
<event start="TLI_373" end="TLI_374">na ja, </event>
<event start="TLI_374" end="TLI_375">früher wurde im Winter gedroschen zum meiner Zeit, </event>
<event start="TLI_375" end="TLI_376">wie ich noch jung war. </event>
<event start="TLI_376" end="TLI_377">(1.14) </event>
<event start="TLI_377" end="TLI_378">jetzt wird ja alles mit der </event>
<event start="TLI_378" end="TLI_379">(0.71) </event>
<event start="TLI_379" end="TLI_380">Maschine </event>
<event start="TLI_380" end="TLI_381">gemacht. </event>
<event start="TLI_381" end="TLI_382">im Herbst schon und im Sommer. </event>
<event start="TLI_382" end="TLI_383">(1.8) </event>
<event start="TLI_383" end="TLI_384">aber das Vieh füttern, </event>
<event start="TLI_384" end="TLI_385">und das Vieh, </event>
<event start="TLI_385" end="TLI_386">muss doch </event>
<event start="TLI_386" end="TLI_387">(0.69) </event>
<event start="TLI_387" end="TLI_388">und gepflegt werden, </event>
<event start="TLI_388" end="TLI_389">geputzt, </event>
<event start="TLI_389" end="TLI_390">(0.69) </event>
<event start="TLI_390" end="TLI_391">sauber gemacht werden. </event>
<event start="TLI_391" end="TLI_392">das ist doch eine Riesenarbeit! </event>
<event start="TLI_392" end="TLI_393">(1.02) </event>
<event start="TLI_393" end="TLI_394">ich habe mir immer das Hemd ausgezogen, </event>
<event start="TLI_394" end="TLI_395">(0.63) </event>
<event start="TLI_395" end="TLI_396">und habe nur mit der Hose da gestanden, </event>
<event start="TLI_396" end="TLI_397">und habe das Vieh geputzt. </event>
<event start="TLI_397" end="TLI_398">(0.21) </event>
<event start="TLI_398" end="TLI_399">im Stall ist es ja im Winter auch warm, </event>
<event start="TLI_399" end="TLI_400">nicht? </event>
<event start="TLI_400" end="TLI_401">(1.98) </event>
<event start="TLI_401" end="TLI_403">na, muss gefüttert werden, </event>
<event start="TLI_403" end="TLI_404">man hat ja jetzt, </event>
<event start="TLI_404" end="TLI_405">(0.36) </event>
<event start="TLI_405" end="TLI_406">hat man es ja leichter. </event>
<event start="TLI_406" end="TLI_407">(0.96) </event>
<event start="TLI_407" end="TLI_408">jetzt hat man Selbsttränke und </event>
<event start="TLI_408" end="TLI_409">(0.99) </event>
<event start="TLI_409" end="TLI_410">und hat äh </event>
<event start="TLI_410" end="TLI_411">(1.41) </event>
<event start="TLI_411" end="TLI_412">man füttert alles lang. </event>
<event start="TLI_412" end="TLI_413">früher musste alles mit der Häckselmaschine geschnitten werden. </event>
<event start="TLI_413" end="TLI_414">(0.46) </event>
<event start="TLI_414" end="TLI_415">jetzt füttert man alles lang. </event>
<event start="TLI_415" end="TLI_416">(0.72) </event>
<event start="TLI_416" end="TLI_417">das kommt oben vom Heuboden direkt auf die Rampe, </event>
<event start="TLI_417" end="TLI_418">(1.29) </event>
<event start="TLI_418" end="TLI_419">wird es geschmissen, </event>
<event start="TLI_419" end="TLI_420">(0.24) </event>
<event start="TLI_420" end="TLI_421">da % braucht man es bloß auseinander zu machen. </event>
<event start="TLI_421" end="TLI_422">das ist jetzt % </event>
<event start="TLI_422" end="TLI_423">(0.66) </event>
<event start="TLI_423" end="TLI_424">% % % leichter, als wie zu in meiner % in meiner Jugend. </event>
<event start="TLI_424" end="TLI_425">(0.82) </event>
<event start="TLI_425" end="TLI_426">ich habe es schwer gehabt in der Jugend.</event>
<event start="TLI_426" end="TLI_427">(0.6) </event>
<event start="TLI_431" end="TLI_432">eins, </event>
<event start="TLI_432" end="TLI_433">zwei, </event>
<event start="TLI_433" end="TLI_434">(0.19) </event>
<event start="TLI_434" end="TLI_435">drei, </event>
<event start="TLI_435" end="TLI_436">vier, </event>
<event start="TLI_436" end="TLI_437">(0.57) </event>
<event start="TLI_437" end="TLI_438">fünf, </event>
<event start="TLI_438" end="TLI_439">sechs, </event>
<event start="TLI_439" end="TLI_440">sieben, </event>
<event start="TLI_440" end="TLI_441">acht, </event>
<event start="TLI_441" end="TLI_442">(0.22) </event>
<event start="TLI_442" end="TLI_443">neun, </event>
<event start="TLI_443" end="TLI_444">zehn.</event>
<event start="TLI_444" end="TLI_445">(1.23) </event>
<event start="TLI_445" end="T1">Montag, </event>
<event start="T1" end="T2">Dienstag, </event>
<event start="T2" end="TLI_446">Mittwoch</event>
<event start="TLI_446" end="TLI_447">(0.94) </event>
<event start="TLI_447" end="T3">Donnerstag, </event>
<event start="T3" end="T4">Freitag, </event>
<event start="T4" end="T5">Sonnabend, </event>
<event start="T5" end="TLI_448">Sonntag.</event>
</tier><tier id="TIE1" speaker="S2" category="v" type="t" display-name="S2"><event start="TLI_1" end="TLI_2">(0.96) </event>
<event start="TLI_2" end="TLI_3">Ich habe eine harte Jugend durchgemacht. </event>
<event start="TLI_3" end="TLI_4">(0.97) </event>
<event start="TLI_4" end="TLI_5">Zu meiner Zeit </event>
<event start="TLI_5" end="TLI_6">(1.65) </event>
<event start="TLI_6" end="TLI_7">gabs noch keine Maschinen. </event>
<event start="TLI_7" end="TLI_8">(1.62) </event>
<event start="TLI_8" end="TLI_9">Ich habe schon </event>
<event start="TLI_9" end="TLI_10">(1.18) </event>
<event start="TLI_10" end="TLI_11"><![CDATA[> in die Schule gehend > den Morgen öfter viere helfen dreschen. ]]></event>
<event start="TLI_11" end="TLI_12">(2.52) </event>
<event start="TLI_12" end="TLI_13">Mit dem Flegel. </event>
<event start="TLI_13" end="TLI_14">(1.86) </event>
<event start="TLI_14" end="TLI_15">Und </event>
<event start="TLI_15" end="TLI_16">(0.48) </event>
<event start="TLI_16" end="TLI_17">Sämaschine kriegten wir erst in </event>
<event start="TLI_17" end="TLI_18">(0.58) </event>
<event start="TLI_18" end="TLI_19">dreiundneunzig. </event>
<event start="TLI_19" end="TLI_20">(1.48) </event>
<event start="TLI_20" end="TLI_21">Bis dahin hat mein Vater noch alles mit Hand gesät. </event>
<event start="TLI_21" end="TLI_22">(2.11) </event>
<event start="TLI_22" end="TLI_23">Die ersten Grasmäher </event>
<event start="TLI_23" end="TLI_24">(0.21) </event>
<event start="TLI_24" end="TLI_25"><![CDATA[kriegten wir erst in neunzehnhundert > . ]]></event>
<event start="TLI_25" end="TLI_26">(1.08) </event>
<event start="TLI_26" end="TLI_27">Da war ich schon vierundzwanzig Jahre alt. </event>
<event start="TLI_27" end="TLI_28">(0.82) </event>
<event start="TLI_28" end="TLI_29">Und da hab ich </event>
<event start="TLI_29" end="TLI_30">(0.6) </event>
<event start="TLI_30" end="TLI_31">müssen drei, </event>
<event start="TLI_31" end="TLI_32">vier Wochen mit der Sense </event>
<event start="TLI_32" end="TLI_33">(1.03) </event>
<event start="TLI_33" end="TLI_34">auf der Wiese mähen. </event>
<event start="TLI_34" end="TLI_35">Wir hatten dreißig Morgen Wiese. </event>
<event start="TLI_35" end="TLI_36">Da können sie sich denken, </event>
<event start="TLI_36" end="TLI_37">(0.6) </event>
<event start="TLI_37" end="TLI_38">was ich da habe müssen schuften. </event>
<event start="TLI_38" end="TLI_39">(2.01) </event>
<event start="TLI_39" end="TLI_40">Mit zwei Schwestern, </event>
<event start="TLI_40" end="TLI_41">nicht? </event>
<event start="TLI_41" end="TLI_42">(1.02) </event>
<event start="TLI_42" end="TLI_43">Mehr kriegten wir selten, </event>
<event start="TLI_43" end="TLI_44">wir mußten fast alles alleine mähen. </event>
<event start="TLI_44" end="TLI_45">(1.65) </event>
<event start="TLI_45" end="TLI_46">Und dann </event>
<event start="TLI_46" end="TLI_47">(2.1) </event>
<event start="TLI_47" end="TLI_48">den ganzen Sommer die Frucht nur mit der Sense abgemäht. </event>
<event start="TLI_48" end="TLI_49">(1.36) </event>
<event start="TLI_49" end="TLI_50">Das habe ich alles allein müssen machen. </event>
<event start="TLI_50" end="TLI_51">Mein Vater, </event>
<event start="TLI_51" end="TLI_52">der war schon ziemlich alt </event>
<event start="TLI_52" end="TLI_53">(0.81) </event>
<event start="TLI_53" end="TLI_54">und bei einem Meister, </event>
<event start="TLI_54" end="TLI_55">der ging nicht viel mit raus. </event>
<event start="TLI_55" end="TLI_56">(1.53) </event>
<event start="TLI_56" end="TLI_57">Hab ich </event>
<event start="TLI_57" end="TLI_58">(0.61) </event>
<event start="TLI_58" end="TLI_59">das Mähen alle alleine müssen machen, </event>
<event start="TLI_59" end="TLI_60">und meine zwei Schwestern, die haben dann aufgerichtet, aufgenommen. </event>
<event start="TLI_60" end="TLI_61">(3.19) </event>
<event start="TLI_61" end="TLI_63">Ja, und das Ackern </event>
<event start="TLI_63" end="TLI_64">(1.3) </event>
<event start="TLI_64" end="TLI_65"><![CDATA[> heute haben sie hier Buldoggs. ]]></event>
<event start="TLI_65" end="TLI_66">(1.18) </event>
<event start="TLI_66" end="TLI_67"><![CDATA[Damals mußte > >]]></event>
<event start="TLI_67" end="TLI_68">(1.81) </event>
<event start="TLI_68" end="TLI_69"><![CDATA[> mußte ]]></event>
<event start="TLI_69" end="TLI_70">(0.47) </event>
<event start="TLI_70" end="TLI_71">den Ackerpflug in die Hand nehmen. </event>
<event start="TLI_71" end="TLI_72">(2.11) </event>
<event start="TLI_72" end="TLI_73">Heute gehts ja mit dem Buldogg, </event>
<event start="TLI_73" end="TLI_74">(0.22) </event>
<event start="TLI_74" end="TLI_75">gehts ja besser. </event>
<event start="TLI_75" end="TLI_76">(1.05) </event>
<event start="TLI_76" end="TLI_77">Aber trotzdem haben wir noch keinen Buldogg. </event>
<event start="TLI_77" end="TLI_78">Wir machens immer noch mit den Pferden. </event>
<event start="TLI_78" end="TLI_79">(0.96) </event>
<event start="TLI_79" end="TLI_80">Wir haben drei Pferde und </event>
<event start="TLI_80" end="TLI_81">(1.63) </event>
<event start="TLI_81" end="TLI_82">da kommen wir ganz gut mit voran. </event>
<event start="TLI_82" end="TLI_83">(3.57) </event>
<event start="TLI_83" end="TLI_85">Ja, es geht natürlich nun alles mechanisch. </event>
<event start="TLI_85" end="TLI_86">(1.57) </event>
<event start="TLI_86" end="TLI_87">Wir haben jetzt </event>
<event start="TLI_87" end="TLI_88">(1.51) </event>
<event start="TLI_88" end="TLI_89">einen Aufzug in der Scheune. </event>
<event start="TLI_89" end="TLI_90">Da wird die Frucht mit abgeladen. </event>
<event start="TLI_90" end="TLI_91">Die Scheune ist vierunddreißig Meter lang. </event>
<event start="TLI_91" end="TLI_92">(0.57) </event>
<event start="TLI_92" end="TLI_93">Und der geht durch die Scheune durch. </event>
<event start="TLI_93" end="TLI_94">(0.69) </event>
<event start="TLI_94" end="TLI_95">Und wo die Frucht grad hingebanst soll werden, da wird der</event>
<event start="TLI_95" end="TLI_96">(0.84) </event>
<event start="TLI_96" end="TLI_97">der Aufzug eingestellt. </event>
<event start="TLI_97" end="TLI_98">Und dann wirft es </event>
<event start="TLI_98" end="TLI_99">(0.61) </event>
<event start="TLI_99" end="TLI_100">mechanisch ab. </event>
<event start="TLI_100" end="TLI_101">(2.31) </event>
<event start="TLI_101" end="TLI_102">Und dann haben wir </event>
<event start="TLI_102" end="TLI_103">(0.7) </event>
<event start="TLI_103" end="TLI_104">einen Stallbahn, </event>
<event start="TLI_104" end="TLI_105">(1.11) </event>
<event start="TLI_105" end="TLI_106">wo der Mist mit raus wird befördert. </event>
<event start="TLI_106" end="TLI_107">(1.41) </event>
<event start="TLI_107" end="TLI_108">Die anderen Bauern, </event>
<event start="TLI_108" end="TLI_109">die fahren ihn immer noch mit dem </event>
<event start="TLI_109" end="TLI_110">(0.21) </event>
<event start="TLI_110" end="TLI_111">Mistkarren raus. </event>
<event start="TLI_111" end="TLI_112">Das machen wir nicht mehr. </event>
<event start="TLI_112" end="TLI_113">(0.66) </event>
<event start="TLI_113" end="TLI_114">Wenn die Stallbahn, </event>
<event start="TLI_114" end="TLI_115">(0.3) </event>
<event start="TLI_115" end="TLI_116">die geht bis auf die Miste, </event>
<event start="TLI_116" end="TLI_117">(0.78) </event>
<event start="TLI_117" end="TLI_118">und wenn wir auf der Miste sind angekommen, </event>
<event start="TLI_118" end="TLI_119">dann wird nur noch auf den Hebel gedrückt, </event>
<event start="TLI_119" end="TLI_120">(0.63) </event>
<event start="TLI_120" end="TLI_121">dann schwenkt sich das Becken rum und wirft den Mist raus. </event>
<event start="TLI_121" end="TLI_122">(0.7) </event>
<event start="TLI_122" end="TLI_123">Eine schöne Sache! </event>
<event start="TLI_123" end="TLI_124">(0.87) </event>
<event start="TLI_124" end="TLI_125">Eine große Erleichterung! </event>
<event start="TLI_125" end="TLI_126">(1.62) </event>
<event start="TLI_126" end="TLI_127">Und dann haben wir einen </event>
<event start="TLI_127" end="TLI_128">(0.79) </event>
<event start="TLI_128" end="TLI_129">Jauchenpumpe. </event>
<event start="TLI_129" end="TLI_130">Die wird elektrisch betrieben. </event>
<event start="TLI_130" end="TLI_131">Und früher mußte man alles machen mit der Hand. </event>
<event start="TLI_131" end="TLI_132">(0.99) </event>
<event start="TLI_132" end="TLI_133">Da hat man sich koloßal müssen anstrengen. </event>
<event start="TLI_133" end="TLI_134"><![CDATA[Da ließen sie immer > die Pumpen, dies >]]></event>
<event start="TLI_134" end="TLI_135">(0.39) </event>
<event start="TLI_135" end="TLI_136">die Jauche fallen. </event>
<event start="TLI_136" end="TLI_137">Und da mußte man </event>
<event start="TLI_137" end="TLI_138">(0.25) </event>
<event start="TLI_138" end="TLI_139">wieder Wasser oben rein </event>
<event start="TLI_139" end="TLI_140">(0.62) </event>
<event start="TLI_140" end="TLI_141">schütten, </event>
<event start="TLI_141" end="TLI_142">daß sie wieder in Gang kam. </event>
<event start="TLI_142" end="TLI_143">Und mußte pumpen! </event>
<event start="TLI_143" end="TLI_144">(1.08) </event>
<event start="TLI_144" end="TLI_147">Zum, ja, es war furchtbar mitunter. </event>
<event start="TLI_147" end="TLI_148">(1.02) </event>
<event start="TLI_148" end="TLI_149">Heute ist alles viel leichter. </event>
<event start="TLI_149" end="TLI_150">(2.4) </event>
<event start="TLI_150" end="TLI_151">Eine Melkmaschine </event>
<event start="TLI_151" end="TLI_152">(0.33) </event>
<event start="TLI_152" end="TLI_153">angeschafft, </event>
<event start="TLI_153" end="TLI_154">(1.96) </event>
<event start="TLI_154" end="TLI_155">das macht jetzt ein Schuljunge! </event>
<event start="TLI_155" end="TLI_156">(1.62) </event>
<event start="TLI_156" end="TLI_157">Das Melken mit der Melkmaschine. </event>
<event start="TLI_157" end="TLI_158">(1.32) </event>
<event start="TLI_158" end="TLI_159">Da haben wir den zehnjährigen </event>
<event start="TLI_159" end="TLI_160">(0.36) </event>
<event start="TLI_160" end="TLI_161">Enkel, </event>
<event start="TLI_161" end="TLI_162">(0.87) </event>
<event start="TLI_162" end="TLI_163">der macht das </event>
<event start="TLI_163" end="TLI_164">(1.44) </event>
<event start="TLI_164" end="TLI_165">mit leichter Mühe. |</event>
<event start="TLI_165" end="TLI_166">(2.38) </event>
<event start="TLI_169" end="TLI_170">Von dem Femgericht? |</event>
<event start="TLI_173" end="TLI_174">Ja, </event>
<event start="TLI_174" end="TLI_175">(0.18) </event>
<event start="TLI_175" end="TLI_176">da war vor </event>
<event start="TLI_176" end="TLI_177">(1.0) </event>
<event start="TLI_177" end="TLI_178">alter grauer Zeit wurden doch noch die Femgerichte auf den Dörfern abgehalten. </event>
<event start="TLI_178" end="TLI_179">(3.6) </event>
<event start="TLI_179" end="TLI_180">Jetzt war </event>
<event start="TLI_180" end="TLI_181">(0.39) </event>
<event start="TLI_181" end="TLI_182">eine Frau </event>
<event start="TLI_182" end="TLI_183">(0.53) </event>
<event start="TLI_183" end="TLI_184">zum Tode verurteilt.</event>
<event start="TLI_184" end="TLI_185">(1.56) </event>
<event start="TLI_185" end="TLI_186">Was sie nun gemacht hatte, das</event>
<event start="TLI_186" end="TLI_187">(0.24) </event>
<event start="TLI_187" end="TLI_188">das weiß ich nicht, </event>
<event start="TLI_188" end="TLI_189">das weeß ich nicht. </event>
<event start="TLI_189" end="TLI_190">(2.37) </event>
<event start="TLI_190" end="TLI_191">Kurzum, </event>
<event start="TLI_191" end="TLI_192">(0.33) </event>
<event start="TLI_192" end="TLI_193">sie war zum Tode verurteilt. </event>
<event start="TLI_193" end="TLI_194">(1.78) </event>
<event start="TLI_194" end="TLI_195">Und da </event>
<event start="TLI_195" end="TLI_196">(0.42) </event>
<event start="TLI_196" end="TLI_197">hatte sie noch eine Bitte, </event>
<event start="TLI_197" end="TLI_198">die brachte sie vor. </event>
<event start="TLI_198" end="TLI_199">(1.26) </event>
<event start="TLI_199" end="TLI_200">Und die wird ihr nun gewährt. </event>
<event start="TLI_200" end="TLI_201">(1.23) </event>
<event start="TLI_201" end="TLI_202">Da wollte sie noch </event>
<event start="TLI_202" end="TLI_203">(0.3) </event>
<event start="TLI_203" end="TLI_204">einmal </event>
<event start="TLI_204" end="TLI_205">(0.56) </event>
<event start="TLI_205" end="TLI_206">säen und einmal ernten. </event>
<event start="TLI_206" end="TLI_207">(0.52) </event>
<event start="TLI_207" end="TLI_208">Und das ist ihr gewährt worden. </event>
<event start="TLI_208" end="TLI_209">(1.12) </event>
<event start="TLI_209" end="TLI_210">Und da hat sie Eicheln gesät! </event>
<event start="TLI_210" end="TLI_211">(1.42) </event>
<event start="TLI_211" end="TLI_212">Hier in der Gegend von Salzborn. </event>
<event start="TLI_212" end="TLI_213">(0.61) </event>
<event start="TLI_213" end="TLI_214">Auf dem Kircherellenen </event>
<event start="TLI_214" end="TLI_215">(1.33) </event>
<event start="TLI_215" end="TLI_216">hat sie sie gesät. </event>
<event start="TLI_216" end="TLI_217">(0.72) </event>
<event start="TLI_217" end="TLI_218">Und heute stehen noch eine ganze Mengen Eichen </event>
<event start="TLI_218" end="TLI_219">da. </event>
<event start="TLI_219" end="TLI_220">(2.38) </event>
<event start="TLI_220" end="TLI_221">In Salzborn steht noch ein ganzer Rude </event>
<event start="TLI_221" end="TLI_222">(0.73) </event>
<event start="TLI_222" end="TLI_223">und dann raus zu nach Wildungen, </event>
<event start="TLI_223" end="TLI_224">wo das Kinderheim ist, da steht</event>
<event start="TLI_224" end="TLI_225">(0.67) </event>
<event start="TLI_225" end="TLI_226">noch ein Rudel, das</event>
<event start="TLI_226" end="TLI_227">(0.34) </event>
<event start="TLI_227" end="TLI_228">das heißt: </event>
<event start="TLI_228" end="TLI_229">die sechs Eichen. </event>
<event start="TLI_229" end="TLI_230">(0.99) </event>
<event start="TLI_230" end="TLI_231">Und auf dem Kirchellenen oben, </event>
<event start="TLI_231" end="TLI_232">(0.15) </event>
<event start="TLI_232" end="TLI_233">durch den </event>
<event start="TLI_233" end="TLI_234">(0.24) </event>
<event start="TLI_234" end="TLI_235"><![CDATA[> stehn noch eine ganze Menge Eichen. ]]></event>
<event start="TLI_235" end="TLI_236">(1.8) </event>
<event start="TLI_236" end="TLI_237">Also eine wahre Geschichte muß es schon sein. |</event>
<event start="TLI_237" end="TLI_238">(2.58) </event>
<event start="TLI_240" end="TLI_241">Ja, </event>
<event start="TLI_241" end="TLI_242">(4.69) </event>
<event start="TLI_242" end="TLI_243">hier auf der Jägersburg. </event>
<event start="TLI_243" end="TLI_244">(1.36) </event>
<event start="TLI_244" end="TLI_245">Da hat doch ein Schloß gestanden. </event>
<event start="TLI_245" end="TLI_246">(1.56) </event>
<event start="TLI_246" end="TLI_247">Ein Jagdschloß. </event>
<event start="TLI_247" end="TLI_248">(0.34) </event>
<event start="TLI_248" end="TLI_249">Das hat der Fürst Ulrich von </event>
<event start="TLI_249" end="TLI_250">(0.47) </event>
<event start="TLI_250" end="TLI_251">Arolsen gebaut. </event>
<event start="TLI_251" end="TLI_252">(1.95) </event>
<event start="TLI_252" end="TLI_253">Der hielt immer die Jagd ab. </event>
<event start="TLI_253" end="TLI_254">Und dann mußten die Bauern, </event>
<event start="TLI_254" end="TLI_255">(0.75) </event>
<event start="TLI_255" end="TLI_256">die mußten dann mit und mußten helfen treiben. </event>
<event start="TLI_256" end="TLI_257">(2.88) </event>
<event start="TLI_257" end="TLI_258">Und </event>
<event start="TLI_258" end="TLI_259">(3.43) </event>
<event start="TLI_259" end="TLI_260"><![CDATA[jetzt ist nun das Jagdschloß auch schon > das war in den siebziger Jahren > , ]]></event>
<event start="TLI_260" end="TLI_261">das ist abgebrochen und ist </event>
<event start="TLI_261" end="TLI_262">(0.51) </event>
<event start="TLI_262" end="TLI_263">in Wildungen wieder aufgebaut. </event>
<event start="TLI_263" end="TLI_264">(0.78) </event>
<event start="TLI_264" end="TLI_265">Ist oben das Centraltheater. </event>
<event start="TLI_265" end="TLI_266">(0.99) </event>
<event start="TLI_266" end="TLI_267">Das ist es. </event>
<event start="TLI_267" end="TLI_268">(4.69) </event>
<event start="TLI_268" end="TLI_269">Jetzt </event>
<event start="TLI_269" end="TLI_270">(0.28) </event>
<event start="TLI_270" end="TLI_271">hatte nun der </event>
<event start="TLI_271" end="TLI_272">Fürst </event>
<event start="TLI_272" end="TLI_273">(0.19) </event>
<event start="TLI_273" end="TLI_274">damals </event>
<event start="TLI_274" end="TLI_275">(1.0) </event>
<event start="TLI_275" end="TLI_276">ein Leibjäger. </event>
<event start="TLI_276" end="TLI_277">(2.29) </event>
<event start="TLI_277" end="TLI_278">Der war Gärtner. </event>
<event start="TLI_278" end="TLI_279">(0.91) </event>
<event start="TLI_279" end="TLI_280"><![CDATA[Und der ist mit ihm gemacht > in den Türkenkrieg.]]></event>
<event start="TLI_280" end="TLI_281">(1.99) </event>
<event start="TLI_281" end="TLI_284">Und da mußten sie flüchten gehn. </event>
<event start="TLI_284" end="TLI_285">(0.93) </event>
<event start="TLI_285" end="TLI_286">Und mußten durch die Donau </event>
<event start="TLI_286" end="TLI_287">(0.34) </event>
<event start="TLI_287" end="TLI_288">reiten. </event>
<event start="TLI_288" end="TLI_289">(1.53) </event>
<event start="TLI_289" end="TLI_290">Und mitten in der Donau fängt dem Fürst ein Gaul </event>
<event start="TLI_290" end="TLI_291">(0.27) </event>
<event start="TLI_291" end="TLI_292">an zu sinken. </event>
<event start="TLI_292" end="TLI_293">(1.29) </event>
<event start="TLI_293" end="TLI_298"><![CDATA[Und da spricht sein Leibjäger zu ihm > : ]]></event>
<event start="TLI_298" end="TLI_299">(0.57) </event>
<event start="TLI_299" end="TLI_300">" Stechen sie den Gaul doch mal mit dem Sebel in die Mähne, </event>
<event start="TLI_300" end="TLI_301">dann wird er wieder </event>
<event start="TLI_301" end="TLI_302">(0.9) </event>
<event start="TLI_302" end="TLI_303"><![CDATA[neuen Mut krieben! > " ]]></event>
<event start="TLI_303" end="TLI_304">(0.73) </event>
<event start="TLI_304" end="TLI_305">Das hat der Fürst dann gemacht </event>
<event start="TLI_305" end="TLI_306">(0.49) </event>
<event start="TLI_306" end="TLI_307">und ist tatsächlich ans Ufer gekommen. </event>
<event start="TLI_307" end="TLI_308">(1.72) </event>
<event start="TLI_308" end="TLI_309">Und zum Danke </event>
<event start="TLI_309" end="TLI_310">(0.78) </event>
<event start="TLI_310" end="TLI_311"><![CDATA[hat er > ]]></event>
<event start="TLI_311" end="TLI_312">(0.9) </event>
<event start="TLI_312" end="TLI_313">schrieb er sich: </event>
<event start="TLI_313" end="TLI_314"><![CDATA[Ark > , ]]></event>
<event start="TLI_314" end="TLI_315">mein Vater hat ihn noch gekannt, </event>
<event start="TLI_315" end="TLI_316">(1.06) </event>
<event start="TLI_316" end="TLI_317">er war Gärtner, </event>
<event start="TLI_317" end="TLI_318">(0.84) </event>
<event start="TLI_318" end="TLI_319">hat er dem die Jägersburg hier gegeben, </event>
<event start="TLI_319" end="TLI_320">so lange, </event>
<event start="TLI_320" end="TLI_321">wie männliche Erben </event>
<event start="TLI_321" end="TLI_322">(0.73) </event>
<event start="TLI_322" end="TLI_323">da waren. </event>
<event start="TLI_323" end="TLI_324">(0.82) </event>
<event start="TLI_324" end="TLI_325">Nun hatte aber dieser Ark </event>
<event start="TLI_325" end="TLI_326">(0.63) </event>
<event start="TLI_326" end="TLI_327">nur </event>
<event start="TLI_327" end="TLI_328">(0.15) </event>
<event start="TLI_328" end="TLI_329">Mädchen. </event>
<event start="TLI_329" end="TLI_330">(1.29) </event>
<event start="TLI_330" end="TLI_331">Zwei Mädchen. </event>
<event start="TLI_331" end="TLI_332">(0.84) </event>
<event start="TLI_332" end="TLI_334">Ja, und nun war das hinfällig. </event>
<event start="TLI_334" end="TLI_335">(3.24) </event>
<event start="TLI_335" end="TLI_336">Nun sind nur noch </event>
<event start="TLI_336" end="TLI_337">(1.71) </event>
<event start="TLI_337" end="TLI_338">mehrere Familien, </event>
<event start="TLI_338" end="TLI_339">haben da drauf gewohnt, </event>
<event start="TLI_339" end="TLI_340">auf dem Schloß. </event>
<event start="TLI_340" end="TLI_341">(1.81) </event>
<event start="TLI_341" end="TLI_343">Na, und da haben sie da oben getanzt, </event>
<event start="TLI_343" end="TLI_344">und gekegelt bis spät. </event>
<event start="TLI_344" end="TLI_345">Sind die ganzen </event>
<event start="TLI_345" end="TLI_346">(0.58) </event>
<event start="TLI_346" end="TLI_347">Dorfburschen aus der Umgegend immer auf die Jägersburg gekommen </event>
<event start="TLI_347" end="TLI_348">(0.69) </event>
<event start="TLI_348" end="TLI_349">und haben da getanzt und Kegel gespielt. </event>
<event start="TLI_349" end="TLI_350">(1.38) </event>
<event start="TLI_350" end="TLI_351">Nun ist es aber späterhin </event>
<event start="TLI_351" end="TLI_352">(1.71) </event>
<event start="TLI_352" end="TLI_353">ist es auf Abbruch verkauft. </event>
<event start="TLI_353" end="TLI_354">(0.9) </event>
<event start="TLI_354" end="TLI_355">Ist nach Wildungen gekommen. </event>
<event start="TLI_355" end="TLI_356">(1.68) </event>
<event start="TLI_356" end="TLI_357">Ist das Centraltheater </event>
<event start="TLI_357" end="TLI_358">draus gebaut. |</event>
<event start="TLI_358" end="TLI_359">(2.52) </event>
<event start="TLI_363" end="TLI_364">Ach, </event>
<event start="TLI_364" end="TLI_365">(0.39) </event>
<event start="TLI_365" end="TLI_366">das reißt nicht ab, </event>
<event start="TLI_366" end="TLI_367">(1.03) </event>
<event start="TLI_367" end="TLI_368">das reißt nicht ab, </event>
<event start="TLI_368" end="TLI_369">auch im Winter. |</event>
<event start="TLI_369" end="TLI_370">(2.91) </event>
<event start="TLI_371" end="TLI_372">Im Winter, </event>
<event start="TLI_372" end="TLI_373">(1.56) </event>
<event start="TLI_373" end="TLI_374">na ja, </event>
<event start="TLI_374" end="TLI_375">früher wurde im Winter gedroschen zum meiner Zeit, </event>
<event start="TLI_375" end="TLI_376">wie ich noch Jung war. </event>
<event start="TLI_376" end="TLI_377">(1.14) </event>
<event start="TLI_377" end="TLI_378">Jetzt wird ja alles mit der </event>
<event start="TLI_378" end="TLI_379">(0.71) </event>
<event start="TLI_379" end="TLI_380">Maschine </event>
<event start="TLI_380" end="TLI_381">gemacht. </event>
<event start="TLI_381" end="TLI_382">Im Herbst schon im Sommer. </event>
<event start="TLI_382" end="TLI_383">(1.8) </event>
<event start="TLI_383" end="TLI_384">Aber das Vieh füttern, </event>
<event start="TLI_384" end="TLI_385">und das Vieh, </event>
<event start="TLI_385" end="TLI_386">das mußte auch </event>
<event start="TLI_386" end="TLI_387">(0.69) </event>
<event start="TLI_387" end="TLI_388">gepflegt werden, </event>
<event start="TLI_388" end="TLI_389">geputzt, </event>
<event start="TLI_389" end="TLI_390">(0.69) </event>
<event start="TLI_390" end="TLI_391">sauber gemacht werden. </event>
<event start="TLI_391" end="TLI_392">Das ist doch eine Riesenarbeit! </event>
<event start="TLI_392" end="TLI_393">(1.02) </event>
<event start="TLI_393" end="TLI_394">Ich habe immer das Hemd angezogen, </event>
<event start="TLI_394" end="TLI_395">(0.63) </event>
<event start="TLI_395" end="TLI_396">und habe nur mit der Hose da gestanden, </event>
<event start="TLI_396" end="TLI_397">und habe das Vieh geputzt. </event>
<event start="TLI_397" end="TLI_398">(0.21) </event>
<event start="TLI_398" end="TLI_399">Im Stalle ists ja im Winter auch warm, </event>
<event start="TLI_399" end="TLI_400">nicht? </event>
<event start="TLI_400" end="TLI_401">(1.98) </event>
<event start="TLI_401" end="TLI_403">Na, muß gefüttert werden, </event>
<event start="TLI_403" end="TLI_404">man hat ja jetzt, </event>
<event start="TLI_404" end="TLI_405">(0.36) </event>
<event start="TLI_405" end="TLI_406">hat mans ja leichter. </event>
<event start="TLI_406" end="TLI_407">(0.96) </event>
<event start="TLI_407" end="TLI_408">Jetzt hat man Selbsttränke und </event>
<event start="TLI_408" end="TLI_409">(0.99) </event>
<event start="TLI_409" end="TLI_410"><![CDATA[hat > ]]></event>
<event start="TLI_410" end="TLI_411">(1.41) </event>
<event start="TLI_411" end="TLI_412">man füttert alles lang. </event>
<event start="TLI_412" end="TLI_413">Früher da mußte alles mit der Häckselmaschine geschnitte werden. </event>
<event start="TLI_413" end="TLI_414">(0.46) </event>
<event start="TLI_414" end="TLI_415">Jetzt füttert man alles lang. </event>
<event start="TLI_415" end="TLI_416">(0.72) </event>
<event start="TLI_416" end="TLI_417">Das kommt oben vom Heuboden direkt auf die Rampe, </event>
<event start="TLI_417" end="TLI_418">(1.29) </event>
<event start="TLI_418" end="TLI_419">wirds geschmissen, </event>
<event start="TLI_419" end="TLI_420">(0.24) </event>
<event start="TLI_420" end="TLI_421">da braucht mans bloß auseinander zu machen. </event>
<event start="TLI_421" end="TLI_422">Das ist </event>
<event start="TLI_422" end="TLI_423">(0.66) </event>
<event start="TLI_423" end="TLI_424">leichter, als in meiner Jugend. </event>
<event start="TLI_424" end="TLI_425">(0.82) </event>
<event start="TLI_425" end="TLI_426">Ich habs schwer gehabt in der Jugend. |</event>
<event start="TLI_426" end="TLI_427">(0.6) </event>
<event start="TLI_431" end="TLI_432">Eins, </event>
<event start="TLI_432" end="TLI_433">zwei, </event>
<event start="TLI_433" end="TLI_434">(0.19) </event>
<event start="TLI_434" end="TLI_435">drei, </event>
<event start="TLI_435" end="TLI_436">vier, </event>
<event start="TLI_436" end="TLI_437">(0.57) </event>
<event start="TLI_437" end="TLI_438">fünf, </event>
<event start="TLI_438" end="TLI_439">sechs, </event>
<event start="TLI_439" end="TLI_440">sieben, </event>
<event start="TLI_440" end="TLI_441">acht, </event>
<event start="TLI_441" end="TLI_442">(0.22) </event>
<event start="TLI_442" end="TLI_443">neun, </event>
<event start="TLI_443" end="TLI_444">zehn.</event>
<event start="TLI_444" end="TLI_445">(1.23) </event>
<event start="TLI_445" end="TLI_446">Montag, Dienstag, Mittwoch</event>
<event start="TLI_446" end="TLI_447">(0.94) </event>
<event start="TLI_447" end="T3">Donnerstag, </event>
<event start="T3" end="T4">Freitag, </event>
<event start="T4" end="T5">Sonnabend, </event>
<event start="T5" end="TLI_448">Sonntag.</event>
</tier><tier id="TIE3" speaker="S1" category="lit" type="a" display-name="S1 [lit]"><event start="TLI_0" end="TLI_1">eins einunddreißig sechsundneunzig </event>
<event start="TLI_166" end="TLI_167">Nun besinnen Sie sich doch mal, </event>
<event start="TLI_167" end="TLI_168">was sie erzählen wollten von der Dorfgeschichte. </event>
<event start="TLI_168" end="TLI_169">(1.36) </event>
<event start="TLI_170" end="TLI_171">Ja, </event>
<event start="TLI_171" end="TLI_172">fangen se ma damit an. </event>
<event start="TLI_172" end="TLI_173">(1.21) </event>
<event start="TLI_238" end="TLI_239">Gibt's denn noch was von früher vom Dorf zu erzählen oder aus der Dorfgeschichte? </event>
<event start="TLI_239" end="TLI_240">(5.34) </event>
<event start="TLI_359" end="TLI_360">Sagen Sie mal, </event>
<event start="TLI_360" end="TLI_361">(0.6) </event>
<event start="TLI_361" end="TLI_362">haben denn die Bauern nur das Sommerjahr über zu tun, </event>
<event start="TLI_362" end="TLI_363">oder haben die auch im Winter den Buckel voll Arbeit? </event>
<event start="TLI_370" end="TLI_371">was denn zum Beispiel alles? </event>
<event start="TLI_427" end="TLI_428">so, </event>
<event start="TLI_428" end="TLI_429">(0.19) </event>
<event start="TLI_429" end="TLI_430">zählen Sie bitte jetzt noch auf Platt von eins bis zehn </event>
<event start="TLI_430" end="TLI_431">und sagen Sie dann die Wochentagen von Montag an.</event>
</tier><tier id="TIE2" speaker="S1" category="v" type="t" display-name="S1"><event start="TLI_0" end="TLI_1">eins einunddreißig sechsundneunzig </event>
<event start="TLI_166" end="TLI_167">Nun besinnen Sie sich doch mal, </event>
<event start="TLI_167" end="TLI_168">was sie erzählen wollen von der Dorfgeschichte. |</event>
<event start="TLI_168" end="TLI_169">(1.36) </event>
<event start="TLI_170" end="TLI_171">Ja, </event>
<event start="TLI_171" end="TLI_172">fangen Sie mal damit an. |</event>
<event start="TLI_172" end="TLI_173">(1.21) </event>
<event start="TLI_238" end="TLI_239">Gibt's denn noch was von früher vom Dorf zu erzählen oder aus der Dorfgeschichte? |</event>
<event start="TLI_239" end="TLI_240">(5.34) </event>
<event start="TLI_359" end="TLI_360">Sagen Sie mal, </event>
<event start="TLI_360" end="TLI_361">(0.6) </event>
<event start="TLI_361" end="TLI_362">haben denn die Bauern nur das Sommerjahr über zu tun, </event>
<event start="TLI_362" end="TLI_363">oder haben die auch im Winter den Puckel voll Arbeit? |</event>
<event start="TLI_370" end="TLI_371">Was denn zum Beispiel alles? |</event>
<event start="TLI_427" end="TLI_428">So,</event>
<event start="TLI_428" end="TLI_429">(0.19) </event>
<event start="TLI_429" end="TLI_430">zählen Sie bitte jetzt noch auf Platt von eins bis zehn </event>
<event start="TLI_430" end="TLI_431">und sagen Sie dann die Wochentagen von Montag an.</event>
</tier><tier id="TIE_NOSP" speaker="SPK_NOSPK" category="v" type="t" display-name=""></tier></basic-body>
